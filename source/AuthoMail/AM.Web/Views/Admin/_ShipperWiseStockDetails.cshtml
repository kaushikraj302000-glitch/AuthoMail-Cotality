@model AM.Services.EnvelopeInventoryStockVM

    <tr id="shipper_@(Model.ShipperId)">
        <td>
            @Model.ShipperName
            <input type="hidden" class="form-control" value="@Model.ShipperId" name="ShipperId" />
        </td>
        <td>
            <input class="form-control" value="@Model.ReceivedQuantity" name="UnitPrice" />
        </td>
        <td>
           <input class="form-control" value="@Model.UnitPrice" name="UnitPrice"  />
        </td>
        <td>
            <input class="form-control" value="@Model.ReceivedQuantity" name="UnitPrice" />
        </td>
      <td>
          @if (Model.EnvelopeId.HasValue)
          {
              <span>--</span>
          }
          else
          {
              <button class="btn btn-sm btn-danger" data-shipperid="@Model.ShipperId" onclick="DeleteShipper(this)"><i class="fa fa-trash"></i></button>
          }
      </td>
    </tr>


