    function SaveClient() {
        if ($("#Client").val().trim() == "") {
            $("#ClientError").show();
            return;
        }
        else {
            $("#ClientError").hide();
        }
        if ($("#CustCode").val().trim() == "") {
            $("#CustCodeError").show();
            return;
        }
        else {
            $("#CustCodeError").hide();
        }
        

    }
</script>





