@model AM.Services.EnvelopeInventory

<h2 id="myModalLabel">@(Model.Id == 0 ? Html.Raw("Add Envelope Transactions Details") : Html.Raw("Edit Envelope Transactions Details"))</h2>
<hr />
<input type="hidden" id="Id" name="Id" value="@Model.Id" />
<form id="envelopetransactionsform" action="#">
    <div class="form-group">
        <label for="Description">Envelope</label>
        <div class="input-group">
            @Html.DropDownListFor(model => model.EnvelopeId, ViewBag.Envelopes as SelectList, "Select Envelope", new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Envelope" })
        </div>
        <span for="EnvelopeId" class="error" style="display:none;">This field is required.</span>
    </div>
    <div class="form-group">
        <label for="Description">Received Quantity</label>
        <div class="input-group">
            <input type="number" id="ReceivedQuantity" min="1" class="form-control" name="ReceivedQuantity" value="@Model.ReceivedQuantity" />
        </div>
    </div>
    <div class="form-group">
        <label for="Description">Unit Price</label>
        <div class="input-group">
            <input type="number" id="UnitPrice" class="form-control" min="1" name="UnitPrice" value="@Model.UnitPrice" />
        </div>
    </div>
    <div class="form-group">
        <label for="Description">Description</label>
        <div class="input-group">
            <textarea id="Description" name="Description" class="form-control">@Model.Description</textarea>
        </div>
    </div>

    <hr />
    <button type="submit" class="btn btn-primary" id="Save"><i class="fa fa-save"></i> Save</button>
    <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-close"></i> Cancel</button>
</form>

