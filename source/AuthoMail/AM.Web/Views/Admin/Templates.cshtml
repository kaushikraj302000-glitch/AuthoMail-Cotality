
@{
    ViewBag.Title = "Templates";
}
<link href="~/Content/dropzone/dropzone.css" rel="stylesheet" />
<div class="panel panel-default">

    <div class="panel-body" style="padding-bottom:10px !important;">
        <div class="upload-container" style="padding:0px;">
            <form action="/Admin/SaveDelfusTemplates" id="uploadtemplatediv" enctype="multipart/form-data" method="post" class="dropzone" style="border:none;"></form>
        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <div class="panel-title">
            <h3>Templates</h3>
        </div>
    </div>
    <div class="panel-body" id="templatestablebody">

    </div>
</div>

<div id="templatebody" style="display:none;">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Action</th>
                <th>Name</th>
                <th>Uploaded By</th>
                <th>Uploaded On</th>
                <th>Is Removed</th>
                <th>Removed By</th>
                <th>Removed On</th>
            </tr>
        </thead>
    </table>
</div>


@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script src="~/Content/dropzone/dropzone.js"></script>
    <script src="~/Scripts/PageScript_Templates.js"></script>
}
