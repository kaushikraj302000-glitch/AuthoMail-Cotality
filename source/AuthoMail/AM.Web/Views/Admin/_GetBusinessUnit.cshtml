@model AM.Services.BusinessUnitModel

<h2 id="myModalLabel">@(Model.Id==0 ? Html.Raw("Add Business Unit") : Html.Raw("Edit Business Unit"))</h2>
<hr />
<div class="form-group">
    <label for="Value">Business Unit</label>
    <div class="input-group">
        <input type="hidden" name="Id" id="Id" value="@Model.Id" />
        
        <input class="form-control" name="BusinessUnit" placeholder="Business Unit" value="@Model.BusinessUnit" required id="BusinessUnit">
        <div class="text-red pull-left" style="display:none" id="BusinessUnitError">This field is required.</div>
    </div>

</div>
<div class="form-group">
    <label for="Description">Cust Code</label>
    <div class="input-group">
        <input class="form-control" name="CustCode" placeholder="Cust Code" value="@Model.CustCode" required id="CustCode">
        <div class="text-red pull-left" style="display:none" id="CustCodeError">This field is required.</div>
    </div>

</div>
<hr />
<button type="button" class="btn btn-primary" id="Save" onclick="SaveBusinessUnit()"><i class="fa fa-save"></i> Save</button>
<button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-close"></i> Cancel</button>
