@model AM.Services.DocTypes

@{

    if (Model.Id == 0)
    {
        Model.ContentScalePercent = 100;
        Model.QCPercent = 0;
    }

}


<h2 id="myModalLabel">@(Model.Id == 0 ? Html.Raw("Add Document Type Details") : Html.Raw("Edit Document Type Details"))</h2>
<style>
    hr {
        margin-top: 2% !important;
        margin-bottom: 2% !important;
    }
</style>
<hr />
<form id="doctypeform" action="#" enctype="multipart/form-data">
    <input type="hidden" name="Id" id="Id" value="@Model.Id" />
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label for="Description">Document Type Code</label>
                <div class="input-group">
                    <input type="text" id="DocTypeCode" class="form-control" placeholder="Document Type Code" name="DocTypeCode" value="@Model.DocTypeCode" />
                </div>

            </div>
            <div class="form-group">
                <label for="Clients">Clients</label>
                @Html.DropDownListFor(model => model.ClientId, ViewBag.Clients as SelectList, "Select Client", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Client" })
            </div>
            <div class="form-group">
                <label for="Description">Print Size</label>
                @Html.DropDownListFor(model => model.PrintSize, (IEnumerable<SelectListItem>)ViewBag.PrintSizedropDown, "Select Print Size", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Print Size" })


            </div>
            <div class="form-group">
                <label for="Description">Content Scale Percent</label>
                <div class="input-group">
                    <input type="text" id="ContentScalePercent" class="form-control" placeholder="Content Scale Percent" name="ContentScalePercent" value="@Model.ContentScalePercent" />
                </div>

            </div>
            <div class="form-group">
                <label for="Description">Shipping Carrier</label>

                @Html.DropDownListFor(model => model.ShippingCarrier, (IEnumerable<SelectListItem>)ViewBag.ShippingCarrierdropDown, "Select Shipping Carrier", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Shipping Carrier" })

            </div>
            <div class="form-group">
                <label for="Description">Shipping Service Type</label>
                @Html.DropDownListFor(model => model.ShippingServiceType, (IEnumerable<SelectListItem>)ViewBag.ShippingServiceTypedropDown, "Select Shipping Service Type", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Shipping Service Type" })

            </div>
            <div class="form-group">
                <label for="Description">Shipping Account Code</label>
                <div class="input-group">
                    <input type="text" id="ShippingAccountCode" class="form-control" placeholder="Shipping Account Code" name="ShippingAccountCode" value="@Model.ShippingAccountCode" />
                </div>

            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label for="Description">Print Format</label>
                @Html.DropDownListFor(model => model.PrintFormat, (IEnumerable<SelectListItem>)ViewBag.PrintFormatdropDown, "Select Print Format", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Print Format" })


            </div>
            <div class="form-group">
                <label for="Description">QC Percent</label>
                <div class="input-group">
                    <input type="text" id="QCPercent" class="form-control" name="QCPercent" placeholder="QC Percent" value="@Model.QCPercent" />
                </div>

            </div>
            <div class="form-group">
                <label for="Description">Bizday SLA Type</label>
                <div class="input-group">
                    <select id="BizdaySLAType" class="form-control" name="BizdaySLAType">
                        <option @(Model.BizdaySLAType == AM.Entities.SLAType.NA ? "selected='selected'" : "") value="@AM.Entities.SLAType.NA">@AM.Entities.SLAType.NA</option>
                        <option @(Model.BizdaySLAType == AM.Entities.SLAType.Duration ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.Duration">@AM.Entities.SLAType.Duration</option>
                        <option @(Model.BizdaySLAType == AM.Entities.SLAType.FixedTime ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.FixedTime">@AM.Entities.SLAType.FixedTime</option>
                    </select>
                </div>

            </div>
            <div class="form-group">
                <label for="Description">Bizday Cut Off</label>
                <div class="input-group">
                    <input type="text" id="BizdayCutOff" value="@Model.BizdayCutOff" class="form-control timespan" placeholder="Bizday Cut Off" name="BizdayCutOff" />
                </div>

            </div>
            <div class="form-group">
                <label for="Description">Bizday Timespan</label>
                <div class="input-group">
                    <input type="text" id="BizdayTimeSpan" value="@Model.BizdayTimeSpan" class="form-control daytimespan" placeholder="Bizday Timespan" name="BizdayTimeSpan" />
                </div>

            </div>

            <div class="form-group">
                <label for="Description">Description</label>
                <div class="input-group">
                    <textarea id="Description" rows="1" name="Description" placeholder="Description" class="form-control">@Model.Description</textarea>
                </div>
            </div>
            <div class="form-group">
                <label for="Description">Shipping Special Service</label>
                <div class="input-group">

                    <select id="ShippingSpecialService" data-live-search="true" data-live-search-placeholder="Select Shipping Special Service" multiple="multiple" class="form-control selectpicker" name="ShippingSpecialService">
                        @foreach (var item in ViewBag.ShippingSpecialService as List<SelectListItem>)
                        {
                            var lst = Model.ShippingSpecialService == null ? new List<string>() : Model.ShippingSpecialService.Split(',').ToList();
                            string sel = lst.Any(l => l == item.Value) ? "selected" : "";
                            <option value="@item.Value" @sel>@item.Text</option>
                        }

                    </select>

                </div>
            </div>
            @*<div class="form-group">
                    <label for="Description">Is Cover Letter required?</label>
                    <div class="input-group">
                        <input type="radio" id="Yes" value="Yes" name="IsCoverLetter" class="cl-radio radio-orange" />
                        <label for="Yes">Yes</label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        <input type="radio" id="No" value="No" name="IsCoverLetter" class="cl-radio radio-salmon" />
                        <label for="No">No</label>
                    </div>
                    <span for="IsCoverLetter" class="error" style="display:none;">* Please pick an option above</span>
                </div>*@
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label for="Description">Sat SLA Type</label>
                <div class="input-group">
                    <select id="SatSLAType" class="form-control" name="SatSLAType">
                        <option @(Model.SatSLAType == AM.Entities.SLAType.NA ? "selected='selected'" : "") value="@AM.Entities.SLAType.NA">@AM.Entities.SLAType.NA</option>
                        <option @(Model.SatSLAType == AM.Entities.SLAType.Duration ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.Duration">@AM.Entities.SLAType.Duration</option>
                        <option @(Model.SatSLAType == AM.Entities.SLAType.FixedTime ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.FixedTime">@AM.Entities.SLAType.FixedTime</option>
                    </select>
                </div>

            </div>
            <div class="form-group">
                <label for="Description">Sat Cut Off</label>
                <div class="input-group">
                    <input type="text" id="SatCutOff" value="@Model.SatCutOff" class="form-control timespan" placeholder="Sat Cut Off" name="SatCutOff" />
                </div>

            </div>
            <div class="form-group">
                <label for="Description">Sat Timespan</label>
                <div class="input-group">
                    <input type="text" id="SatTimeSpan" value="@Model.SatTimeSpan" class="form-control daytimespan" placeholder="Sat Timespan" name="SatTimeSpan" />
                </div>

            </div>
            <div class="form-group">
                <label for="Description">Sun SLA Type</label>
                <div class="input-group">
                    <select id="SunLAType" class="form-control" name="SunSLAType">
                        <option @(Model.SunSLAType == AM.Entities.SLAType.NA ? "selected='selected'" : "") value="@AM.Entities.SLAType.NA">@AM.Entities.SLAType.NA</option>
                        <option @(Model.SunSLAType == AM.Entities.SLAType.Duration ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.Duration">@AM.Entities.SLAType.Duration</option>
                        <option @(Model.SunSLAType == AM.Entities.SLAType.FixedTime ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.FixedTime">@AM.Entities.SLAType.FixedTime</option>
                    </select>
                </div>

            </div>
            <div class="form-group">
                <label for="Description">Sun Cut Off</label>
                <div class="input-group">
                    <input type="text" id="SunCutOff" value="@Model.SunCutOff" class="form-control timespan" placeholder="Sun Cut Off" name="SunCutOff" />
                </div>

            </div>

            <div class="form-group">
                <label for="Description">Sun Timespan</label>
                <div class="input-group">
                    <input type="text" id="SunTimeSpan" value="@Model.SunTimeSpan" class="form-control daytimespan" placeholder="Sun Timespan" name="SunTimeSpan" />
                </div>

            </div>
            @*<div class="from-group">
                    <label for="Description">Select Files(pdf only)</label>
                    <div class="input-group">
                        <input type="file" multiple="multiple" class="uploadInput" style="display:none;" accept="application/pdf">
                        <button type="button" id="uploadBtn" class="btn btn-default"><i class="fa fa-upload"> </i> Upload File</button>
                    </div>
                </div>*@
        </div>

    </div>
