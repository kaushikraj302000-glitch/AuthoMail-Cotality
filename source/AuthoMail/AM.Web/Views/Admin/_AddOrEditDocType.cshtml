</form>

<script>
    $(document).ready(function () {
        if ($("#Id").val() == "0") {
            $(".daytimespan").val("00:00:00:00");
            $(".timespan").val("00:00:00");
        }
        $(".daytimespan").inputmask('datetime', {
            mask: "X:h:s:s",
            placeholder: "dd:hh:mm:ss",
            separator: ':',
            hourFormat: "24"
        });
        $(".timespan").inputmask('datetime', {
            mask: "h:s:s",
            placeholder: "hh:mm:ss",
            separator: ':',
            hourFormat: "24"
        });


    });
    var fileArray = new Array();

    function RemoveFile(index) {
        fileArray.splice(index, 1);
        MadeFileList(fileArray);
    }

    function MadeFileList() {
        var fileList = $("#fileList");
        fileList.empty();
        var tr = "";
        if (fileArray.length == 0) {
            tr = '<tr><td colspan="3">No files selected</td></tr>';
        } else {
            for (var i = 0; i < fileArray.length; i++) {
                tr = tr + "<tr><td>" + fileArray[i].name + "</td><td>1</td><td><span style='cursor: pointer;' onclick='RemoveFile(" + i + ")'>  <i class='fa fa-times'></i></span></td></tr>";
            }
        }
        fileList.html(tr);

    }
    $('#uploadBtn').click(function () {

        $('.uploadInput').click();
        $('.uploadInput').on('change', function (e) {
            //isPdf = e.target.files
            var cnt = 0;

            console.log(e.target.files);
            var files = e.target.files;
            for (var i = 0; i < files.length; i++) {
                if (files[i].name.split('.').pop().toLowerCase() == "pdf") {

                    fileArray.push(files[i]);
                }
                else {
                    cnt++;
                }
            }
            if (cnt > 0) {
                fileArray = new Array();
                window.clui.globalAlert({
                    message: "Please select pdf files.",
                    alertType: 'red',
                    timeout: 5000
                });
            }
            //files.split('.').pop().toLowerCase()=="pdf"
            MadeFileList(fileArray);
            console.log(fileArray);
        });
    });

</script>
