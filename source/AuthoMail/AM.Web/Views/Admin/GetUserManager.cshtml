@{
    ViewBag.Title = "GetUserManager";
}

<div class="row">
    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="panel-title">
                <i class="fa fa-globe"></i> UserManager List <span class="pull-right">
                    <button type="button" class="btn btn-primary" data-target="#AssignRoleModal" data-toggle="modal"><i class="fa fa-plus"></i> Assign Role</button>
                </span>
            </div>
        </div>
        <div class="panel-body panel-gray" style="padding:2% 2% 2% 2% !important;min-height: 107px;">
            <div class='alert alert-blue text-center' id="loading" style="display:none"><span> Loading... </span></div>
            <div id="UserManagerList"></div>

        </div>
    </div>

</div>

<div id="UserManagerTableContent" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                <th>Email</th>
                <th>Allowed Domain</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="UserManagerBodyContent"></tbody>
    </table>
</div>
<div style="display:none">
    <table>
        <tbody id="UserManagerBody">
            <tr class="row-small">
                <td><span>{Email}</span></td>
                <td><span>{AllowedDomain}</span></td>
                <td>{Action}</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="modal fade" id="AddEditModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header" style="margin-top:2%;margin-bottom:2%;">

            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="AssignRoleModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header" style="margin-top:2%;margin-bottom:2%;">
                <h3>Assign UserManager Role</h3>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="Description">Email</label>
                    <div class="input-group">
                        <input type="email" id="assignemail" class="form-control" placeholder="Email" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="SaveAssignRoleBtn">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script type="text/javascript">
        $(document).ready(function () {
            function FormatObject(Model) {
                $(Model).each(function () {
                    this.Action = '<span style="cursor: pointer;font-size:1.2em;" onclick="AddEditDomain(this)" data-alloweddomain="' + this.AllowedDomain + '" ><i class="padding-left-15 fa fa-trash text-blue" aria-hidden="true" title="Edit"><span class="sr-only">Edit</span></i></span>';
                });
                return Model;
            }


            var GetData = function () {
                $("#UserManagerList").hide();
                var el = $('#UserManagerList');
                $("#loading").show();
                $.ajax({
                    type: "GET",
                    url: baseUrl + "Admin/GetUserManagerList",
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        //console.log(response);
                        $("#loading").hide();
                        if (response.Success) {
                            $("#UserManagerList").show();
                            if (response.Object != null) {
                                if (response.Object.length > 0) {
                                    $("#UserManagerList").html("");
                                    var data = FormatObject(response.Object);
                                    BindTemplate(data, "#UserManagerBody", "#UserManagerBodyContent", "#UserManagerTableContent", "#UserManagerList");
                                }
                                else {
                                    $("#UserManagerList").html(" <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>")
                                }
                            }
                        } else {

                            $("#UserManagerList").show();
                            $("#UserManagerList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                        }
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        $("#UserManagerList").show();
                        $("#loading").hide();
                        var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                        $("#UserManagerList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                    }

                });

            }
            GetData();
        });
