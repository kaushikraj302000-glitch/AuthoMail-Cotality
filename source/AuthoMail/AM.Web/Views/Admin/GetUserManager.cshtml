            });

        }

        var SaveAssignRoleBtnEvent = function () {
            $('#SaveAssignRoleBtn').click(function (e) {
                e.preventDefault();
                var email = $('#assignemail').val();
                $.ajax({
                    type: "POST",
                    url: baseUrl + "Admin/AssignUserManagerRole",
                    data: { email: email },
                    dataType: "json",
                    success: function (response) {
                        if (response.Success) {
                            alert(response.Object);
                        }
                        else {
                            alert(response.ErrorMessage);
                        }
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                        alert(msg);
                    }
                });
            });
        }
        SaveAssignRoleBtnEvent();
    </script>
