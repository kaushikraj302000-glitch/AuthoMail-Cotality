@model AM.Services.DocTypePageRange

<div class="rw" id="pagerangediv@(ViewBag.index)">
    @if (ViewBag.isFallBack)
    {
        string isChecked = string.IsNullOrWhiteSpace(Model.ShippingCarrier) ? "" : "checked";

        <div class="col-md-2 colmd">
            <div class="col-md-2" style="padding-left:0px;">
                <input class="colmda" type="checkbox" @isChecked name="DocTypes.DocTypePageRangeList[@ViewBag.index].IsFallBack" />
            </div>
            <div class="col-md-5 colmd">
                <input class="form-control frm-control" placeholder="From" type="number" min="1" title="From" value="1" />
            </div>
            <div class="col-md-5" style="padding-left:5px;padding-right:0px;">
                <input class="form-control frm-control" placeholder="To" type="number" min="1" max="999" title="To" value="999" />
            </div>
        </div>
        <div class="col-md-2 colmd">
            <label class="form-control frm-control">USPS</label>
        </div>
        <div class="col-md-2 colmd">
            <label class="form-control frm-control">@ViewBag.shippingServiceType</label>
            <input type="hidden" name="DocTypes.DocTypePageRangeList[@ViewBag.index].ShippingServiceType" value="@ViewBag.shippingServiceType" />
        </div>
    }
    else
    {
        <div class="col-md-2 colmd">
            <div class="col-md-2" style="padding-left:0px;">
                <a href="#" class="colmda"><i class="fa fa-trash" title="Delete"></i></a>
            </div>
            <div class="col-md-5 colmd">
                <input class="form-control frm-control" placeholder="From" type="number" min="1" title="From" value="@Model.From" name="DocTypes.DocTypePageRangeList[@ViewBag.index].From" id="From@(ViewBag.index)" />
            </div>
            <div class="col-md-5" style="padding-left:5px;padding-right:0px;">
                <input class="form-control frm-control" placeholder="To" type="number" min="1" max="999" title="To" value="@Model.To" name="DocTypes.DocTypePageRangeList[@ViewBag.index].To" id="To@(ViewBag.index)" />
            </div>
        </div>
        <div class="col-md-2 colmd">

            @Html.DropDownListFor(model => model.ShippingCarrier, (IEnumerable<SelectListItem>)ViewBag.ShippingCarrierdropDown, "Select Shipping Carrier", htmlAttributes: new
            {
                @class = " form-control selectpicker frm-control",
                @data_live_search = "true",
                @data_live_search_placeholder = "Search Shipping Carrier",
                @data_title = "Shipping Carrier",
                id = string.Format("ShippingCarrier{0}", ViewBag.index),
                name = string.Format("DocTypes.DocTypePageRangeList[{0}].ShippingCarrier", ViewBag.index)
            })
        </div>
        <div class="col-md-2 colmd">
            @Html.DropDownListFor(model => model.ShippingServiceType, (IEnumerable<SelectListItem>)ViewBag.ShippingServiceTypedropDown, "Select Shipping Service Type", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Shipping Service Type", @data_title = "Shipping Service Type" })
        </div>
    }
    <div class="col-md-2 colmd">
        <select data-live-search="true" data-live-search-placeholder="Select Shipping Special Service" class="form-control selectpicker" multiple="multiple" name="DocTypes.DocTypePageRangeList[@ViewBag.index].ShippingSpecialService">
            @foreach (var item in ViewBag.ShippingSpecialService as List<SelectListItem>)
            {
                var lst = Model.ShippingSpecialService == null ? new List<string>() : Model.ShippingSpecialService.Split(',').ToList();
                <option value="@item.Value">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2 colmd">
        @Html.DropDownListFor(model => model.EnvelopeId, (IEnumerable<SelectListItem>)ViewBag.EnvelopedropDown, "Select Envelope", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Envelope", @data_title = "Envelope" })
    </div>
    <div class="col-md-2 colmd" style="border-right:none;">
        @Html.DropDownListFor(model => model.BREEnvelopeId, (IEnumerable<SelectListItem>)ViewBag.BREEnvelopedropDown, "Select BRE Envelope", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search BRE Envelope", @data_title = "BRE Envelope" })
    </div>
    <div class="clearfix"></div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('.selectpicker').selectpicker();
    });
</script>
