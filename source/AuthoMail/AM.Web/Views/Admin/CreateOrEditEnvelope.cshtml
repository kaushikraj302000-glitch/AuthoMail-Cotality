                        </div>

                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="IsBREEnvelope">Is BRE Envelope?</label>
                            <div class="input-group">
                                <div class="toggle-container">
                                    <input id="IsBREEnvelope" class="cl-toggle toggle-orange" type="checkbox" @(Model.IsBREEnvelope ? "checked" : "") name="toggle-demo" /><label for="IsBREEnvelope">IsBREEnvelope</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="PartNumber">Part Number</label>
                            <div class="input-group">
                                <input type="text" id="PartNumber" class="form-control" name="PartNumber" value="@Model.PartNumber" />
                            </div>
                        </div>

                    </div>
                </div>
                <div class="row">
                    <h3>Shippers Details</h3>
                    <hr />
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="Description">Select Shipper</label>
                            <div class="input-group">
                                @Html.DropDownList("Shipper", ViewBag.Shippers as SelectList, "", new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Shipper" })
                                <span class="input-group-addon" style="padding: 0px 0px;"> <button type="button" style="    font-size:24px;padding: 0px 67px" id="addShipper" class="btn btn-primary"><i class="fa fa-plus"></i></button></span>
                            </div>
                            <span for="ShipperId" class="error" style="display:none;">This field is required.</span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div id="shipperStock">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Shipper</th>
                                        <th>Quantity</th>
                                        <th>Unit Price</th>
                                        <th>Reorder Duration</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="shippertBody">

                                    @if (Model.EnvelopeInventoryStockVMs.Count > 0)
                                    {
                                        foreach (var item in Model.EnvelopeInventoryStockVMs)
                                        {
                                            @Html.Partial("_ShipperWiseStockDetails", item)
                                        }
                                    }
                                    
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 text-center">
                        <button type="submit" class="btn btn-primary" id="Save"><i class="fa fa-save"></i> Save</button>
                        <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-close"></i> Cancel</button>

                    </div>
                </div>
            </form>
        </div>
    </div>

</div>
<table  style="display:none" id="emptyTrHtml">
    <tr class="emptyTrHtml">
        <td colspan="5" class="tdpadding"><div class="alert alert-yellow">No record found.</div></td>
    </tr>
</table>
@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")

    <script type="text/javascript">
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            ValidateForm();
            // JSON.useDateParser(false);
            if ($("#shippertBody").length==0)
            $("#shippertBody").append(`<tr id="emptyTr">
                    <td colspan="5" class="tdpadding"><div class="alert alert-yellow">No record found.</div></td>
                </tr>`);
        });


        function ValidateForm() {
            window.clui.selectInit();
            init();
            $('#envelopeform').validate({ // initialize the plugin
                errorElement: "span",
                rules: {
                    Id: {
                        required: true,
                        maxlength: 255

                    },
                    EnvelopeName: {
                        required:true
                    },
                    PartNumber: {
                        required: true,
                        remote: {
                            onkeyup: false,
                            type: 'post',
                            url: baseUrl + "Admin/IsPartNumberExists",
                            data: {
                                id: parseInt($("#Id").val()),
                                partNumber: $("#PartNumber").val()
                            },
                            dataType: 'json',
                            dataFilter: function (response) {
                                var result = JSON.parse(response);
                                return result.Key;
                            },
                        }
                    }
                },
                messages: {
                    PartNumber: {
                        remote: function () { return jQuery.format("{0} is already exists.", $("#PartNumber").val()) }
                    }
                },
                submitHandler: function (form) {
                    $("#AddEditModal").modal("hide");
                    SaveEnvelope();
                }
            });
        }

        function AddEditEnvelope(obj) {
            var id = $(obj).data("id");
            var el = $("#AddEditModal").find(".modal-header");
            el.empty();
            $.ajax({
                type: "GET",
                url: baseUrl + "Admin/GetEnvelopeById",
                data: { id: id },
                success: function (response) {
                    el.html(response);

                    $("#AddEditModal").modal("show");
                    ValidateForm();
                },
                error: function (xhr, ajaxOptions, thrownError) {

                    //Spinners(".spinnericon", "faspinner");
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#AddEditModal").modal("show");
                }
            });

        }

      
        function DeleteShipper(obj) {
            $(obj).closest('tr').remove();
            $('#Shipper option[value="' + $(obj).data("shipperid") + '"]').prop('disabled', false);
            $('#Shipper').val('');
            $('.selectpicker').selectpicker('refresh');
            if ($(obj).closest('tbody').length == 0) {
                $("#shippertBody").append(`<tr id="emptyTr">
                    <td colspan="5" class="tdpadding"><div class="alert alert-yellow">No record found.</div></td>
                </tr>`);
            }
        }
        $(document).on("click", "#addShipper", function () {
            $.ajax({
                type: "POST",
                url: baseUrl + "Admin/ShipperWiseStock",
                data: { ShipperId: $("#Shipper").val(), ShipperName: $("#Shipper option:selected").text() },
                success: function (response) {
                    $("#emptyTr").remove();
                    $("#shippertBody").append(response);
                    $('#Shipper option[value="' + $("#Shipper").val()+'"]').prop('disabled', true);
                    $('#Shipper').val('');
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    //console.log()
                }
            });
        });
        //Transaction code added
        function AddEditEnvelopeTransaction(obj) {
            var id = $(obj).data("id");
            var envelopeId = $(obj).data("envelopeid");
            var envelopeName = $(obj).data("envelopename");
            var el = $("#AddEditModal").find(".modal-header");
            //console.log(envelopeName);
            el.empty();
            $.ajax({
                type: "GET",
                url: baseUrl + "Admin/GetEnvelopeTransactionsByName",
                data: { id: id, envelopeId: envelopeId },
                success: function (response) {
                    el.html(response);
                    $("#AddEditModal").modal("show");
                    $("#AddEditModal").find("#envelopeName").text(envelopeName);
                    ValidateFormET();
                },
                error: function (xhr, ajaxOptions, thrownError) {

                    //Spinners(".spinnericon", "faspinner");
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#AddEditModal").modal("show");
                }
            });

        }
        function EnvelopeTransactions(Id, EnvelopeId, ReceivedQuantity, UnitPrice, Description) {
            this.Id = Id;
            this.EnvelopeId = EnvelopeId;
            this.ReceivedQuantity = ReceivedQuantity;
            this.UnitPrice = UnitPrice;
            this.Description = Description;
        }
        function SaveEnvelopeTransactions() {
            //console.log("SaveET");
            var isBRE = $("#IsBREEnvelope").is(':checked') ? true : false;
            var envelopeTransactions = new EnvelopeTransactions($("#Id").val(), $("#EnvelopeId").val(), $("#ReceivedQuantity").val(), $("#UnitPrice").val(), $("#Description").val());
            var el = $("#myModal").find(".modal-body");
            el.empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "Admin/CreateOrEditEnvelopeTransactions",
                data: { envelopeInventory: envelopeTransactions },
                success: function (response) {
                    if (response.Success) {
                        if (response.Object != null) {
                            //console.log(response.Object)
                            if (response.Object.Key) {
                                el.html("<div class='alert alert-green'>" + response.Object.Value + "</div>");
                            }
                            else {
                                el.html("<div class='alert alert-red'>" + response.Object.Value + "</div>");
                            }
                        }
                    }
                    else {

                        el.html("<div class='alert alert-red'>" + response.ErrorMessage + "</div>");
                    }
                    $("#myModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }
            });
        }
        function ValidateFormET() {
            window.clui.selectInit();
            init();
            $('#envelopetransactionsform').validate({ // initialize the plugin
                errorElement: "span",
                rules: {
                    ReceivedQuantity: {
                        required: true,
                        min: 1,
                    },
                    UnitPrice: {
                        required: true,
                        min: 1,
                    }
                },
                submitHandler: function (form) {
                    $("#AddEditModal").modal("hide");
                    SaveEnvelopeTransactions();
                }
            });
        }

        function ViewDetails(obj) {
            var id = $(obj).data("id");
            $("#stockDetails").modal("show");
            $.ajax({
                type: "POST",
                url: baseUrl + "Admin/GetEnvelopeStockDetails",
                data: { id: id },
                success: function (response) {
                    //console.log(response);
                    if (response.Success) {
                        var envelopeInventoryUsage = response.Object.Item1;
                        var envelopeArrival = response.Object.Item2;
                        if (envelopeArrival.length > 0) {
                            var tr = "";
                            for (var i = 0; i < envelopeInventoryUsage.length; i++) {
                                tr += "<tr><td class='text-center'>" + moment(envelopeInventoryUsage[i].Date).format("MM/DD/YYYY") + "</td>" + "<td class='text-center'>" + envelopeInventoryUsage[i].UsageStock + "</td></tr>";
                            }
                            $("#tbodyOut").html(tr);
                        } else {
                            $("#tbodyOut").html("<tr><td colspan='2'><div class='alert alert-red'><span>" + msg + "</span></div></td></tr>");
                        }

                        if (envelopeArrival.length > 0) {
                            var tr = "";
                            for (var i = 0; i < envelopeArrival.length; i++) {
                                tr += "<tr><td class='text-center'>" + moment(envelopeArrival[i].Date).format("MM/DD/YYYY") + "</td>" + "<td class='text-center'>" + envelopeArrival[i].UsageStock + "</td></tr>";
                            }
                            $("#tbodyIn").html(tr);

                        } else {
                            $("#tbodyIn").html("<tr><td colspan='2'><div class='alert alert-red'><span>" + msg + "</span></div></td></tr>");
                        }

                    } else {
                        var msg = '@AM.Services.Config.Web_Msg_NoRecordFound';
                        $("#tbodyOut").html("<tr><td colspan='2'><div class='alert alert-red'><span>" + msg + "</span></div></td></tr>");
                        $("#tbodyIn").html("<tr><td colspan='2'><div class='alert alert-red'><span>" + msg + "</span></div></td></tr>");
                    }

                },
                error: function (xhr, ajaxOptions, thrownError) {

                    //Spinners(".spinnericon", "faspinner");
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    $("#tbodyOut").html("<tr><td colspan='2'><div class='alert alert-red'><span>" + msg + "</span></div></td></tr>");
                    $("#tbodyIn").html("<tr><td colspan='2'><div class='alert alert-red'><span>" + msg + "</span></div></td></tr>");
                }
            });
        }
        //end transcation code
        function Envelopes(Id, EnvelopeName, EnvelopeDesc, CurrentQuantity, IsBREEnvelope, PartNumber) {
            this.Id = Id;
            this.EnvelopeName = EnvelopeName;
            this.EnvelopeDesc = EnvelopeDesc;
            this.CurrentQuantity = CurrentQuantity;
            this.IsBREEnvelope = IsBREEnvelope;
            this.PartNumber = PartNumber;
        }
        function SaveEnvelope() {

            var isBRE = $("#IsBREEnvelope").is(':checked') ? true : false;
            var ReorderDuration = $('#ReorderDuration').val();
            var envelopes = new Envelopes($("#Id").val(), $("#EnvelopeName").val(), $("#EnvelopeDesc").val(), $("#CurrentQuantity").val(), isBRE, $("#PartNumber").val());
            //console.log(envelopes);
            var el = $("#myModal").find(".modal-body");
            el.empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "Admin/CreateOrEditEnvelope",
                data: { envelopes: envelopes },
                success: function (response) {
                    if (response.Success) {
                        if (response.Object != null) {
                            if (response.Object.Key) {
                                el.html("<div class='alert alert-green'>" + response.Object.Value + "</div>");
                            }
                            else {
                                el.html("<div class='alert alert-red'>" + response.Object.Value + "</div>");
                            }
                        }
                    }
                    else {

                        el.html("<div class='alert alert-red'>" + response.ErrorMessage + "</div>");
                    }
                    $("#myModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }
            });
        }

    </script>
}