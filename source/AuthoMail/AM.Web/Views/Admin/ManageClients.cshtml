<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Client Details</h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")

    <script type="text/javascript">
        $(document).ready(function () {

            GetClients();
           

        });

        function ValidateCoverLetter() {
            window.clui.selectInit();
            if ($("#file").val().trim() == "") {
                $("#Save").attr("disabled", "disabled");
            }
            $('#coverletterform').validate({ // initialize the plugin
                errorElement: "span",
                rules: {
                    FileName: {
                        required: true,
                        maxlength: 255

                    },
                    DocTypeId: {
                        required: true
                    },
                    SeqId: {
                        required: true,
                        digits: true
                    }
                },
                submitHandler: function (form) { // for demo
                    var docTypeId = parseInt($("#AddCoverLetterModal").find(".modal-header").find("#DocTypeId").val());
                    var fileName = $("#AddCoverLetterModal").find(".modal-header").find("#FileName").val();
                    var seqId = parseInt($("#AddCoverLetterModal").find(".modal-header").find("#SeqId").val());
                    var file = $("#AddCoverLetterModal").find(".modal-header").find("#file").prop('files')[0];
                    $("#AddCoverLetterModal").modal("hide");
                    var el = $("#myModal").find(".modal-body");
                    el.empty();
                    var formData = new FormData();
                    formData.append("file", file);
                    formData.append("docTypeId", docTypeId);
                    formData.append("seqId", seqId);
                    formData.append("fileName", fileName);
                    $.ajax({
                        //dataType: 'json',
                        //data: JSON.stringify({ docTypeId: docTypeId, seqId: seqId, fileName: fileName, file: file[0].files }),
                        // contentType: "application/json; charset=utf-8",
                        type: "POST",
                        url: baseUrl + "Admin/_AddCoverLetter",
                        processData: false,  // tell jQuery not to process the data
                        contentType: false,
                        data:formData,
                        success: function (response) {
                            //console.log(response);
                            if (response.Success) {
                                if (response.Object != null) {
                                    if (response.Object.Key) {
                                        el.html("<div class='alert alert-green'>" + response.Object.Value + "</div>");
                                    }
                                    else {
                                        el.html("<div class='alert alert-red'>" + response.Object.Value + "</div>");
                                    }
                                }

                            }
                            else {
                                el.html("<div class='alert alert-red'>" + response.ErrorMessage + "</div>");

                            }
                            $("#myModal").modal("show");
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            el.show();
                            $("#loading").hide();
                            var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                            el.html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                            $("#myModal").modal("show");
                        }

                    });
                }
            });
        }


        function ValidateForm() {
            window.clui.selectInit();
            $('#clientform').validate({ // initialize the plugin
                errorElement: "span",
                rules: {
                    Name: {
                        required: true,
                        lettersonly: true,
                        maxlength: 255

                    },
                    BusinessUnit: {
                        required: true
                    },
                    AppCode: {
                        required: true,
                        maxlength: 128
                    },
                    TimeZone: {
                        required: true,
                        lettersonly: true,
                        maxlength: 255
                    }
                },
                submitHandler: function (form) { // for demo
                    var Id = $("#AddEditModal").find(".modal-header").find("#Id").val();
                    var name = $("#AddEditModal").find(".modal-header").find("#Name").val();
                    var appCode = $("#AddEditModal").find(".modal-header").find("#AppCode").val();
                    var businessUnit = $("#AddEditModal").find(".modal-header").find("#BusinessUnit").val();
                    var timezone = $("#AddEditModal").find(".modal-header").find("#TimeZone").val();
                    var ClientObj = new Clients(Id, name, appCode, businessUnit, timezone);
                    //console.log(ClientObj);
                    $("#AddEditModal").modal("hide");
                    var el = $("#myModal").find(".modal-body");
                    el.empty();
                    $.ajax({
                        type: "POST",
                        url: baseUrl + "Admin/CreateOrEditClient",
                        data: JSON.stringify({ client: ClientObj }),
                        contentType: "application/json; charset=utf-8",
                        success: function (response) {
                            //console.log(response);
                            if (response.Success) {
                                if (response.Object != null) {
                                    if (response.Object.Key) {
                                        el.html("<div class='alert alert-green'>" + response.Object.Value + "</div>");
                                    }
                                    else {
                                        el.html("<div class='alert alert-red'>" + response.Object.Value + "</div>");
                                    }
                                }
                                GetClients();
                            }
                            else {
                                el.html("<div class='alert alert-red'>" + response.ErrorMessage + "</div>");

                            }
                            $("#myModal").modal("show");
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            el.show();
                            $("#loading").hide();
                            var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                            el.html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                            $("#myModal").modal("show");
                        }

                    });
                }
            });
        }
        function Clients(Id, Name, AppCode, BusinessUnit, TimeZone) {
            this.Id = Id;
            this.Name = Name;
            this.AppCode = AppCode;
            this.BusinessUnit = BusinessUnit;
            this.TimeZone = TimeZone;
        }

        var GetClients = function () {
            //$("#ClientList").hide();
            var el = $('#ClientList');
            $("#loading").show();
            $.ajax({
                type: "GET",
                url: baseUrl + "Admin/GetClients",
                //data: JSON.stringify({}),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    $("#loading").hide();
                    if (response.Success) {
                        el.show();
                        if (response.Object != null) {
                            if (response.Object.length > 0) {
                                el.html("");
                                var data = FormatObject(response.Object);
                                BindTemplate(data, "#ClientBody", "#ClientbodyContent", "#ClientTableContent", "#ClientList");
                            }
                            else {
                                el.html(" <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>")
                            }
                        }
                    } else {

                        el.show();
                        el.html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.show();
                    $("#loading").hide();
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                }

            });
        }

        function AddCoverLetter(obj) {
            var Id = $(obj).data("id");
            var el = $("#AddCoverLetterModal").find(".modal-header");
            el.empty();
            $.ajax({
                type: "GET",
                url: baseUrl + "Admin/_AddCoverLetter",
                data: { Id: Id },
                success: function (response) {
                    el.html(response);
                    $("#AddCoverLetterModal").modal("show");
                    ValidateCoverLetter();
                },
                error: function (xhr, ajaxOptions, thrownError) {

                    //Spinners(".spinnericon", "faspinner");
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#AddCoverLetterModal").modal("show");
                }
            });
        }

        function AddEditClient(obj) {
            var Id = $(obj).data("id");
            var el = $("#AddEditModal").find(".modal-header");
            el.empty();
            $.ajax({
                type: "GET",
                url: baseUrl + "Admin/GetClientById",
                data: { Id: Id },
                success: function (response) {
                    el.html(response);
                    $("#AddEditModal").modal("show");
                    ValidateForm();
                },
                error: function (xhr, ajaxOptions, thrownError) {

                    //Spinners(".spinnericon", "faspinner");
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#AddEditModal").modal("show");
                }
            });

        }
        function FormatObject(Model) {
            $(Model).each(function () {
                this.IsAMActiveFormatted = this.IsAMActive ? '<div class="toggle-container"><input id="isamactive' + this.Id + '" onclick="MakeActiveOrDeactive(this)" data-id="' + this.Id + '" data-isam="1"  data-currentvalue="' + this.IsAMActive + '" class="cl-toggle toggle-orange" type="checkbox" checked="checked" name="toggle-demo"/><label for="isamactive' + this.Id + '">Is Active</label></div>' : '<div class="toggle-container"><input id="isamactive' + this.Id + '" onclick="MakeActiveOrDeactive(this)" data-currentvalue="' + this.IsAMActive + '" data-id="' + this.Id + '" data-isam="1" class="cl-toggle toggle-orange" type="checkbox" name="toggle-demo"/><label for="isamactive' + this.Id + '">Is Active</label></div>';

                this.IsPnSActiveFormatted = this.IsPnSActive ? '<div class="toggle-container"><input id="ispnsactive' + this.Id + '" onclick="MakeActiveOrDeactive(this)" data-isam="0"  data-id="' + this.Id + '"  data-currentvalue="' + this.IsPnSActive + '" class="cl-toggle toggle-orange" type="checkbox" checked="checked" name="toggle-demo"/><label for="ispnsactive' + this.Id + '">Is Active</label></div>' : '<div class="toggle-container"><input id="ispnsactive' + this.Id + '" onclick="MakeActiveOrDeactive(this)" data-isam="0"  data-currentvalue="' + this.IsPnSActive + '" data-id="' + this.Id + '" class="cl-toggle toggle-orange" type="checkbox" name="toggle-demo"/><label for="ispnsactive' + this.Id + '">Is Pns Active</label></div>';

                this.Action = '<span style="cursor: pointer;font-size:1.2em;" onclick="AddEditClient(this)" data-id="' + this.Id + '" ><i class="padding-left-15 fa fa-edit text-blue" aria-hidden="true" title="Edit"><span class="sr-only">Edit</span></i></span>';

                this.CoverLetter = '<span style="cursor: pointer;font-size:1.2em;margin-left: 10px;" onclick="AddCoverLetter(this)" data-id="' + this.Id + '" ><i class=" fa fa-file-pdf-o text-red" aria-hidden="true" title="Add Cover Letter"><span class="sr-only">Cover Letter</span></i></span>';

            });
            return Model;
        }


        function MakeActiveOrDeactive(obj) {
            var isActive = $(obj).is(":checked");
            var Id = $(obj).data("id");
            var el = $("#myModal").find(".modal-body");
            var isAM = parseInt($(obj).data("isam")) == 1 ? true : false;
            var clientmsg = isAM ? "AM" : "Pns";
            el.empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "Admin/MakeActiveOrDeactiveClient",
                data: JSON.stringify({ isActive: isActive, Id: Id, isAM: isAM }),
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (response) {
                    //Spinners("#pullback", "fa-reply");
                    if (response.Success) {
                        //if (response.Object != null) {
                        //    if (response.Object == 1 && isActive) {

                        //        el.html("<div class='alert alert-green'>" + clientmsg + " activated successfully.</div>");
                        //    }
                        //    if (response.Object == 1 && !isActive) {
                        //        el.html("<div class='alert alert-green'>" + clientmsg + " deactivated successfully.</div>");
                        //    }
                        //}
                        GetClients();
                    }
                    else {
                        el.html("<div class='alert alert-red'>" + response.ErrorMessage + "</div>");
                        $("#myModal").modal("show");
                    }

                },
                error: function (xhr, ajaxOptions, thrownError) {

                    //Spinners(".spinnericon", "faspinner");
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }

            });

        }

