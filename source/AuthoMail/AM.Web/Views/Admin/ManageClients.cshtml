@{
    ViewBag.Title = "ManageClients";
}

<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<style>
    #dateFilter .bootstrap-select {
        width: 100% !important;
    }


    .dataTables_wrapper {
        margin-top: -1.5% !important;
    }

    .popover-content {
        word-wrap: break-word;
        color: red;
    }
</style>
<div class="panel panel-default">

    <div class="panel-heading" id="clientHeader">
        <div class="panel-title">
            <i class="fa fa-users"></i> Client Details
            <span class="pull-right" @*style=" margin-right: 11%;" *@>
                <button type="button" data-id="0" class="btn btn-primary " onclick="AddEditClient(this)"><i class="fa fa-plus"></i> Add Client</button>
            </span>
        </div>
    </div>
    <div class="panel-body" id="ClientList">
        <div class='alert alert-blue text-center' id="loading" style="display:none;margin-bottom:10px;"><span> Loading... </span></div>
    </div>
</div>


<div id="ClientTableContent" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                <th>Client Name</th>
                <th>App Code</th>
                <th>Business Unit</th>
                <th>IsAMActive</th>
                <th>IsPnSActive</th>
                <th>Timezone</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="ClientbodyContent"></tbody>
    </table>
</div>
<div style="display:none">
    <table>
        <tbody id="ClientBody">
            <tr class="row-small">
                <td><span data-id="{Id}">{Name}</span></td>
                <td><span>{AppCode}</span></td>
                <td><span>{BusinessUnitModel.BusinessUnit}</span></td>
                <td><span>{IsAMActiveFormatted}</span></td>
                <td><span>{IsPnSActiveFormatted}</span></td>
                <td><span>{TimeZone}</span></td>
                <td>{Action}{CoverLetter}</td>
            </tr>
        </tbody>
    </table>
</div>


<div class="modal fade" id="AddEditModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header" style="margin-top:2%;margin-bottom:2%;">

            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="AddCoverLetterModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header" style="margin-top:2%;margin-bottom:2%;">

            </div>
        </div>
    </div>
</div>

