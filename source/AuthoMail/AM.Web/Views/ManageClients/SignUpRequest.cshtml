                "pageLength": 5,

                "dom": "<'row' <'col-md-12'B>><'row'<'col-md-6 col-sm-12'l><'col-md-6 col-sm-12'f>r><'table-scrollable't><'row'<'col-md-5 col-sm-12'i><'col-md-7 col-sm-12'p>>", // horizobtal scrollable datatable


            });
            //$('.selectpicker').selectpicker('refresh');
            //$('#BatchList').on('change', function () {
            //    var oTable = $('#sample_2').dataTable();
            //    var filterColumn = oTable.api().column(".BatchId").index();
            //    var selected = $(this).find("option:selected").val();
            //    if (!selected) {

            //        oTable.fnFilter('', filterColumn, true);
            //    } else {
            //        oTable.fnFilter("^" + parseInt(selected) + "$", filterColumn, true); //Exact value, column, reg
            //    }
            //});
        }
        function FilterData() {
            $("#signUpHeader").hide();
            $("#signUpRequestList").hide();
            var el = $('#signUpRequestList');
            //var date = $("#date").val();
            //$("#headerdate").html(date + " EST");
            $("#loading").show();
            var el = $('#signUpRequestList');
            // el.html("<div class='alert alert-blue text-center'><span> Loading... </span></div>");
            $.ajax({
                type: "GET",
                url: baseUrl + "ManageClients/GetSingUpRequestedList",
                //data: JSON.stringify({ date: date, filterBy: $("#filterBy").val(), docType: $("#DocType").val() }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.Success) {
                        if (response.Object != null) {
                            $("#loading").hide();
                            $("#signUpHeader").show();
                            $("#signUpRequestList").show();
                            //console.log(response.Object.model.length);
                            if (response.Object.model.length > 0) {
                                var data = FormatObject(response.Object.model);
                                $("#signUpRequestList").html("");
                                //this.ReceivedOnFormatted = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                                BindTemplate(data, "#signUpBody", "#signUpbodyContent", "#signUpTableContent", "#signUpRequestList");
                            }
                            else {
                                $("#signUpRequestList").html(" <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>")
                            }
                        }
                    } else {
                        $("#loading").hide();
                        $("#signUpHeader").show();
                        $("#signUpRequestList").show();
                        $("#signUpRequestList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                    }


                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#loading").hide();
                    $("#signUpHeader").show();
                    $("#signUpRequestList").show();
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    $("#signUpRequestList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                }

            });
        }
        function FormatObject(Model) {
            $(Model).each(function () {
                this.ReceivedOnFormatted = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.IsConfirmed = this.EmailConfirmed ? '<span  class="label medium label-green">Yes</span>' : '<span class="label medium label-yellow">No</span>';
                this.button = '<a style="cursor: pointer;font-size:1.5em;" onclick="ApproveUser(this)" data-userid="' + this.Id + '" data-status="@AM.Entities.AMUserStatus.Approved"><i class="fa fa-check text-green" aria-hidden="true" title="Approve"></i><span class="sr-only">Approve</span></a><a style="cursor: pointer;font-size:1.5em;" onclick="RejectUser(this)" data-userid="' + this.Id + '" data-status="@AM.Entities.AMUserStatus.Rejected"><i class="padding-left-15 fa fa-times text-red" aria-hidden="true" title="Reject"><span class="sr-only">Reject</span></i></a>';

            });
            return Model;
        }

        function ApproveUser(data) {
            $("#approveModal").data("userid", "");
            $("#approveModal").data("status", "");

            $("#approveModal").data("userid", $(data).data("userid"));
            $("#approveModal").data("status", $(data).data("status"));
            $("#approveModal").modal("show");
        }
        function RejectUser(data) {
            $("#rejectModal").data("userid", "");
            $("#rejectModal").data("status", "");
            $("#rejectModal").data("userid", $(data).data("userid"));
            $("#rejectModal").data("status", $(data).data("status"));
            $("#rejectModal").modal("show");
        }
        $("#approved").click(function () {
            $("#approveModal").modal("hide");
            UpdateUserStatus($("#approveModal").data("userid"), $("#approveModal").data("status"))
        });
        $("#rejected").click(function () {
            $("#rejectModal").modal("hide");
            UpdateUserStatus($("#rejectModal").data("userid"), $("#rejectModal").data("status"))
        });

        function UpdateUserStatus(userId, status) {
            var el = $("#myModal").find(".modal-body");
            el.empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "ManageClients/UpdateUsersRequestSignUp",
                data: JSON.stringify({ userId: userId, status: status }),
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (response) {
                    console.log(response);
                    //Spinners("#pullback", "fa-reply");
                    if (response.Success) {
                        if (response.Object != null) {
                            if (response.Object.Key) {
                                el.html("<div class='alert alert-green'>"+response.Object.Value+"</div>");
                            }
                            else
                            {
                                el.html("<div class='alert alert-red'>" + response.Object.Value + "</div>");
                            }
                        }
                        FilterData();
                    }
                    else {
                        console.log(response.ErrorMessage);
                        e.html(response.ErrorMessage);

                    }
                    $("#myModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {

                    //Spinners(".spinnericon", "faspinner");
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }

            });
        }

    </script>
}
