@using AM.Entities;
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
    {
        @Html.AntiForgeryToken()
        <ul class="nav navbar-nav navbar-right">
            @*<li>
                    @Html.ActionLink("Hello " + User.Identity.GetUserName() + "!", "Index", "Manage", routeValues: null, htmlAttributes: new { title = "Manage" })
                </li>
                <li><a href="javascript:document.getElementById('logoutForm').submit()">Log off</a></li>*@
            <li class="dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">@string.Join(string.Empty, User.Identity.DisplayName().Take(20)) <span class="caret"></span></a>
                <ul class="dropdown-menu">
                    <li>@Html.ActionLink("Change Password", "ChangePassword", "Manage")</li>
                    @if (User.IsInRole(AMRoles.Admin))
                    {
                        <li>@Html.ActionLink("AMUsers", "AMUsers", "Account")</li>
                    }
                    <li id="LastLoginLi" title="Last Login Time (EST)" style="background-color:#eee;"><a class="disabled">Last Login(EST): @User.Identity.LastLoginTime().ToString("dd/MM/yy hh:mm:ss tt")</a></li>
                    <li><a href="javascript:document.getElementById('logoutForm').submit()">Log off</a></li>
                </ul>
            </li>
        </ul>
    }
}
