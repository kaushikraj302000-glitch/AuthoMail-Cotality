<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="shortcut icon" href="~/clui/dist/img/favicon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AuthoMail</title>
    @Styles.Render("~/Content/clcss")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        #mainlink:hover {
            color: lightgray;
        }

        .error {
            color: #e03c31;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-default" role="navigation">
        <div class="mobile-overlay"></div>
        <div class="container-fluid">
            <div class="navbar-collapse-btn">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#example-navbar-collapse-3">
                    <span class="sr-only">Toggle navigation</span>
                    <i class="fa fa-bars" aria-hidden="true"></i>
                </button>
            </div>
            @if (User.Identity.IsAuthenticated)
            {
                <div class="navbar-header">
                    <div class="navbar-logo"></div>

                    <div class="application-name">
                        <h1 style="line-height:50px;">@Html.ActionLink("AuthoMail", "Index", "Home", new { area = "" }, new { @class = "text-white ", @id = "mainlink" }) <span style="font-size:15px !important;" id="ClientName"></span></h1>
                    </div>

                </div>
                <div class="collapse navbar-collapse" id="example-navbar-collapse-3">

                    <ul class="nav navbar-nav navbar-right">

                        <li>@Html.ActionLink("Home", "Index", "Home")</li>
                        @if (User.IsInRole(AM.Entities.AMRoles.Admin) || User.IsInRole(AM.Entities.AMRoles.BA))
                        {
                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Clients <span class="caret"></span></a>
                                <ul class="dropdown-menu" id="clientmenu"></ul>
                            </li>
                        }


                        <li>@Html.ActionLink("Search", "Search", "Home")</li>
                        <li>@Html.ActionLink("Request Pullback ", "PullBack", "RequestPullBack")</li>
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Reports <span class="caret"></span></a>
                            <ul class="dropdown-menu">

                                <li>@Html.ActionLink("Daily Detail Operations Report", "DailyDetailOperationsReport", "Report")</li>
                                <li>@Html.ActionLink("Errors Report", "ErrorsReport", "Report")</li>
                                <li>@Html.ActionLink("Summary Control Report", "SummaryControlReport", "Report")</li>
                                <li>@Html.ActionLink("Errors Report - SLA", "ErrorSLAReport", "Report")</li>
                                <li>@Html.ActionLink("Monthly Recon Report", "MonthlyReconReport", "Report")</li>
                                <li>@Html.ActionLink("Pullback Request Report", "PullbackRequestReport", "Report")</li>

                            </ul>
                        </li>
                        @if (User.IsInRole(AM.Entities.AMRoles.Admin) || User.IsInRole(AM.Entities.AMRoles.ClientUserManager) || User.IsInRole(AM.Entities.AMRoles.CoreLogicUserManager))
                        {
                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Manage<span class="caret"></span></a>
                                <ul class="dropdown-menu">
                                    <li>@Html.ActionLink("Sign Up Request", "SignUpRequest", "Admin")</li>
                                    @if (User.IsInRole(AM.Entities.AMRoles.Admin))
                                    {
                                        <li>@Html.ActionLink("System Settings", "SystemSettings", "Admin")</li>
                                        <li>@Html.ActionLink("Manage Domain", "ManageDomain", "Admin")</li>
                                        <li>@Html.ActionLink("Manage Business Units", "ManageBusinessUnits", "Admin")</li>
                                        <li>@Html.ActionLink("Manage Clients", "ManageClients", "Admin")</li>
                                        <li>@Html.ActionLink("Manage SFT Channel", "ManageSFTChannels", "Admin")</li>
                                        <li>@Html.ActionLink("Manage Document Type", "ManageDocumentTypes", "Admin")</li>
                                        <li>@Html.ActionLink("Assign User Manager", "AssignUserManagerDetails", "Admin")</li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole(AM.Entities.AMRoles.Admin))
                        {
                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Support<span class="caret"></span></a>
                                <ul class="dropdown-menu">
                                   
                                        <li>@Html.ActionLink("Not Reported Back Of Batch Summary", "NotReportedBackOfBatchSummary", "Support")</li>
                                        <li>@Html.ActionLink("Loan Details By SubmittedOn", "LoanDetailsBySubmittedOn", "Support")</li>
                                        <li>@Html.ActionLink("Not Reported Back Of MailBatches", "NotReportedBackOfMailBatches", "Support")</li>
                                        
                                    
                                </ul>
                            </li>
                        }
                        @Html.Partial("_LoginPartial")
                    </ul>
                    <i class="fa fa-times"></i>


                </div>
            }
        </div>
    </nav>

    <div class="container">
        @RenderBody()
        <footer>
            <div>
                2018 Copyright CoreLogic. All Rights Reserved.
            </div>
            <div>
                <ol>
                    <li><a href="http://www.corelogic.com/about-us/our-company.aspx" target="_blank">About Our Company</a></li>
                    <li><a href="http://www.corelogic.com/about-us/contact-us.aspx" target="_blank">Contact Us</a></li>
                    <li><a href="http://www.corelogic.com/privacy.aspx" target="_blank">Policies</a></li>
                </ol>
            </div>
        </footer>
    </div>
    @{
        var IsBARole = User.IsInRole(AM.Entities.AMRoles.Admin) || User.IsInRole(AM.Entities.AMRoles.BA) ? "true" : "false";
    }

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/cljs")
    @Scripts.Render("~/bundles/clselect2")
    @Scripts.Render("~/bundles/clcomponetjs")

    @RenderSection("scripts", required: false)
    <script>
        var baseUrl = '@Url.Content("~/")';
        $(document).ready(function () {
            var roleCheck = @IsBARole;
            init();
            GetClientNameById();
            if (roleCheck) {
                GetClientMenu();
            }
            jQuery.validator.addMethod("lettersonly", function(value, element) {
                return this.optional(element) || /^[A-z\s]+$/i.test(value);
            }, "Letters only please");
            jQuery.validator.addMethod("domainonly", function(value, element) {
                return this.optional(element) || /^(([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9\-]*[a-zA-Z0-9])\.)*([A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9\-]*[A-Za-z0-9])$/i.test(value);
            }, "Please enter valid domain name.");
            jQuery.validator.addMethod("password",function(value,element){
                return this.optional(element) || /^(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,20}$/i.test(value);
            },"Passwords are 8-20 characters with uppercase letters, lowercase letters and at least one number.");
            jQuery.validator.addMethod("doctypecode",function(value,element){
                //console.log(!(/^[-]+[\s]+$/i.test(value)));
                return this.optional(element) || !(/[-\s]+/i.test(value));
            },"space and dash not allow.");
            //""

        });

        function RefreshDataByClientId(obj) {
            var clientId=$(obj).data("clientid");
            if (clientId!="") {
                $.ajax({
                    type: "POST",
                    url: baseUrl + "Common/RefreshDataByClientId",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({ clientId: parseInt(clientId) }),
                    success: function (response) {
                        if (response.Success) {
                            //console.log(response.Object)
                            window.location = baseUrl + "Home/Index";
                        }
                        else {
                            //window.clui.globalAlert({
                            //    message: response.ErrorMessage,
                            //    alertType: 'red',
                            //    timeout: 5000
                            //});
                        }

                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        window.clui.globalAlert({
                            message: "@AM.Services.Config.Web_Msg_Ajax_CommonError",
                            alertType: 'red',
                            timeout: 5000
                        });
                    }

                });
            }
            else
            {
                window.clui.globalAlert({
                    message: "Select client.",
                    alertType: 'red',
                    timeout: 5000
                });
            }
        }
        function GetClientMenu() {
            $.ajax({
                type: "GET",
                url: baseUrl + "Common/GetClientMenu",
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.Success) {
                        if (response.Object != null) {
                            var data = response.Object;
                            var lihtml = "";
                            for (var i = 0; i < data.length; i++) {
                                lihtml = lihtml + '<li onclick="RefreshDataByClientId(this)" class="client" data-clientid="' + data[i].Id + '"><a href="#">' + data[i].Name + '</a></li>';
                            }
                            $("#clientmenu").empty();
                            $("#clientmenu").html(lihtml);
                        }
                    }

                },
                error: function (xhr, ajaxOptions, thrownError) {
                    window.clui.globalAlert({
                        message: "@AM.Services.Config.Web_Msg_Ajax_CommonError",
                        alertType: 'red',
                        timeout: 5000
                    });
                }

            });
        }
        function GetClientNameById() {
            $("#ClientName").text("")
            $.ajax({
                type: "GET",
                url: baseUrl + "Common/GetClientNameById",
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    $("#ClientName").text(response);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#ClientName").text("");
                }

            });
        }
        function Spinners(selector, className) {
            if ($(selector).find("i").hasClass("fa-circle-o-notch fa-spin")) {
                $(selector).find("i").removeClass("fa-circle-o-notch fa-spin");
                $(selector).find("i").addClass(className);
            }
            else {
                $(selector).find("i").removeClass(className);
                $(selector).find("i").addClass("fa-circle-o-notch fa-spin");
            }
        }
        if (!String.prototype.supplant) {
            String.prototype.supplant = function (o) {
                return this.replace(/{([^{}]*)}/g,
                    function (a, b) {
                        var lst = b.split('.');
                        $obj = o;
                        for (var i = 0; i < (lst.length) ; i++) {
                            var r = $obj[lst[i]];
                            if (r === null || typeof r === "undefined") return "--";
                            if (typeof r === 'object') {
                                $obj = r;
                            }
                            else {
                                return typeof r === 'string' || typeof r === 'number' ? r : a;
                            }
                        }
                    }
                );
            };
        }
        //if (!String.prototype.supplant) {
        //    String.prototype.supplant = function (o) {
        //        return this.replace(/{([^{}]*)}/g,
        //            function (a, b) {
        //                var r = o[b];
        //                if (r === null || typeof r === "undefined") return "--";
        //                return typeof r === 'string' || typeof r === 'number' ? r : a;
        //            }
        //        );
        //    };
        //}
        function BindTemplate(model, bodyId, bodyContentId, mainTableId, mainDivId) {

            var bodyHtml = $(bodyId).html();
            var tableHtml = "";
            $(model).each(function () {
                tableHtml = tableHtml + bodyHtml.supplant(this);
            });
            // console.log(test1);

            $(bodyContentId).html(tableHtml);
            $(mainDivId).html($(mainTableId).html());
            $(mainDivId).find("table").attr("id", "sample_2");
            applyDataTable();
        }

        function BindTemplateWithOutDatatable(model, bodyId, bodyContentId, mainTableId, mainDivId) {

            var bodyHtml = $(bodyId).html();
            var tableHtml = "";
            $(model).each(function () {
                tableHtml = tableHtml + bodyHtml.supplant(this);
            });
            // console.log(test1);

            $(bodyContentId).html(tableHtml);
            $(mainDivId).html($(mainTableId).html());
            $(mainDivId).find("table").attr("id", "sample_2");
        }
        function GetTrackingInfo(TrackingNo, ShippingMethod) {
            selector = "#" + TrackingNo;
            Spinners(selector, "faspinner");
            var el = $('#TrackingInfo').find('.modal-body');
            $.ajax({
                type: "POST",
                url: baseUrl + "Common/USPSTracking",
                data: JSON.stringify({
                    TrackingNo: TrackingNo,
                    ShippingMethod: ShippingMethod
                }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    Spinners(selector, "faspinner");
                    el.html(response);

                    $("#TrackingInfo").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    Spinners(selector, "faspinner");
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#TrackingInfo").modal("show");
                }

            });
        }
        $(document).ajaxSuccess(function (event, xhr, settings) {
            //console.log("Server Result:" + cnt++);
            //console.log(xhr.responseText);
            if (xhr.responseText == "") {
                window.location.reload();
            }
        });


        $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
            //console.log("error:" + JSON.stringify(thrownError));
            //console.log("Status:" + jqxhr.status);
            if (jqxhr.status == 200) {
                window.location.reload();
            }

        });

    </script>
</body>
</html>
