<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AuthoMail</title>
    @Styles.Render("~/Content/clcss")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <nav class="navbar navbar-default" role="navigation">
        <div class="mobile-overlay"></div>
        <div class="container-fluid">
            <div class="navbar-collapse-btn">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#example-navbar-collapse-3">
                    <span class="sr-only">Toggle navigation</span>
                    <i class="fa fa-bars" aria-hidden="true"></i>
                </button>
            </div>
            <div class="navbar-header">
                <div class="navbar-logo"></div>
                <div class="application-name">
                    @*@Html.ActionLink("AuthoMail", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })*@
                    <h1 style="line-height:50px;">AuthoMail</h1>
                </div>

            </div>
            <div class="collapse navbar-collapse" id="example-navbar-collapse-3">
                @if (User.Identity.IsAuthenticated)
                {
                    <ul class="nav navbar-nav navbar-right">
                        <li>@Html.ActionLink("Home", "Index", "Home")</li>
                        <li>@Html.ActionLink("Search", "Search", "Home")</li>
                        <li>@Html.ActionLink("Request Pullback ", "PullBack", "RequestPullBack")</li>
                        @*<li>@Html.ActionLink("Contact", "Contact", "Home")</li>*@
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Reports <span class="caret"></span></a>
                            <ul class="dropdown-menu">

                                <li>@Html.ActionLink("Daily Detail Operations Report", "DailyDetailOperationsReport", "Report")</li>
                                <li>@Html.ActionLink("Errors Report", "ErrorsReport", "Report")</li>
                                <li>@Html.ActionLink("Summary Control Report", "SummaryControlReport", "Report")</li>
                                <li>@Html.ActionLink("Errors Report - SLA", "ErrorSLAReport", "Report")</li>
                                <li>@Html.ActionLink("Month Recon Report", "MonthReconReport", "Report")</li>
                                @*<li>@Html.ActionLink("Delivery Report", "DeliveryReport", "Report")</li>*@
                                @*<li><a href="#">Another action</a></li>
                                    <li><a href="#">Something else here</a></li>
                                    <li role="separator" class="divider"></li>
                                    <li><a href="#">Separated link</a></li>*@
                            </ul>
                        </li>
                        @Html.Partial("_LoginPartial")
                    </ul>
                    <i class="fa fa-times"></i>
                }
               

            </div>
        </div>
    </nav>
    @*<div class="navbar navbar-inverse navbar-fixed-top">
            <div class="container">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    @Html.ActionLink("Application name", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
                </div>
                <div class="navbar-collapse collapse">
                    <ul class="nav navbar-nav">
                        <li>@Html.ActionLink("Home", "Index", "Home")</li>
                        <li>@Html.ActionLink("About", "About", "Home")</li>
                        <li>@Html.ActionLink("Contact", "Contact", "Home")</li>
                    </ul>
                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </div>*@
    <div class="container">
        @RenderBody()
        <footer>
            <div>
                2018 Copyright CoreLogic. All Rights Reserved.
            </div>
            <div>
                <ol>
                    <li><a href="http://www.corelogic.com/about-us/our-company.aspx" target="_blank">About Our Company</a></li>
                    <li><a href="http://www.corelogic.com/about-us/contact-us.aspx" target="_blank">Contact Us</a></li>
                    @*<li><a href="#">FAQs</a></li>
                        <li><a href="#">Sitemap</a></li>
                        <li><a href="#">Terms of Use</a></li>*@
                    <li><a href="http://www.corelogic.com/privacy.aspx" target="_blank">Policies</a></li>
                </ol>
            </div>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/cljs")
    @Scripts.Render("~/bundles/clselect2")
    @Scripts.Render("~/bundles/clcomponetjs")

    @RenderSection("scripts", required: false)
    <script>
        var baseUrl = '@Url.Content("~/")';
        $(document).ready(function () {
            init()
            JSON.useDateParser();
            console.log(baseUrl);
        });
        $(document).ajaxSuccess(function (event, xhr, settings) {
            //console.log("Server Result:" + cnt++);
            //console.log(xhr.responseText);
            if (xhr.responseText == "") {
                window.location.reload();
            }
        });


        $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
            //console.log("error:" + JSON.stringify(thrownError));
            //console.log("Status:" + jqxhr.status);
            if (jqxhr.status == 200) {
                window.location.reload();
            }

        });

    </script>
</body>
</html>
