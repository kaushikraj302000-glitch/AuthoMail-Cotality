@{
    ViewBag.Title = "PullBack";
}

<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<style>
    .show-calendar{
        width:484px !important;
    }
     
</style>
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#metaItem1">
                <div class="panel-title">
                    Request Pull Back
                    <div class="collapsed-icon pull-right">
                        <i class="fa fa-caret-left"></i>
                    </div>
                    <div class="expanded-icon pull-right">
                        <i class="fa fa-caret-down"></i>
                    </div>
                </div>
            </a>

        </div>
        <div id="metaItem1" class="panel-collapse collapse in">
            <div class="panel-body">
                <div class="col-md-7">
                    <div class="form-group col-md-6">
                        @if (ViewBag.BusinessId.Count == 1)
                        {
                            <label for="BusinessFriendlyIdValue">@ViewBag.BusinessId[0]</label>
                            <div class="input-group">
                                <i class="fa fa-search left-icon"></i>
                                <input class="form-control" name="BusinessFriendlyIdValue" value="@ViewBag.BusinessFriendlyIdValue" placeholder="@ViewBag.BusinessId[0]" required id="BusinessFriendlyIdValue">
                                <input type="hidden" value="@ViewBag.BusinessId[0]"  name="BusinessFriendlyIdName" id="BusinessFriendlyIdName" />
                            </div>
                            <div class="text-red pull-left" style="display:none" id="BusinessFriendlyIdValueError">This field is required.</div>
                        }
                        else if (ViewBag.BusinessId.Count > 1)
                        {
                            <label for="BusinessFriendlyIdName">Select Business ID</label>
                            <div class="input-group">

                                <select id="BusinessFriendlyIdName" class="selectpicker">
                                    <option value="">Select BusinessId</option>
                                    @foreach (var item in ViewBag.BusinessId)
                                    {
                                        <option value="@item.ToString()">@item.ToString()</option>
                                    }
                                </select>
                                <input class="form-control" name="BusinessFriendlyIdValue" placeholder="" required id="BusinessFriendlyIdValue">

                            </div>
                        }
                        else
                        {
                            <br />
                            <div class='alert alert-yellow'><div>No business friendly id found!</div></div>
                        }
                    </div>
                    <div class="form-group col-md-6">
                        <label for="input1">Document Type</label>
                        @Html.DropDownList("DocType", ViewBag.DocType as SelectList, "Select DocType", htmlAttributes: new { @class = "selectpicker" })
                        @*<select class="selectpicker" id="docType">
                                <option>Basic User</option>
                                <option>Admin</option>
                                <option>Super Admin</option>
                            </select>*@
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="dp4">Received  On </label>
                        <div class="input-group daterange" id="datepicker4">
                            <input type="text" class="form-control" id="dp4">
                            <span class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </span>
                        </div>
                    </div>

                </div>
                <div class="col-md-1">
                    <div class="form-group ">
                        <label for="filterData">&nbsp;&nbsp;&nbsp;&nbsp;</label>
                        <button type="button" id="filterData" class="btn btn-primary" style=" padding-top: 6%;">
                            <span class="sr-only">Filter</span>
                            <i class="fa fa-arrow-right fa-2x"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="panel panel-default" id="mailPieceList">

</div>

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Pullback Response</h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
                @*<button type="button" class="btn btn-primary">View All</button>*@
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h2 id="myModalLabel"> @AM.Services.Config.Msg_Web_PullBackConfirmation</h2>
                <hr />
                <button type="button" class="btn btn-default" id="yesPullback"><i class="fa fa-check"></i> Yes</button>
                <button type="button" class="btn btn-primary" data-dismiss="modal"><i class="fa fa-close"></i> No</button>
            </div>
            @*<div class="modal-body">
                Are you sure you want do pullback?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" id="yesPullback">Yes</button>
            </div>*@
        </div>
    </div>
</div>
@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")

    <script type="text/javascript">
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            FilterData();
        });
        function FilterData() {

            var loanNumber = $("#loanNumber").val();
            var docType = $("#DocType").val();

            var selectedData = $("#dp4").val().split('-');

            var startDate = moment(selectedData[0].trim()).format("MM/DD/YYYY");
            var endDate = moment(selectedData[1].trim()).format("MM/DD/YYYY");
            var el = $('#mailPieceList');
            el.html("<div class='alert alert-blue text-center'><span> Loading... </span></div>");
            $.ajax({
                type: "POST",
                url: baseUrl + "RequestPullBack/_GetMailPieceList",
                data: JSON.stringify({ BusinessFriendlyIdName: $("#BusinessFriendlyIdName").val(), BusinessFriendlyIdValue: $("#BusinessFriendlyIdValue").val(), docType: docType, startDate: startDate, endDate: endDate }),
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    el.html(res);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = '@AM.Services.Config.Msg_Web_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");
                }

            });
        }
        $("#filterData").click(function () {
            FilterData();
        });
    </script>
}
