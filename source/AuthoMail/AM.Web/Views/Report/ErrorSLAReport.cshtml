@{
    ViewBag.Title = "ErrorsSLAReport";
}

<style>
    #dateFilter .bootstrap-select, #DocTypeSize .bootstrap-select {
        width: 100% !important;
    }
</style>
<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#metaItem1">
                <div class="panel-title">
                    Error Report - SLA
                    <div class="collapsed-icon pull-right">
                        <i class="fa fa-caret-left"></i>
                    </div>
                    <div class="expanded-icon pull-right">
                        <i class="fa fa-caret-down"></i>
                    </div>
                </div>
            </a>
        </div>
        <div id="metaItem1" class="panel-collapse collapse in">
            <div class="panel-body">
                <div class="col-md-3" id="dateFilter">
                    <div class="form-group">
                        <label for="Status">Select Date Type</label>
                        <select class="selectpicker" id="filterBy">
                            <option value="ByDueDate">By Due Date</option>
                            <option value="ByReceivedOn">By Received Date</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3" >
                    <div class="form-group">
                        <label for="dp4" id="ByDate">Due Date(EST)</label>
                        <div class="input-group date" id="datepicker4">
                            <input type="text" class="form-control" id="dp4">
                            <span class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </span>
                        </div>
                    </div>

                </div>
                <div class="col-md-3" id="DocTypeSize">
                    <div class="form-group">
                        <label for="DocType">Document Type</label>
                        @Html.DropDownList("DocType", ViewBag.DocType as SelectList, "Select DocType", htmlAttributes: new { @class = "selectpicker" })
                    </div>

                </div>
                <div class="col-md-1">
                    <div class="form-group ">
                        <label for="input1"></label>
                        <button type="button" id="filterData" class="btn btn-primary" style=" padding-top: 6%;">
                            <span class="sr-only">Filter</span>
                            <i class="fa fa-arrow-right fa-2x"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>
<div class="panel panel-default" id="errorBatchList"></div>


@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script>
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            FilterData();
        });
        $("#filterBy").change(function () {
            if ($(this).val() == "ByReceivedOn") {
                $("#ByDate").text("Received Date");
            } else if ($(this).val() == "ByDueDate") {
                $("#ByDate").text("Due Date");
            } else {
                $("#ByDate").text("Select Date");
            }
        });
        function FilterData() {
            var el = $('#errorBatchList');
            el.html("<div class='alert alert-blue text-center'><span> Loading... </span></div>");
            $.ajax({
                type: "POST",
                url: baseUrl + "Report/_GetErrorsSLAReport",
                data: JSON.stringify({ date: $("#dp4").val(), filterBy: $("#filterBy").val(), docType: $("#DocType").val() }),
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    el.html(res);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = '@AM.Services.Config.Msg_Web_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                }

            });
        }
        $("#filterData").click(function () {
            FilterData();
        });
    </script>
}
