
@{
    ViewBag.Title = "ErrorsSLAReport";
}


<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#metaItem1">
                <div class="panel-title">
                    <i class="fa fa-filter"></i> Filter for Error SLA Report
                    <div class="collapsed-icon pull-right">
                        <i class="fa fa-caret-left"></i>
                    </div>
                    <div class="expanded-icon pull-right">
                        <i class="fa fa-caret-down"></i>
                    </div>
                </div>
            </a>
        </div>
        <div id="metaItem1" class="panel-collapse collapse in">
            <div class="panel-body">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="dp4">Select Date</label>
                        <div class="input-group date" id="datepicker4">
                            <input type="text" class="form-control" id="dp4">
                            <span class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </span>
                        </div>
                    </div>

                </div>

                <div class="col-md-1">
                    <div class="form-group ">
                        <label for="input1"></label>
                        <button type="button" id="filterData" class="btn btn-primary">
                            <span class="sr-only">Filter</span>
                            <i class="fa fa-filter fa-2x"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-5" id="showBatch" style="display:none">
                    <div class="form-group">
                        <label for="input1">Select Batch</label>
                        <div id="batchselection"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<div class="panel panel-default" id="errorBatchList"></div>


@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script>
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            FilterData();
        });
        function FilterData() {
            var selectedData = new Date($("#dp4").val());
            var el = $('#errorBatchList');
            el.html("<div class='alert alert-blue text-center'><span> Loading... </span></div>");
            $.ajax({
                type: "POST",
                url: baseUrl + "Report/_GetErrorsSLAReport",
                data: JSON.stringify({ date: selectedData }),
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    el.html(res);

                    $("#showBatch").show();
                    $("#batchselection").html(el.find("#hideSelection").html());
                    $('#BatchList').addClass("selectpicker");
                    $('.selectpicker').selectpicker('refresh');

                    $("#hideSelection").html("");
                    $('.selectpicker').on('change', function () {
                        var selected = $(this).find("option:selected").val();
                        var oTable = $('#sample_2').dataTable();
                        oTable.fnFilter("^" + parseInt(selected) + "$", 10, true); //Exact value, column, reg
                    });
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                }

            });
        }
        $("#filterData").click(function () {
            FilterData();
        });
    </script>
}
