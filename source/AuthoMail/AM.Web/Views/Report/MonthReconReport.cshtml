@{
    ViewBag.Title = "MonthReconReport";
}

<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<script src="~/clui/dist/js/vendor/moment.js"></script>
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#metaItem1">
                <div class="panel-title">
                    <i class="fa fa-filter"></i> Filter for Month Recon Report
                    <div class="collapsed-icon pull-right">
                        <i class="fa fa-caret-left"></i>
                    </div>
                    <div class="expanded-icon pull-right">
                        <i class="fa fa-caret-down"></i>
                    </div>
                </div>
            </a>
        </div>
        <div id="metaItem1" class="panel-collapse collapse in">
            <div class="panel-body">

                <div class="col-md-3">
                    <div class="form-group">
                        <label for="dp4">Select Date (In EST)</label>
                        <select class="selectpicker" id="dates"></select>
                    </div>

                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="Channel">Channel</label>
                        <select class="selectpicker" id="Channel">
                            <option value="">Select Channel</option>
                            <option value="Mortgage Cadence Integration">Mortgage Cadence Integration</option>
                            <option value="CoreLogic SFTP">CoreLogic SFTP</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-group ">
                        <label for="input1"></label>
                        <button type="button" id="filterData" class="btn btn-primary">
                            <span class="sr-only">Filter</span>
                            <i class="fa fa-filter fa-2x"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<div class="panel panel-default" id="batchList"></div>

@*@Html.Partial("_BatchList")*@

@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script>
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            getLastMonths(6)

            FilterData();
            //console.log(getLastMonths(6));
        });
        function BindDateDropdown() {
            $("#dateselection").html();
        }
        function FilterData() {
            //console.log(baseUrl + "Report/_MonthReconReport");
            var loanNumber = $("#loanNumber").val();
            var docType = $("#DocType").val();

            var selectedData = $("#dates").val().split('|');
           // console.log(selectedData);
            var startDate = selectedData[0].trim();
            var endDate = selectedData[1].trim();
            var el = $('#batchList');
            el.html("<div class='alert alert-blue text-center'><span> Loading... </span></div>");
            $.ajax({
                type: "POST",
                url: baseUrl + "Report/_MonthReconReport",
                data: JSON.stringify({ loanNumber: loanNumber, docType: docType, startDate: startDate, endDate: endDate, channel: $("#Channel").val() }),
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    el.html(res);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = '@AM.Services.Config.Msg_Web_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                }

            });
        }
        $("#filterData").click(function () {
            FilterData();
        });
        function getLastMonths(n) {
            var m = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

            var last_n_months = [];
            var d = new Date();
            var d1 = new Date();
            var last_mm_dd = [];
            d1.setMonth(d.getMonth() - 1);
            var option = "<option value=''>Select Date</option>"
            for (var i = 0; i < n; i++) {
                var key = "26-" + m[d1.getMonth()] + '-' + d1.getFullYear().toString() + " To " + "25-" + m[d.getMonth()] + '-' + d.getFullYear().toString();
                var value = parseInt(d1.getMonth() + 1) + "/26/" + d1.getFullYear().toString() + "|" + parseInt(d.getMonth() + 1) + "/25/" + d.getFullYear().toString();
                if (i == 0) {

                    option += "<option selected='selected' value='" + value + "'>" + key + "</option>"
                }
                else {
                    option += "<option value='" + value + "'>" + key + "</option>"
                }
                d.setMonth(d.getMonth() - 1);
                d1.setMonth(d.getMonth() - 1);
            }
            $("#dates").html(option);
            //console.log(option);
            //return last_n_months
        }

    </script>
}
