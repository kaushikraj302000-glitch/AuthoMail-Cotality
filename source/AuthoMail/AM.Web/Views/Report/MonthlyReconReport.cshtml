@{
    ViewBag.Title = "MonthlyReconReport";
}

<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<script src="~/clui/dist/js/vendor/moment.js"></script>
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#metaItem1">
                <div class="panel-title">
                    Monthly Recon Report
                    <div class="collapsed-icon pull-right">
                        <i class="fa fa-caret-left"></i>
                    </div>
                    <div class="expanded-icon pull-right">
                        <i class="fa fa-caret-down"></i>
                    </div>
                </div>
            </a>
        </div>
        <div id="metaItem1" class="panel-collapse collapse in">
            <div class="panel-body">

                <div class="col-md-3">
                    <div class="form-group">
                        <label for="dp4">Select Date (EST)</label>
                        @*<select class="selectpicker" id="dates"></select>*@
                        <select class="selectpicker" id="dates">
                            @foreach (var item in ViewBag.dateList as List<string>)
                            {
                                <option value="@item">@item</option>
                            }
                        </select>
                    </div>

                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="Channel">Channel</label>
                        @Html.Action("_Channel", "Common")
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-group ">
                        <label for="input1"></label>
                        <button type="button" id="filterData" class="btn btn-primary" style=" padding-top: 6%;">
                            <span class="sr-only">Filter</span>
                            <i class="fa fa-arrow-right fa-2x"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<div class="panel panel-default" >
    <div class='alert alert-blue text-center' id="loading" style="display:none"><span> Loading... </span></div>
    <div class="panel-heading" id="monthlyHeader">
        <div class="panel-title">
            Monthly Recon Details: <span class="normaltext" id="headerdate"></span>
        </div>
    </div>
        <div class="panel-body" id="monthlyList">
    </div>
</div>
<!-- table html template code -->
<div id="monthlyTableContent" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                <th>Loan Number</th>
                <th>File Name</th>
                <th>Document Type</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Recipient Street Address</th>
                <th>Recipient City</th>
                <th>Recipient State</th>
                <th>Recipient Zip</th>
                <th>Received Date <span class="fontcapitalize">(Local)</span></th>
                <th>Printed Date <span class="fontcapitalize">(Local)</span></th>
                <th>Mailed Date <span class="fontcapitalize">(Local)</span></th>
                <th>Pages Shipped</th>
                <th>Shipping Method</th>
                <th>Tracking Number</th>
                <th>Shipping Status</th>
            </tr>
        </thead>
        <tbody id="monthlybodyContent"></tbody>
    </table>
</div>
<div style="display:none">
    <table>
        <tbody id="monthlyBody">
            <tr class="row-small">
                <td><span>{BusinessFriendlyIdValue}</span></td>
                <td><span>{FileName}</span></td>
                <td><span>{DocumentOrPackageType}</span></td>
                <td><span>{RcptFirstName}</span></td>
                <td><span>{RcptLastName}</span></td>
                <td><span>{RcptAddressStreet}</span></td>
                <td><span>{RcptAddressCity}</span></td>
                <td><span>{RcptAddressState}</span></td>
                <td><span>{RcptAddressZIP}</span></td>
                <td><span>{ReceivedOnFormatted}</span></td>
                <td><span>{PrintedOnFormatted}</span></td>
                <td><span>{MailedOnFormatted}</span></td>
                <td><span>{PagesShipped}</span></td>
                <td><span>{ShippingMethod}</span></td>
                <td><span>{TrackingNo}</span></td>
                <td><span>{ShippingStatus}</span></td>
            </tr>
        </tbody>
    </table>
</div>
<!-- end table template code -->

@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script>
    $(document).ready(function () {
        window.clui.dateTimePickerInit();
        FilterData();
    });
    function applyDataTable() {

        var table = $('#sample_2');
        var filename = "MonthlyReconReport";
        var title = "Monthly Recon Report";
        var oTable = table.dataTable({

            "language": {
                "aria": {
                    "sortAscending": ": activate to sort column ascending",
                    "sortDescending": ": activate to sort column descending"
                },
                "emptyTable": "No data available in table",
                "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                "infoEmpty": "No entries found",
                "infoFiltered": "(filtered1 from _MAX_ total entries)",
                "lengthMenu": "_MENU_ entries",
                "search": "<b>Search:</b>",
                "zeroRecords": "No matching records found"
            },

            "scrollX": true,
            buttons: [
                //{
                //    extend: 'colvis',
                //    text: 'Select Fields',
                //    className: 'btn purple pull-left',
                //    columns: ':not(.noVis)'
                //},
            {
                extend: 'excel',
                text: '<i class="fa fa-file-excel-o fa-2x"></i>',
                className: 'btn btn-primary',
                filename: filename,
                title: title,
                //exportOptions: {
                //    columns: [0, 1, 2, 3, 4, 5, 6, 7]
                //}

            },




            ],

            "order": [
                [0, 'asc']
            ],
            "lengthMenu": [
                [5, 10, 25, 50, 100, -1],
                [5, 10, 25, 50, 100, "All"] // change per page values here
            ],
            // set the initial value
            "pageLength": 5,

            "dom": "<'row' <'col-md-12'B>><'row'<'col-md-6 col-sm-12'l><'col-md-6 col-sm-12'f>r><'table-scrollable't><'row'<'col-md-5 col-sm-12'i><'col-md-7 col-sm-12'p>>", // horizobtal scrollable datatable


        });

    }
    function FormatObject(Model) {
        $(Model).each(function () {
            this.ReceivedOnFormatted = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
            this.PrintedOnFormatted = moment(this.PrintedOn).format("MM/DD/YY HH:mm:ss");
            this.MailedOnFormatted = moment(this.MailedOn).format("MM/DD/YY HH:mm:ss");
        });
        return Model;
    }
    function FilterData() {
        $("#monthlyHeader").hide();
        $("#monthlyList").hide();
        $("#loading").show();
        //console.log(baseUrl + "Report/_MonthReconReport");
        var loanNumber = $("#loanNumber").val();
        var docType = $("#DocType").val();

        var selectedData = $("#dates").val().split('-');
        // console.log(selectedData);
        var startDate = moment(selectedData[0].trim()).format("MM/DD/YY");
        var endDate = moment(selectedData[1].trim()).format("MM/DD/YY");
        var el = $('#monthlyList');
        $("#headerdate").html(startDate + " to " + endDate + " EST");
        $.ajax({
            type: "POST",
            url: baseUrl + "Report/_MonthReconReport",
            data: JSON.stringify({ loanNumber: loanNumber, docType: docType, startDate: startDate, endDate: endDate, channel: $("#Channel").val() }),
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                console.log(response);
                if (response.Success) {
                    if (response.Object != null) {
                        $("#loading").hide();
                        $("#monthlyHeader").show();
                        $("#monthlyList").show();
                        if (response.Object.model.length > 0) {
                            var data = FormatObject(response.Object.model);
                            BindTemplate(data, "#monthlyBody", "#monthlybodyContent", "#monthlyTableContent", "#monthlyList");
                        }
                        else {
                            $("#monthlyList").html(" <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Msg_Web_NoRecordFound</span></div>")
                        }
                    }
                } else {
                    $("#loading").hide();
                    $("#monthlyHeader").show();
                    $("#monthlyList").show();
                    $("#monthlyList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                }


            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("#loading").hide();
                $("#monthlyHeader").show();
                $("#monthlyList").show();

                var msg = '@AM.Services.Config.Msg_Web_Ajax_CommonError';
                $("#monthlyList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
            }

        });
    }
    $("#filterData").click(function () {
        FilterData();
    });
   
    </script>
}
