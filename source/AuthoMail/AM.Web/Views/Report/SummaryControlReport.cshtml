@{
    ViewBag.Title = "Summary Control Report";
}
<style>
    #dateFilter .bootstrap-select {
        width: 100% !important;
    }
</style>
<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#metaItem1">
                <div class="panel-title">
                    Summary Control Report
                    <div class="collapsed-icon pull-right">
                        <i class="fa fa-caret-left"></i>
                    </div>
                    <div class="expanded-icon pull-right">
                        <i class="fa fa-caret-down"></i>
                    </div>
                </div>
            </a>
        </div>
        <div id="metaItem1" class="panel-collapse collapse in">
            <div class="panel-body">

                <div class="col-md-3">
                    <div class="form-group">
                        <label for="dp4">Select Date @*(In your local timezone)*@</label>
                        <div class="input-group date" id="datepicker4">
                            <input type="text" class="form-control" id="dp4">
                            <span class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </span>
                        </div>
                    </div>

                </div>
                <div class="col-md-3" id="dateFilter">
                    <div class="form-group">
                        <label for="Channel">Channel</label>
                        @Html.Action("_Channel", "Common")
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-group ">
                        <label for="input1"></label>
                        <button type="button" id="filterData" class="btn btn-primary" style=" padding-top: 6%;">
                            <span class="sr-only">Filter</span>
                            <i class="fa fa-arrow-right fa-2x"></i>
                        </button>
                    </div>
                </div>
                @*<div class="col-md-3" id="showBatch" style="display:none">
                    <div class="form-group">
                        <label for="input1">Select Batch</label>
                        <div id="batchselection"></div>
                    </div>
                </div>*@
            </div>
        </div>
    </div>

</div>
<div class="panel panel-default" id="batchList"></div>

@*@Html.Partial("_BatchList")*@

@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script>
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            FilterData();
        });
        function FilterData() {
            var el = $('#batchList');
            var startDate = moment($("#dp4").val() + ' @AM.Services.Config.StartCutOffTime').subtract('days', 1).format("MM/DD/YYYY HH:mm:ss ");
            var endDate = moment($("#dp4").val() + ' @AM.Services.Config.EndCutOffTime').format("MM/DD/YYYY HH:mm:ss ");
            el.html("<div class='alert alert-blue text-center'><span> Loading... </span></div>");
            $.ajax({
                type: "POST",
                url: baseUrl + "Report/_GetSummaryControlReport",
                data: JSON.stringify({ startDate: startDate, endDate: endDate, channel: $("#Channel").val() }),
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    el.html(res);
                    //$("#batchselection").html(el.find("#hideSelection").html());
                    //$('#BatchList').addClass("selectpicker");
                    //$('.selectpicker').selectpicker('refresh');
                    //if ($('select#BatchList option').length > 2) {
                    //    $("#showBatch").show();
                    //}
                    //$("#hideSelection").html("");
                   
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = '@AM.Services.Config.Msg_Web_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                }

            });
        }
        $("#filterData").click(function () {
            FilterData();
        });
    </script>
}

