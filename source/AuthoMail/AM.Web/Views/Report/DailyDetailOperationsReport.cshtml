@{
    ViewBag.Title = "DailyDetailOperationsReport";
}
<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#metaItem1">
                <div class="panel-title">
                    Daily Detail Operations Report
                    <div class="collapsed-icon pull-right">
                        <i class="fa fa-caret-left"></i>
                    </div>
                    <div class="expanded-icon pull-right">
                        <i class="fa fa-caret-down"></i>
                    </div>
                </div>
            </a>
        </div>
        <div id="metaItem1" class="panel-collapse collapse in">
            <div class="panel-body">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="dp4">Select Date @*(In your local timezone)*@</label>
                        <div class="input-group date" id="datepicker4">
                            <input type="text" class="form-control" id="dp4">
                            <span class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </span>
                        </div>
                    </div>

                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="Channel">Channel</label>
                        @Html.Action("_Channel", "Common")
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-group ">
                        <label for="filterData"> &nbsp;&nbsp;&nbsp;&nbsp;</label>
                        <button type="button" id="filterData" class="btn btn-primary">
                            <span class="sr-only">Filter</span>
                            <i class="fa fa-filter fa-2x"></i>
                        </button>
                    </div>
                </div>
                
            </div>
        </div>
    </div>

</div>
<div class="modal fade" id="TrackingInfo" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg col-md-10" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Tracking Details</h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">View All</button>*@
            </div>
        </div>
    </div>
</div>
<div class="panel panel-default" id="dailybatchList"></div>

@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script>
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            console.log(baseUrl);
            FilterData();

        });
        function FilterData() {
            var selectedData = new Date($("#dp4").val());
            var el = $('#dailybatchList');
            el.html("<div class='alert alert-blue text-center'><span> Loading... </span></div>");
            $.ajax({
                type: "POST",
                url: baseUrl + "Report/_GetDailyDetailOperationsReport",
                data: JSON.stringify({ date: $("#dp4").val(), channel: $("#Channel").val() }),
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    el.html(res);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = '@AM.Services.Config.Msg_Web_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                }

            });
        }
        $("#filterData").click(function () {
            FilterData();
        });

    </script>
}




