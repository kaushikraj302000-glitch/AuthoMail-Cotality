@{
    ViewBag.Title = "Email confirmed";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div style="margin-top:2%">

</div>
@if (ViewBag.Success)
{
    <div id="Message"></div>
    <div class="panel panel-primary">
        <div class="panel-heading">
            Please select the Appcode(s) then after your Email will be confirm.
        </div>
        <div class="panel-body">
            <div class="form-group">
                <label class="control-label">AppCode</label>
                <select class="form-control selectpicker" multiple id="appcode">
                    <option value="">Select AppCode</option>
                    @foreach (var appcode in ViewBag.clientDomains as List<AM.Services.ClientIdNameVM>)
                    {
                        <option value="@(appcode.Id)">@appcode.NameAppCode</option>
                    }
                </select>
            </div>
        </div>
        <div class="panel-footer text-right">
            <button type="button" id="confirmemail" class="btn btn-success">Confirm Email</button>
        </div>
    </div>
    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
        <script type="text/javascript">
            $(document).ready(function () {
                $('.selectpicker').selectpicker('refresh');
                var userId = '@(ViewBag.userId)';
                $('#confirmemail').click(function (e) {
                    e.preventDefault();
                    var clientIds = $('#appcode').val();
                    if (clientIds == null || clientIds == '') {
                        toastr.error("Please select AppCode.");
                        return false;
                    }
                    $.ajax({
                        type: "POST",
                        url: baseUrl + "Account/ClientSelection",
                        data: { userId: userId, clientIds: clientIds },
                        dataType: "json",
                        success: function (response) {
                            if (response.Success) {
                                $('.panel-body').html('<div class="alert alert-success text-center">' + response.Object + '</div>');
                            } else {
                                toastr.error(response.ErrorMessage);
                            }
                        }
                    });
                });
            });
        </script>
    }
}
else
{

    <div class="alert alert-red text-center">
        <div>@Html.Raw(ViewBag.Message)</div>
    </div>

}