@model AM.Web.Models.RegisterViewModel
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_LayoutRegister.cshtml";
}

<section class="cl-row">
    <div class="cl-columns">
        <div class="inner-block">
            <div class="cl-row">
                <div class="center-block cl-columns">
                    <h1 class="app-logo text-center">AuthoMail </h1>
                    
                    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "cl-form-login", role = "form" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="login-email">Email</label>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control",@type="email" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                <label>Password</label>
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                <label>Confirm Password</label>
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                           
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="login-email">First Name</label>
                                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                <label for="login-email">Last Name</label>
                                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                <label for="login-email">Display Name</label>
                                @Html.TextBoxFor(m => m.DisplayName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.DisplayName, "", new { @class = "text-danger" })
                            </div>
                            


                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <input type="submit" style="width:50%;float:left;" value="Register" class="btn btn-primary  btn-lg btn-block">
                                @Html.ActionLink("Login", "Login", "Account", routeValues: null, htmlAttributes: new { id = "registerLink", @class = "btn btn-default btn-block btn-lg", @style = "width:50%;float:right;margin-top:0px;" })
                            </div>
                            <div class="cl-row hide-mobile">
                                <div class="center-block cl-columns text-left">
                                    <p>&nbsp;Need help? Call our toll-free number at <strong><span>(866)781-8321</span></strong> or send
                                        us an <a href="mailto:documentservices@corelogic.com?subject=AuthoMail.com Inquiry">email</a>
                                    </p>
                                </div>

                            </div>
                        </div>
                    }

                </div>
            </div>


        </div>
        @*<div class="cl-learnmore">
                <span> <b>Customer?</b></span>
                @Html.ActionLink("Login", "Login", "Account", routeValues: null, htmlAttributes: new { id = "registerLink", @class = "btn btn-default" })
            </div>*@
    </div>
</section>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">

        $("#Email").on("blur", function () {
            var count = ($(this).val().match(/@@/g) || []).length;
            var isCoreLoginEmail = $(this).val().substring($(this).val().lastIndexOf("@@") + 1);
            console.log(isCoreLoginEmail);
            if (count == 1) {
                if (isCoreLoginEmail == "corelogic.com") {
                    $("#FirstName").attr("disabled", true);
                    $("#LastName").attr("disabled", true);
                    $("#DisplayName").attr("disabled", true);
                }
                else {
                    $("#FirstName").removeAttr("disabled");
                    $("#LastName").removeAttr("disabled");
                    $("#DisplayName").removeAttr("disabled");
                }

            }
            console.log(count);
        });
    </script>
}
