
@{
    ViewBag.Title = "Delfus Template Summary";
}
<style>
    .label {
        font-size: 14px !important;
    }
    /*table.dataTable.compact thead th, table.dataTable.compact thead td {
        padding: 4px 17px 4px 18px !important;
    }
    table.dataTable thead .sorting, table.dataTable thead .sorting_asc, table.dataTable thead .sorting_desc, table.dataTable thead .sorting_asc_disabled, table.dataTable thead .sorting_desc_disabled {
        background-position: center left !important;
    }*/
    .prewrap {
        white-space: pre-wrap;
    }
    table.dataTable thead .sorting_asc {
        background: url(../Content/datatables/images/sort_asc.png) no-repeat center right !important;
    }

    table.dataTable thead .sorting_desc {
        background: url(../Content/datatables/images/sort_desc.png) no-repeat center right !important;
    }

    table.dataTable thead .sorting {
        background: url(../Content/datatables/images/sort_both.png) no-repeat center right !important;
    }

    th {
        /*border-top: 1px solid #aaa !important;
        border-bottom: 1px solid #aaa !important;*/
        border-right: 1px solid #aaa !important;
    }
    .table thead th {
        font-size: 15px !important;
    }

        th:first-child {
            border-left: 1px solid #aaa !important;
        }
</style>
<div class="panel panel-default">
    <div class="panel-heading">
        <div class="panel-title">
            <h3>
                DELFUS Template Upload Summary -
                @if (AM.Services.Config.Common_Environment == AM.Services.Env.Prod)
                {
                    <b class="text-danger">
                        PRODUCTION
                    </b>
                }
                else
                {
                    <b>
                        UAT
                    </b>
                }
                </h3>
        </div>
    </div>
    <div class="panel-body">
        <div id="templatestablebody">

        </div>
    </div>
</div>

<div id="templatebody" style="display:none;">

    <table class="table table-striped compact">
        <thead>
            <tr>
                <th class="dt-head-left" style="width:190px">Name</th>
                <th class="dt-head-left" style="width:175px">Modified On</th>
                <th class="dt-head-left" style="width:130px">Status</th>
                <th class="dt-head-left" style="width:360px">Reason</th>
            </tr>
        </thead>
    </table>
</div>
@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")

    <script type="text/javascript">
        $(document).ready(function () {
            function TemplateList() {
                var id = 'templatelisttable';
                if ($.fn.DataTable.isDataTable('#' + id)) {
                    $('#' + id).remove();
                    $('#' + id + '_wrapper').remove();
                    $('#templatestablebody').empty();
                }
                var tableBody = $('#templatebody').html();
                tableBody = $(tableBody).attr('id', id);
                $('#templatestablebody').html(tableBody);
                var table = $('#templatelisttable').DataTable({
                    "language": {
                        "emptyTable": "No rows to display."
                    },
                    "ajax": {
                        "url": baseUrl + "DelfusTemplate/DelfusTemplatesSummary",
                        "type": "GET"
                    },
                    dom:'lifrtp',
                    destroy: true,
                    order: [[1, "desc"]],
                    paging: false,
                    "columns": [

                        { "data": "FilePath", "className": 'dt-body-left' },
                        //{ "data": "FileSize", "className": 'dt-body-left' },
                        {
                            "data": "ModifiedOn",
                            "className": 'dt-body-left',
                            "render": function (data, type, row, meta) {
                                return moment(data).format("MM/DD/YY HH:mm:ss");
                            }
                        },
                        {
                            "data": "Status",
                            "className": 'dt-body-left',
                            "render": function (data) {
                                if (data == "Modified") {
                                    return '<span class="label label-success fa-2x"> ' + data + ' </span>';
                                }
                                else if (data == "Deleted" || data == "Invalid") {
                                    return '<span class="label label-danger"> ' + data + ' </span>';
                                }
                                else if (data == "Added") {
                                    return '<span class="label label-info"> ' + data + ' </span>';
                                }
                                else {
                                    return '--';
                                }
                            }
                        },
                        {
                            "data": "Reason", "className": 'dt-body-left prewrap',
                            "render": function (data, type, row, meta) {
                                return data=="" || data==null ?"--":data;
                            } },
                        //{
                        //    "data": "FileName",
                        //    "className": 'dt-body-left',
                        //    "render": function (data, type, row, meta) {
                        //        if (row.Status == true) {
                        //            var buttons = '<button title="Download Template" type="button" class="btn btn-success btn-sm downloadtemplate" data-id="' + data + '"><i class="fa fa-download"></i></button>';
                        //            buttons += ' <button type="button" title="History Of Template" class="btn btn-info btn-sm historytemplate" data-id="' + data + '"><i class="fa fa-history"></i></button>';
                        //            buttons += ' <button type="button" title="Delete Template" class="btn btn-danger btn-sm removetemplate" data-id="' + data + '"><i class="fa fa-trash"></i></button>';


                        //            return buttons;
                        //        } else {
                        //            return '--';
                        //        }

                        //    }
                        //},
                    ]
                });

            }

            TemplateList();
        });
    </script>
}


