@model ICollection<AM.Services.PullBackInfo>
<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<style>
     .popover-content {
        word-wrap: break-word;
        color: red;
    }
</style>
@if (Model.Count > 0)
{
    var cnt = 1;
    <table class="table table-responsive" id="sample_2">
        <thead>
            <tr>
                <th>#</th>
                <th>Loan Number</th>
                <th>File Name</th>
                <th>Recipient Name</th>
                <th>Recipient Address</th>
                <th>Document Type</th>
                <th>Pages Shipped</th>
                <th>Tracking Number</th>
                <th>Shipping Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="row-small">
                    
                    <td><span>@cnt</span></td>
                    <td><span>@item.BusinessFriendlyIdValue</span></td>
                    <td><span>@item.FileName</span></td>
                    <td><span>@item.RecipientName </span></td>
                    <td><span>@item.RCPTAddress</span></td>
                    <td><span>@item.DocumentOrPackageType</span></td>
                    <td><span>@item.TotalPages</span></td>
                    <td><span>@item.TrackingNo</span></td>
                    <td>
                        @switch (item.ShippingStatus)
                        {

                            case "PulledBack":
                                <span class="label medium label-yellow">@item.ShippingStatus</span>
                                break;
                            case "Error":
                            <span class="label medium label-red" data-trigger="hover" data-toggle="popover" data-original-title="Error" data-content="@item.ErrorDesc" data-placement="left">@item.ShippingStatus</span>
                                break;
                            case "Shipped":
                            <span class="label medium label-success">@item.ShippingStatus</span>
                                break;
                            case "InProgress":
                            <span class="label medium label-blue">@item.ShippingStatus</span>
                                break;

                        }

                    </td>
                </tr>

                        cnt++;
            }
        </tbody>

    </table>
}
else
{
    <div class="alert alert-yellow">
        <span class="sbold">@AM.Services.Config.Msg_Web_NoRecordFound</span>
    </div>
}
<script>
    $(document).ready(function () {
        $('[data-toggle="popover"]').popover({
            'trigger': 'hover',
            'placement': 'left',
            'container': 'body'
        });
    });
</script>