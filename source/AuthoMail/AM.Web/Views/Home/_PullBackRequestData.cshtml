@model ICollection<AM.Services.PullBackInfo>
@if (Model.Count > 0)
{
    var cnt = 1;
    <table class="table table-responsive" id="sample_2">
        <thead>
            <tr>
                <th>
                    <input type="checkbox" id="selectall" class="cl-check" />
                    <label for="selectall"></label>
                </th>
                <th>#</th>
                <th>Loan Number</th>
                <th>File Name</th>
                @*<th>Package Name</th>*@
                <th>Recipient Name</th>
                <th>Recipient Address</th>
                <th>Retrun Address</th>
                <th>Pages Shipped</th>
                @*<th>Shipping Method</th>*@
                <th>Tracking Number</th>
                <th>Shipping Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="row-small">
                    <td>
                        @switch (item.ShippingStatus)
                        {
                            case "PulledBack":
                            case "Error":
                            case "Shipped":
                                <input type="checkbox" disabled id="checkbox-demo_@(cnt)" data-mailpieceid="@item.MailPieceId" class="cl-check" />
                                <label for="checkbox-demo_@(cnt)"></label>
                                break;
                            case "InProgress":
                            <input type="checkbox" id="checkbox-demo_@(cnt)" data-mailpieceid="@item.MailPieceUniqueId" class="cl-check checkall" />
                            <label for="checkbox-demo_@(cnt)"></label>
                                break;

                        }
                        @*<input type="checkbox" id="checkbox-demo_@(cnt)" data-mailpieceid="@item.MailPieceId" class="cl-check checkall" />
                            <label for="checkbox-demo_@(cnt)"></label>*@
                    </td>
                    <td><span>@cnt</span></td>
                    <td><span>@item.BusinessFriendlyIdValue</span></td>
                    @*<td><span>@item.DocumentOrPackageType</span></td>*@
                    <td><span>@item.FileName</span></td>
                    <td><span>@item.RecipientName </span></td>
                    <td><span>@item.RCPTAddress</span></td>
                    <td><span>@item.RetAddress</span></td>
                    <td><span>@item.TotalPages</span></td>
                    @*<td><span>@item.ShippingMethod</span></td>*@
                    <td><span>@item.TrackingNo</span></td>
                    <td>
                        @switch (item.ShippingStatus)
                        {

                            case "PulledBack":
                                <span class="label medium label-red">@item.ShippingStatus</span>
                                break;
                            case "Error":
                            <span class="label medium label-red">@item.ShippingStatus</span>
                                break;
                            case "Shipped":
                            <span class="label medium label-success">@item.ShippingStatus</span>
                                break;
                            case "InProgress":
                            <span class="label medium label-blue">@item.ShippingStatus</span>
                                break;

                        }

                    </td>
                </tr>

                        cnt++;
            }
        </tbody>

    </table>
}
