@model ICollection<AM.Services.PullBackInfo>


@if (Model.Count > 0)
{
    var cnt = 1;
    <style>
        .popover-content {
            word-wrap: break-word;
            color: red;
        }
    </style>
    <table class="table table-responsive" id="sample_2">
        <thead>
            <tr>
                <th>Loan Number</th>
                <th>File Name</th>
                <th>Recipient Name</th>
                <th>Recipient Address</th>
                <th>Pages</th>
                <th>Document Type</th>
                <th>Pullback Requested</th>
                <th>Tracking Number</th>
                <th>Shipping Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="row-small">

                    <td class="mailpieceid" data-mailpieceid="@item.MailPieceUniqueId"><span>@item.BusinessFriendlyIdValue</span></td>
                    <td><span>@item.FileName</span></td>
                    <td><span>@item.RecipientName </span></td>
                    <td><span>@item.RCPTAddress</span></td>
                    <td><span>@item.TotalPages</span></td>
                    <td><span>@item.DocumentOrPackageType</span></td>
                    <td class="ispullbackr">
                        @if (item.IsPullBackRequested)
                        {
                            <span class="label medium label-yellow">Yes</span>
                        }
                        else
                        {
                            <span class="label medium label-success">No</span>
                        }
                    </td>

                    <td><span>@item.TrackingNo</span></td>
                    <td class="status">
                        @switch (item.ShippingStatus)
                        {

                            case "PulledBack":
                                <span class="label medium label-yellow">@item.ShippingStatus</span>

                                break;
                            case "Error":
                            <span class="label medium label-red" data-content="@(!string.IsNullOrEmpty(item.ErrorDesc) ? Html.Raw("<span class='text-red'>" + item.ErrorDesc + "</span>") : Html.Raw("<span class='text-red'>" + AM.Services.Config.Msg_Web_NoErrorDescription + "</span>"))" data-placement="left">@item.ShippingStatus</span>
                                break;
                            case "Shipped":
                            <span class="label medium label-success">@item.ShippingStatus</span>
                                break;
                            case "InProgress":
                            <span class="label medium label-blue">@item.ShippingStatus</span>
                                break;

                        }

                    </td>
                </tr>

                        cnt++;
            }
        </tbody>

    </table>
    <script>
    $(document).ready(function () {
        $('[data-toggle="popover"]').popover({
            'trigger': 'hover',
            'placement': 'left',
            'container': 'body'
        });
    });
    </script>
}
else
{
    <div class="alert alert-yellow norecordpullback">
        <span class="sbold">@AM.Services.Config.Msg_Web_NoRecordFound</span>
    </div>
}
