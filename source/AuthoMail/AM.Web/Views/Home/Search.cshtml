        function FilterData() {
            $("#searchHeader").hide();
            $("#searchMailPieceList").hide();
            var el = $('#searchMailPieceList');
            var selectedData = $("#receivedOn").val().split('-');
            $("#loading").show();
            var startDate = moment(selectedData[0].trim()).format("MM/DD/YY");
            var endDate = moment(selectedData[1].trim()).format("MM/DD/YY");
            $("#headerdate").html(startDate + " to " + endDate + " EST");
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/_GetSearchData",
                data: JSON.stringify({
                    BusinessFriendlyIdName: $("#BusinessFriendlyIdName").val(),
                    BusinessFriendlyIdValue: $("#BusinessFriendlyIdValue").val(),
                    DocType: $("#DocType").val(),
                    Status: $("#Status").val(),
                    Channel: $("#Channel").val(),
                    receivedOnStart: startDate,
                    receivedOnEnd: endDate,
                    trackingNumber: $("#TrackingNumber").val(),
                    clientBatchId: $("#ClientBatchId").val(),
                    batchId: $("#BatchId").val()

                }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    // //console.log(response);
                    if (response.Success) {
                        $("#loading").hide();
                        $("#searchHeader").show();
                        $("#searchMailPieceList").show();
                        if (response.Object != null) {
                            //console.log(response.Object.model.length);
                            if (response.Object.model.length > 0) {
                                $("#searchMailPieceList").html("");
                                var data = FormatObject(response.Object.model);
                                BindTemplate(data, "#SearchBody", "#SearchbodyContent", "#SearchTableContent", "#searchMailPieceList");
                                window.clui.tooltipInit();
                            }
                            else {
                                $("#searchMailPieceList").html(" <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>")
                            }
                        }
                    } else {
                        $("#loading").hide();
                        $("#searchHeader").show();
                        $("#searchMailPieceList").show();
                        $("#searchMailPieceList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#loading").hide();
                    $("#searchHeader").show();
                    $("#searchMailPieceList").show();
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    $("#searchMailPieceList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                }

            });
        }

        $("#filterData").click(function () {
            if ($("#BatchId").val().trim() != "") {
                if ($("#searchform").valid()) {
                    FilterData();
                }
                else {
                    return false;
                }

            }
            else {
                FilterData();

            }
        });
        $("#resetFilter").click(function () {
            $("#Status").val("");
            $("#DocType").val("");
            $("#Channel").val("");
            $("#BusinessFriendlyIdValue").val("");
            $("#ClientBatchId").val("");
            $("#BatchId").val("");
            $("#TrackingNumber").val("");
            $('.selectpicker').selectpicker('refresh');
        });
    </script>
