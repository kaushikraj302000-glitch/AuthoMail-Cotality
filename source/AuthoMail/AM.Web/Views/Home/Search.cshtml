@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")

    <script type="text/javascript">
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            FilterData();
            $('#searchform').validate({ // initialize the plugin
                errorElement: "span",
                rules: {
                    BatchId: {
                        number: true,
                        min: 1,
                        maxlength: 8
                    }
                }
            });
            // JSON.useDateParser(false);
        });


        function ViewDetails(obj) {
            //alert("call");
            var mailPieceId = $(obj).data("mailpieceid");
            //console.log(mailPieceId);
            $("#databind").html("");
            $("#ViewInfo").modal("show");
            $("#loadingModal").show();
            $.ajax({
                type: "GET",
                url: baseUrl + "Home/GetMailPieceByUniqueId",
                data: {
                    mailPieceId: mailPieceId
                },
                //contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.Success) {
                        if (response.Object != null) {
                            if (response.Object.model != null) {
                                $("#loadingModal").hide();
                                var data = FormatMailPieceObject(response.Object.model);
                                var bodyHtml = $("#templatemodal").html();
                                $("#databind").html("");
                                bodyHtml = bodyHtml.supplant(data);
                                $("#databind").html(bodyHtml);
                                $('[data-toggle="popover"]').popover({
                                    'trigger': 'hover',
                                    'placement': 'auto left',
                                    'container': 'body'
                                });
                                window.clui.tooltipInit();
                            }
                            else {
                                $("#loadingModal").hide();
                                $("#databind").html("");
                                $("#showerror").show();
                                $("#showerror").html(" <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>");

                            }
                        }
                    } else {
                        $("#loadingModal").hide();
                        $("#databind").html("");
                        $("#showerror").show();
                        $("#searchMailPieceList").show();
                        $("#showerror").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                        // $("#ViewInfo").modal("show");
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#showerror").show();
                    $("#loadingModal").hide();
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    $("#showerror").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                    $("#ViewInfo").modal("show");
                }

            });
            //$("#ViewInfo").find(".modal-body").text(mailPieceId);

        }
        function shortName(str) {
            //console.log(str);
            if (typeof str != 'undefined' && str != null && str != "")
                return str.length > 31 ? str.substring(0, 31) + '...' : str;
        }
        function MakeYesNoLabel(isbool) {
            var val = (isbool == true || isbool == 1) ? '<span  class="label medium label-yellow">Yes</span>' : '<span class="label medium label-success">No</span>';
            return val;
        }
