@{
    ViewBag.Title = "Search";
}

<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<style>
    .col-md-1, .col-md-2, .col-md-3 {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }


    .show-calendar {
        width: 484px !important;
    }
</style>
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseThree">
                <div class="panel-title">

                    <i class="fa fa-search"></i> Search
                    <div class="collapsed-icon pull-right">
                        <i class="fa fa-caret-left"></i>
                    </div>
                    <div class="expanded-icon pull-right">
                        <i class="fa fa-caret-down"></i>
                    </div>

                </div>
            </a>

        </div>
        <div id="collapseThree" class="panel-collapse collapse in">
            <div class="panel-body">
                <div class="col-md-3">
                    @if (ViewBag.BusinessId.Count == 1)
                    {
                        <label for="BusinessFriendlyIdValue">@ViewBag.BusinessId[0]</label>
                        <div class="input-group">
                            <i class="fa fa-search left-icon"></i>
                            <input class="form-control" name="BusinessFriendlyIdValue" value="@ViewBag.BusinessFriendlyIdValue" placeholder="@ViewBag.BusinessId[0]" required id="BusinessFriendlyIdValue">
                            <input type="hidden" value="@ViewBag.BusinessId[0]" name="BusinessFriendlyIdName" id="BusinessFriendlyIdName" />
                        </div>
                        <div class="text-red pull-left" style="display:none" id="BusinessFriendlyIdValueError">This field is required.</div>
                    }
                    else if (ViewBag.BusinessId.Count > 1)
                    {
                        <label for="BusinessFriendlyIdName">Select Business ID</label>
                        <div class="input-group">

                            <select id="BusinessFriendlyIdName" class="selectpicker">
                                <option value="">Select BusinessId</option>
                                @foreach (var item in ViewBag.BusinessId)
                                {
                                    <option value="@item.ToString()">@item.ToString()</option>
                                }
                            </select>
                            <input class="form-control" name="BusinessFriendlyIdValue" placeholder="" required id="BusinessFriendlyIdValue">

                        </div>
                    }
                    else
                    {
                        <br />
                        <div class='alert alert-yellow'><div>No business friendly id found!</div></div>
                    }
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="DocType">Document Type</label>
                        @Html.DropDownList("DocType", ViewBag.DocType as SelectList, "Select DocType", htmlAttributes: new { @class = "selectpicker" })
                    </div>

                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="Status">Status</label>
                        <select class="selectpicker" id="Status">
                            <option value="">Select Status</option>
                            <option value="InProgress">In Progress</option>
                            <option value="PulledBack">Pulledback</option>
                            <option value="Error">Error</option>
                            <option value="Shipped">Shipped</option>
                        </select>
                    </div>

                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="Channel">Channel</label>
                        @Html.Action("_Channel", "Common")
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="receivedOn">Received  On</label>
                        <div class="input-group daterange" id="datepicker4">
                            <input type="text" class="form-control" id="receivedOn">
                            <span class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </span>
                        </div>
                    </div>

                </div>
                @*<div class="col-md-3">
                        <div class="form-group">
                            <label for="shippedOn">Shipped On</label>
                            <div class="input-group daterange" id="datepicker4">
                                <input type="text" class="form-control" id="shippedOn">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </span>
                            </div>
                        </div>

                    </div>*@
                <div class="col-md-1">
                    <div class="form-group ">
                        <label for="filterData"> &nbsp;</label>
                        <button type="button" id="filterData" class="btn btn-primary">
                            <span class="sr-only">Filter</span>
                            <i class="fa fa-search"></i> Search
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<div class="panel panel-default" id="mailPieceList">

</div>

<!-- Modal -->
<div class="modal fade" id="TrackingInfo" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Tracking Details</h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">View All</button>*@
            </div>
        </div>
    </div>
</div>
@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")

    <script type="text/javascript">
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            FilterData();
            // JSON.useDateParser(false);
        });
        function FilterData() {

            var el = $('#mailPieceList');
            var selectedData = $("#receivedOn").val().split('-');

            var startDate = moment(selectedData[0].trim()).format("MM/DD/YYYY");
            var endDate = moment(selectedData[1].trim()).format("MM/DD/YYYY");
            el.html("<div class='alert alert-blue text-center'><span> Loading... </span></div>");
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/_GetSearchData",
                data: JSON.stringify({
                    BusinessFriendlyIdName: $("#BusinessFriendlyIdName").val(),
                    BusinessFriendlyIdValue: $("#BusinessFriendlyIdValue").val(),
                    DocType: $("#DocType").val(),
                    Status: $("#Status").val(),
                    Channel: $("#Channel").val(),
                    receivedOnStart: startDate,
                    receivedOnEnd: endDate

                }),
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    el.html(res);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = '@AM.Services.Config.Msg_Web_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                }

            });
        }
        $("#filterData").click(function () {
            FilterData();
        });
        function GetTrackingInfo(TrackingNo, ShippingMethod) {
            //

            var el = $('#TrackingInfo').find('.modal-body');
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/USPSTracking",
                data: JSON.stringify({
                    TrackingNo: TrackingNo,
                    ShippingMethod: ShippingMethod
                }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    el.html(response);

                    $("#TrackingInfo").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = '@AM.Services.Config.Msg_Web_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#TrackingInfo").modal("show");
                }

            });
        }
    </script>
}


