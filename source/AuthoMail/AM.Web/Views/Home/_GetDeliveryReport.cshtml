@model ICollection<AM.Services.Models.DeliveryReportVM>

@if (Model == null)
{
    <div class="alert alert-info">
        <div>@ViewBag.Message</div>
    </div>
}
else
{
    if (Model.Count > 0)
    {
        <table class="table table-bordered table-responsive table-striped">
            <thead>
                <tr>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-blue">
            <div>Batch not available.</div>
        </div>
    }
}
