@model ICollection<AM.Services.BatchListByChartData>
<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
@if (Model.Count > 0)
{
    var cnt = 1;
    <table class="table table-responsive" id="sample_2">
        <thead>
            <tr>
                <th>Batch Id</th>
                <th>Batch Name</th>
                <th>Batch Status</th>
                <th>Total MailPiece</th>
                <th>Received On <span class="fontcapitalize">(Local)</span></th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderBy(s => s.ReceivedOn))
            {
                <tr class="row-small">
                    <td><span>@item.ClientBatchId</span></td>
                    <td><span>@item.BatchName</span></td>
                    <td><span>@item.BatchStatus</span></td>
                    <td><span>@item.MailPieceCount</span></td>
                    <td><span>@item.ReceivedOn</span></td>
                    
                    <td>
                        <button onclick="GetMailPieceById(@item.BatchId,'@item.ReceivedOn.Value.ToString("MM/dd/yy HH:mm:ss")','@item.ClientBatchId')" type="button" class="btn btn-transparent-bright-blue">View Details</button>
                        @*@Html.ActionLink("View", "MailPieceByBatchId", "Home", new { batchId = item.BatchId }, new { @class = "btn btn-transparent-bright-blue" })*@

                    </td>
                </tr>

                        cnt++;
            }
        </tbody>

    </table>
}
else
{
    <div class="alert alert-yellow">
        <span class="sbold">@AM.Services.Config.Web_Msg_NoRecordFound</span>
    </div>
}