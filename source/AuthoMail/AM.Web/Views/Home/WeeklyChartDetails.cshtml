@model ICollection<AM.Services.Models.BatchListByChartData>
<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
@if (Model.Count > 0)
{
    var cnt = 1;
    <table class="table table-responsive" id="sample_2">
        <thead>
            <tr>
                <th>#</th>
                <th>Batch Id</th>
                <th>Batch Name</th>
                <th>Batch Status</th>
                <th>Received On</th>
                
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="row-small">
                    <td><span>@cnt</span></td>
                    <td><span>@item.ClientBatchId</span></td>
                    <td><span>@item.BatchName</span></td>
                    <td>
                        @switch (item.BatchStatus)
                        {

                            case "InProgress":
                                <span class="label medium label-blue">@item.BatchStatus</span>

                                break;
                            case "Failed":
                            <span class="label medium label-red">@item.BatchStatus</span>
                                break;
                            case "ShippedPartial":
                            <span class="label medium label-yellow">@item.BatchStatus</span>
                                break;
                            case "ShippedAll":
                            <span class="label medium label-green">@item.BatchStatus</span>
                                break;

                        }
                    </td>
                    <td><span>@item.ReceivedOn</span></td>
                    
                    <td>
                        <button onclick="GetMailPieceById(@item.BatchId)" type="button" class="btn btn-transparent-bright-blue">View </button>
                        @*@Html.ActionLink("View", "MailPieceByBatchId", "Home", new { batchId = item.BatchId }, new { @class = "btn btn-transparent-bright-blue" })*@

                    </td>
                </tr>

                        cnt++;
            }
        </tbody>

    </table>
}
else
{
    <div class="alert alert-yellow">
        <span class="sbold">@AM.Services.Config.Msg_Web_NoRecordFound</span>
    </div>
}