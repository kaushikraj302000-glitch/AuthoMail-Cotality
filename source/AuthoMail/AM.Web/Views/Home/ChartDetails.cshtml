<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<table class="table table-responsive" id="sample_2">
    <thead>
        <tr>
            <th>#</th>
            <th>Business Id</th>
            <th>Recipient Name</th>
            <th>Address</th>
            <th>Current status</th>
            <th>Shipping Cost</th>
            <th>Shipping Time</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 1; i <= 5; i++)
        {
            <tr class="row-small">
                <td>
                    <span>@i</span>
                </td>
                <td>
                    <span>Test @i</span>
                </td>
                <td>
                    <span>Type @i</span>
                </td>
                <td><span>Mobile @i</span></td>
                <td><span>Email @i</span></td>
                <td><span>Education @i</span></td>
                <td><span>Sem/Year @i</span></td>
                <td><button class="btn btn-primary" id="view@(i)"  onclick="GetMailPiece(@i)">View</button></td>
            </tr>

        }
    </tbody>

</table>

