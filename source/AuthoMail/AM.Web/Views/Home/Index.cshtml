@{
    ViewBag.Title = "Home Page";
}
<style>
    .prev, .next {
        font-size: 15px !important;
    }

    .dt-buttons {
        float: right !important;
        margin-top: -7%;
       
    }
    .dt-button{
        margin-right: 5px;
    }
   
    .dataTables_wrapper .dt-buttons {
        float: none;
        text-align: center;
    }
    /*
    .dataTables_filter
    {
        float:right !important;
    }
    .dataTables_filter label{
        float:left;
    }*/
</style>
<div class="panel panel-default">
    <div class="panel-heading">
        <div class="panel-title">Today Batch Details</div>
    </div>
    <div class="panel-body">
        <table class="table table-responsive" id="sample_2">
            <thead>
                <tr>
                    <th>No</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Mobile</th>
                    <th>Email</th>
                    <th>Education</th>
                    <th>Sem/Year</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 1; i <= 35; i++)
                {
                    <tr class="row-small">
                        <td>
                            <span>@i</span>
                        </td>
                        <td>
                            <span>Test @i</span>
                        </td>
                        <td>
                            <span>Type @i</span>
                        </td>
                        <td><span>Mobile @i</span></td>
                        <td><span>Email @i</span></td>
                        <td><span>Education @i</span></td>
                        <td><span>Sem/Year @i</span></td>
                        <td><span>Status @i</span></td>
                    </tr>

                }
            </tbody>

        </table>
    </div>
</div>

