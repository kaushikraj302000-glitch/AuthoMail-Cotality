@{
    ViewBag.Title = "Home Page";
}
<style>
    .prev, .next {
        font-size: 15px !important;
    }

    .dt-buttons {
        float: right !important;
        margin-top: -7%;
    }

    .dt-button {
        margin-right: 5px;
    }

    .dataTables_wrapper .dt-buttons {
        float: none;
        text-align: center;
    }
    
</style>
<div class="panel panel-default">
    <div class="panel-heading">
        <div class="panel-title">Today Batch Details</div>
    </div>
    <div class="panel-body">
        <table class="table table-responsive" id="sample_2">
            <thead>
                <tr>
                    <th>No</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Mobile</th>
                    <th>Email</th>
                    <th>Education</th>
                    <th>Sem/Year</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 1; i <= 35; i++)
                {
                    <tr class="row-small">
                        <td>
                            <span>@i</span>
                        </td>
                        <td>
                            <span>Test @i</span>
                        </td>
                        <td>
                            <span>Type @i</span>
                        </td>
                        <td><span>Mobile @i</span></td>
                        <td><span>Email @i</span></td>
                        <td><span>Education @i</span></td>
                        <td><span>Sem/Year @i</span></td>
                        <td><span>Status @i</span></td>
                        <td>
                            <a href="/Home/MailPiece" class="btn btn-default">
                                <span class="sr-only">View</span>
                                <i class="fa fa-eye"></i>
                            </a>
                        </td>
                    </tr>

                }
            </tbody>

        </table>
    </div>
</div>

@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script type="text/javascript">
        $(document).ready(function () {

            var table = $('#sample_2');
            var filename = "BatchReport";
            var title = "Batch Report";
            var oTable = table.dataTable({

                "language": {
                    "aria": {
                        "sortAscending": ": activate to sort column ascending",
                        "sortDescending": ": activate to sort column descending"
                    },
                    "emptyTable": "No data available in table",
                    "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                    "infoEmpty": "No entries found",
                    "infoFiltered": "(filtered1 from _MAX_ total entries)",
                    "lengthMenu": "_MENU_ entries",
                    "search": "<b>Search:</b>",
                    "zeroRecords": "No matching records found"
                },
               

                buttons: [
                    //{
                    //    extend: 'colvis',
                    //    text: 'Select Fields',
                    //    className: 'btn purple pull-left',
                    //    columns: ':not(.noVis)'
                    //},
                {
                    extend: 'excel',
                    text: '<i class="fa fa-file-excel-o"></i> Excel',
                    className: 'btn btn-primary',
                    filename: filename,
                    title: title,
                    exportOptions: {
                        columns: [0,1, 2, 3, 4, 5, 6, 7]
                    }
                    
                },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="fa fa-file-pdf-o"></i> Pdf',
                        className: 'btn btn-info',
                        filename: filename,
                        title: title,
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4, 5, 6, 7]
                        },
                        
                    }

                  

                ],

                "order": [
                    [0, 'asc']
                ],
                "lengthMenu": [
                    [5, 10, 25, 50, 100, -1],
                    [5, 10, 25, 50, 100, "All"] // change per page values here
                ],
                // set the initial value
                "pageLength": 5,

                "dom": "<'row' <'col-md-12'B>><'row'<'col-md-6 col-sm-12'l><'col-md-6 col-sm-12'f>r><'table-scrollable't><'row'<'col-md-5 col-sm-12'i><'col-md-7 col-sm-12'p>>", // horizobtal scrollable datatable

                
            });
           

        });

    </script>
}
