@{
    ViewBag.Title = "Home Page";
}

<style>
    .modal-backdrop.in {
        opacity: .75 !important;
        filter: alpha(opacity=75);
    }
</style>
<div class="col-md-6">
    <div class="panel panel-default ">
        <div class="panel-heading">
            <div class="panel-title">Today's MailPiece Details</div>
        </div>
        <div class="panel-body panel-gray ">
            <div id="todayChart"></div>
        </div>

    </div>
</div>

<div class="col-md-6 ">
    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="panel-title">Weekly Batch Details</div>
        </div>
        <div class="panel-body panel-gray">
            <div id="weeklyChart"></div>

        </div>
    </div>
</div>
<div class="clearfix"></div>
<div class="col-md-6">
    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="panel-title"><i class="fa fa-reply"></i> Quick Pullback</div>
        </div>
        <div class="panel-body panel-gray">
            <div class="form-group col-md-8">
                <label for="input2">Loan Number</label>
                <div class="input-group">
                    <i class="fa fa-search left-icon"></i>
                    <input class="form-control" name="loanNumber" placeholder="Loan Number" required id="loanNumber">
                </div>
                <div class="text-red pull-left" style="display:none" id="loanNumberEmpty">This field is required.</div>
            </div>
            <div class="form-group text-center col-md-4">

                <label for="pullback"> </label>
                <button type="button" id="pullback" class="btn btn-primary ">
                    <span class="sr-only"></span>
                    <i class="fa fa-reply"></i>
                    <span class="btnLabel">Pullback</span>
                </button>
            </div>
        </div>
    </div>
</div>
<div class="clearfix"></div>
<!-- Button trigger modal -->
@*<button type="button" class="btn btn-primary btn-lg" data-toggle="modal" data-target="#myModalGray">
        Launch demo modal
    </button>*@

<!-- Modal -->

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Pullback Response</h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">View All</button>*@
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="chartModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">MailPiece Details</h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">View All</button>*@
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="batchMailPieceModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Batch MailPiece Details</h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">View All</button>*@
            </div>
        </div>
    </div>
</div>
<div id="charDatatable" style="display:none"></div>
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h2 id="myModalLabel"> Are you sure you want to do pullback?</h2>
                <hr />
                <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-close"></i> No</button>
                <button type="button" class="btn btn-primary" id="yesPullback"><i class="fa fa-check"></i> Yes</button>
            </div>
            @*<div class="modal-body">
                    Are you sure you want do pullback?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">No</button>
                    <button type="button" class="btn btn-primary" id="yesPullback">Yes</button>
                </div>*@
        </div>
    </div>
</div>
@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script src="~/clui/dist/js/vendor/moment.js"></script>
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js">
    </script>
    <script type="text/javascript">
        function GetChartDataByStatusAndBatchIds(status, ids) {
            //var data={
            //    status: status,
            //    ids: ids,
            //}
            //var params = jQuery.param(data)
            //console.log(baseUrl + 'Home/ChartDetails?' + params);
            //window.location = baseUrl + 'Home/ChartDetails?' + params;
            var el = $('.modal-body');
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/ChartDetails",
                data: JSON.stringify({ status: status, batchIds: ids }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    // $("#charDatatable").html(response);
                    el.html(response);
                    $("#chartModal").on('shown.bs.modal', function (e) {
                        console.log("call");
                        $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                        //drawDatatable();
                    });
                    //el.html($("#charDatatable").html());
                    $("#chartModal").modal("show");
                    //drawDatatable();
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#chartModal").modal("show");
                }

            });
        }
        function BindWeeklyChartData() {
            var el = $("#weekluChart");
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/GetWeeklyChartData",
                data: JSON.stringify({ startDate: new Date(moment().subtract('days', 7).format('MM/DD/YYYY')), endDate: new Date(moment().format('MM/DD/YYYY')) }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                   // console.log(response);
                    var chartData = [];
                    chartData.push(['Date', 'InProgress', 'Failed', 'ShippedPartial', 'ShippedAll']);
                    var cnt = 0;
                    for (var i = 1; i <= response.length; i++) {
                        var day = moment(new Date(response[cnt].ShortDate)).format("MM/DD/YYYY") == moment(new Date()).format("MM/DD/YYYY") ? "Today" : moment(new Date(response[cnt].ShortDate)).format("ddd");
                        chartData.push([day, response[cnt].InProgress, response[cnt].Failed, response[cnt].ShippedPartial, response[cnt].ShippedAll]);
                        cnt++;
                    }
                    drawChart(chartData, "weeklyChart", 'Batch Details: ' + moment().subtract('days', 7).format('MM/DD/YYYY') + " - " + moment().format('MM/DD/YYYY'));

                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    //el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    //$("#chartModal").modal("show");
                }

            });
        }
        function BindTodayChartData() {
            var el = $("#todayChart");
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/GetTodayChartData",
                data: JSON.stringify({ date: new Date(moment().format('MM/DD/YYYY')) }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.length==0) {
                        el.html("<div class='alert alert-red'><span>Currently no MailPieces received today</span></div>");
                        return;
                    }
                    var chartData = [];
                    chartData.push(['BatchName', 'InProgress', 'Error', 'PulledBack', 'Shipped']);
                    var cnt = 0;
                    for (var i = 1; i <= response.length; i++) {

                        chartData.push(["Batch Id: " + response[cnt].BatchId, response[cnt].InProgress, response[cnt].Error, response[cnt].PulledBack, response[cnt].Shipped]);
                        cnt++;
                    }
                    drawChart(chartData, "todayChart", 'Batch MailPiece Details: ' + moment().format('MM/DD/YYYY'));

                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    
                }

            });

           

        }
        google.charts.load('current', { packages: ['corechart'] });
        function drawChart(chartData, div,title) {
            var data = google.visualization.arrayToDataTable(chartData);
            var options = {
                title: title,
                isStacked: true,
                'height': 300,
                legend: { position: 'top', maxLines: 3 },
                series: {
                    0: { color: '#36c' },
                    1: { color: '#dc3912' },
                    2: { color: '#f90' },
                    3: { color: '#109618' }
                }
            };

            // Instantiate and draw the chart.
            var chart = new google.visualization.BarChart(document.getElementById(div));
            function selectHandler() {
                var selectedItem = chart.getSelection()[0];
                console.log(chart.getSelection()[0]);

                if (selectedItem) {
                    var topping = data.getValue(selectedItem.row, 0);

                    var columnName = data.getColumnLabel(selectedItem.column);
                    alert(columnName + 'The user selected ' + topping);
                    var ids = [1, 2, 3, 7];
                    GetChartDataByStatusAndBatchIds(topping, ids)
                }
            }
            google.visualization.events.addListener(chart, 'select', selectHandler);
            chart.draw(data, options);
        }
        google.charts.setOnLoadCallback(BindWeeklyChartData);
        google.charts.setOnLoadCallback(BindTodayChartData);

        function SendPullBackRequest(mailpieceIds) {
            console.log(mailpieceIds);
            var el = $('.modal-body');
            //el.html(mailpieceIds);
            $.ajax({
                type: "POST",
                url: baseUrl + "api/pullback/RequestPullBack",
                data: { mailPieceIds: mailpieceIds },
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.Success) {
                        if (response.Object != null) {
                            el.html(response.Object);
                        }
                    }
                    else {
                        var htmlstr = "<div class='alert alert-red'><span>" + response.ErrorMessage + "</span></h1></div>";
                        el.html(htmlstr);
                    }
                    $("#myModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }

            });

        }

        $("#pullback").click(function (e) {
            if ($("#loanNumber").val() != "") {
                $("#loanNumberEmpty").hide();
                $("#confirmModal").modal("show");
            } else {
                $("#loanNumberEmpty").show();
            }
        });

        $("#yesPullback").click(function (e) {
            $("#confirmModal").modal("hide");
            console.log(baseUrl);
            e.preventDefault();

            var el = $('.modal-body');
            var loanNumber = $("#loanNumber").val();
            console.log(loanNumber);
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/GetMailPieceIdByLoanNumber",//?loanNumber=" + loanNumber,
                data: JSON.stringify({ loanNumber: loanNumber }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    console.log(response);
                    if (response == "PullBack") {
                        window.location = baseUrl + 'RequestPullBack/PullBack?loanNumber=' + loanNumber;
                    }
                    if (response.Success) {
                        if (response.Object != null) {
                            el.html(response.Object);
                        }
                    }
                    else {
                        var htmlstr = "<div class='alert alert-red'><span>" + response.ErrorMessage + "</span></h1></div>";
                        htmlstr += '<br><blockquote class=""><p><i class="fa fa-search"></i> @Html.ActionLink("Advance Search", "PullBack", "RequestPullBack") </P></blockquote>';
                        el.html(htmlstr);
                    }
                    //SendPullBackRequest(res)
                    $("#myModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    // el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }

            });


        });
    </script>
}
