@{
    ViewBag.Title = "Home Page";
}

<style>
    .modal-backdrop.in {
        opacity: .75 !important;
        filter: alpha(opacity=75);
    }
</style>
<div class="col-md-6">
    <div class="panel panel-default ">
        <div class="panel-heading">
            <div class="panel-title">Today Batch Details</div>
        </div>
        <div class="panel-body panel-gray ">
            <div id="container"></div>
        </div>

    </div>
</div>

<div class="col-md-6 ">
    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="panel-title">Weekly Batch Details</div>
        </div>
        <div class="panel-body panel-gray">
            <div id="barchart_values"></div>

        </div>
    </div>
</div>
<div class="clearfix"></div>
<div class="col-md-6">
    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="panel-title"><i class="fa fa-reply"></i> Quick Pullback</div>
        </div>
        <div class="panel-body panel-gray">
            <div class="form-group col-md-8">
                <label for="input2">Loan Number</label>
                <div class="input-group">
                    <i class="fa fa-search left-icon"></i>
                    <input class="form-control" name="loanNumber" placeholder="Loan Number" id="loanNumber">
                </div>
            </div>
            <div class="form-group text-center col-md-4">
                <label for="pullback"> </label>
                <button type="button" id="pullback" class="btn btn-primary ">
                    <span class="sr-only"></span>
                    <i class="fa fa-reply"></i>
                    <span class="btnLabel">Pullback</span>
                </button>
            </div>
        </div>
    </div>
</div>
<div class="clearfix"></div>
<!-- Button trigger modal -->
@*<button type="button" class="btn btn-primary btn-lg" data-toggle="modal" data-target="#myModalGray">
        Launch demo modal
    </button>*@

<!-- Modal -->

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog col-md-6" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Pullback Response</h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
                @*<button type="button" class="btn btn-primary">View All</button>*@
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="chartModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Batch Details</h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
                @*<button type="button" class="btn btn-primary">View All</button>*@
            </div>
        </div>
    </div>
</div>
<div id="charDatatable" style="display:none"></div>
@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script src="~/clui/dist/js/vendor/moment.js"></script>
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js">
    </script>
    <script type="text/javascript">
        function GetChartDataByStatusAndBatchIds(status, ids) {
            //var data={
            //    status: status,
            //    ids: ids,
            //}
            //var params = jQuery.param(data)
            //console.log(baseUrl + 'Home/ChartDetails?' + params);
            //window.location = baseUrl + 'Home/ChartDetails?' + params;
            var el = $('.modal-body');
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/ChartDetails",
                data: JSON.stringify({ status: status, batchIds: ids }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    // $("#charDatatable").html(response);
                    el.html(response);
                    $("#chartModal").on('shown.bs.modal', function (e) {
                        console.log("call");
                        $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                        //drawDatatable();
                    });
                    //el.html($("#charDatatable").html());
                    $("#chartModal").modal("show");
                    //drawDatatable();
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#chartModal").modal("show");
                }

            });
        }
        google.charts.load('current', { packages: ['corechart'] });
        function drawChart() {
            // Define the chart to be drawn.
            var data = google.visualization.arrayToDataTable([
               ['Date', 'InProgress', 'Error', 'Shipped'],
               [moment().subtract('days', 7).format('ddd'), 2, 3, 8],
               [moment().subtract('days', 6).format('ddd'), 1, 2, 9],
               [moment().subtract('days', 5).format('ddd'), 3, 1, 10],
               [moment().subtract('days', 4).format('ddd'), 0, 4, 15],
               [moment().subtract('days', 3).format('ddd'), 1, 0, 13],
               [moment().subtract('days', 2).format('ddd'), 2, 2, 12],
               [moment().subtract('days', 1).format('ddd'), 8, 1, 3]
            ]);

            var options = {
                title: 'Batch Details: ' + moment().subtract('days', 7).format('MM/DD/YYYY') + " - " + moment().format('MM/DD/YYYY'),
                isStacked: true,
                'height': 300,
                legend: { position: 'top', maxLines: 3 },
                series: {
                    0: { color: '#36c' },
                    1: { color: '#dc3912' },
                    2: { color: '#109618' }
                }
            };

            // Instantiate and draw the chart.
            var chart = new google.visualization.BarChart(document.getElementById('barchart_values'));
            function selectHandler() {
                var selectedItem = chart.getSelection()[0];
                console.log(chart.getSelection()[0]);

                if (selectedItem) {
                    var topping = data.getValue(selectedItem.row, 0);

                    var columnName = data.getColumnLabel(selectedItem.column);
                    alert(columnName + 'The user selected ' + topping);
                    var ids = [1, 2, 3, 7];
                    GetChartDataByStatusAndBatchIds(topping, ids)
                }
            }

            google.visualization.events.addListener(chart, 'select', selectHandler);
            chart.draw(data, options);
        }
        google.charts.setOnLoadCallback(drawChart);

        function drawChart1() {
            // Define the chart to be drawn.
            var data = new google.visualization.DataTable();
            data.addColumn('string', 'Status');
            data.addColumn('number', 'Percentage');
            data.addRows([
               ['InProgress', 10.0],
               ['Error', 25.8],
               ['Shipped', 64.2]
            ]);

            // Set chart options
            var options = {
                'title': 'Batch Details ' + moment().format('MMM DD, YYYY'),
                //'width': 550,
                'height': 300,
                colors: ['#36c', '#dc3912', '#109618'],
                is3D: true
            };

            // Instantiate and draw the chart.
            var chart = new google.visualization.PieChart(document.getElementById('container'));
            function selectHandler() {
                var selectedItem = chart.getSelection()[0];
                if (selectedItem) {
                    var topping = data.getValue(selectedItem.row, 0);
                    alert('The user selected ' + topping);
                    var ids = [1, 2, 3, 7];
                    GetChartDataByStatusAndBatchIds(topping, ids)
                }
            }

            google.visualization.events.addListener(chart, 'select', selectHandler);
            chart.draw(data, options);
        }
        google.charts.setOnLoadCallback(drawChart1);

        function SendPullBackRequest(mailpieceIds) {
            console.log(mailpieceIds);
            var el = $('.modal-body');
            //el.html(mailpieceIds);
            $.ajax({
                type: "POST",
                url: baseUrl + "api/pullback/RequestPullBack",
                data: { mailPieceIds: mailpieceIds },
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.Success) {
                        if (response.Object != null) {
                            el.html(response.Object);
                        }
                    }
                    else {
                        var htmlstr = "<div class='alert alert-red'><span>" + response.ErrorMessage + "</span></h1></div>";
                        el.html(htmlstr);
                    }
                    $("#myModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }

            });

        }

        $("#pullback").click(function (e) {
            console.log(baseUrl);
            e.preventDefault();
            var loanNumber = $("#loanNumber").val();
            console.log(loanNumber);
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/GetMailPieceIdByLoanNumber",//?loanNumber=" + loanNumber,
                data: JSON.stringify({ loanNumber: loanNumber }),
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    console.log(res);
                    if (res == "PullBack") {
                        window.location = baseUrl + 'PullBackRequest/PullBack?loanNumber=' + loanNumber;
                    }
                    //SendPullBackRequest(res)

                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    // el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                }

            });

        });
    </script>
}
@*<div id="barchart_values" style="width: 900px; height: 300px;"></div>*@