@*<button type="button" class="btn btn-default"><i class="fa fa-circle-o-notch fa-spin"></i> <span class="sr-only">Loading...</span> Default</button>*@

@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js">
    </script>
    <script type="text/javascript">
        var commonmsg = '@AM.Services.Config.Msg_Web_Ajax_CommonError';
        function GetChartDataByStatusAndBatchIds(status, ids, clientBatchId) {
            var el = $("#batchMailPieceModal").find('.modal-body');
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/TodayChartDetails",
                data: JSON.stringify({ status: status, batchId: ids }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    el.html(response);
                    $("#batchMailPieceModalHeader").html("Mailpiece Summary: Batch Id -" + clientBatchId);
                        //, Received On - " + moment(receivedOn).format("MM/DD/YY HH:mm:ss")
                    $("#batchMailPieceModal").modal("show");
                    setModalHeight("batchMailPieceModal");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");
                    $("#batchMailPieceModal").modal("show");
                }

            });
        }
        function GetChartDataByStatusAndDate(status, date) {
            var el = $("#batchModal").find('.modal-body');
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/WeeklyChartDetails",
                data: JSON.stringify({ status: status, date: date }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    el.html(response);
                    $("#batchModalHeader").html("Batch Summary:<span class='normaltext'> Received On - " + moment(date).format("MM/DD/YY") + ", Status - " + status+"</span>");
                    $("#batchModal").modal("show");
                    setModalHeight("batchModal");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");
                    $("#batchModal").modal("show");
                }

            });
        }

        function BindWeeklyChartData() {
            var el = $("#weekluChart");
            $.ajax({
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                //url: baseUrl + "Home/GetWeeklyChartData",
                url: baseUrl + "api/chart/GetWeeklyChartData",
                success: function (response) {
                    //console.log(response);
                    var chartData = [];
                    chartData.push(['Date', 'InProgress', 'Failed', 'ShippedPartial', 'ShippedAll', 'Dates']);
                    var cnt = 0;
                    var startDate = response[response.length - 1].Date;
                    var endDate = response[0].Date;
                    //console.log(startDate + " " + endDate);
                    for (var i = 1; i <= response.length; i++) {
                        //console.log(moment(response[cnt].Date).format("MM/DD/YYYY") == moment().format("MM/DD/YYYY") + " " + cnt + " " + i);
                        //var day = moment(response[cnt].Date).format("MM/DD/YYYY") == moment().format("MM/DD/YYYY") ? "Today" : moment(response[cnt].Date).format("ddd");
                        chartData.push([response[cnt].Weekday, response[cnt].InProgress, response[cnt].Failed, response[cnt].ShippedPartial, response[cnt].ShippedAll, moment(response[cnt].Date).format("MM/DD/YYYY hh:mm:ss a")]);
                        cnt++;
                    }
                    // console.log(chartData);
                    drawChart(chartData, "weeklyChart", 'Batch Details : ' + moment(startDate).format('MM/DD/YYYY') + " - " + moment(endDate).format('MM/DD/YYYY'), 300, 510);

                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");
                }

            });
        }
        function GetFullChart() {
            var el = $("#TodayChartModalBody");
            $.ajax({
                type: "POST",
                dataType: "JSON",
                url: baseUrl + "api/chart/GetTodayChartData",
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.length == 0) {
                        el.html("<div class='alert alert-yellow'><span>@AM.Services.Config.Msg_Web_NoMailPieceReceivedToday</span></div>");
                        $("#todayBody").css("min-height", "342px");
                        return;
                    }
                    var chartData = [];
                    chartData.push(['BatchName', 'InProgress', 'Error', 'PulledBack', 'Shipped', 'BatchId']);
                    var cnt = 0;
                    for (var i = 1; i <= response.length; i++) {

                        chartData.push([response[cnt].ClientBatchId, response[cnt].InProgress, response[cnt].Error, response[cnt].PulledBack, response[cnt].Shipped, response[cnt].MailBatchId]);
                        cnt++;
                    }
                    //console.log(chartData);
                    $("#TodayChartModal").modal("show");
                    drawChart(chartData, "TodayChartModalBody", 'MailPiece Status', 900, 1400);



                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");

                }

            });
        }
        function BindTodayChartData() {
            //TestDateTime();
            var el = $("#todayChart");
            $.ajax({
                type: "POST",
                dataType: "JSON",
                url: baseUrl + "api/chart/GetTodayChartData",
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.length == 0) {
                        el.html("<div class='alert alert-yellow'><span>@AM.Services.Config.Msg_Web_NoMailPieceReceivedToday</span></div>");
                        $("#todayBody").css("min-height", "342px");
                        return;
                    }
                    var chartData = [];
                    chartData.push(['BatchName', 'InProgress', 'Error', 'PulledBack', 'Shipped', 'BatchId']);
                    var cnt = 0;
                    for (var i = 1; i <= response.length; i++) {

                        chartData.push([response[cnt].ClientBatchId, response[cnt].InProgress, response[cnt].Error, response[cnt].PulledBack, response[cnt].Shipped, response[cnt].MailBatchId]);
                        cnt++;
                    }
                    //console.log(chartData);

                    drawChart(chartData, "todayChart", 'MailPiece Status', 300, 510);



                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");

                }

            });
        }
        function showModal() {
            $("#batchModal").modal("show");
        }
        function setModalHeight(id) {
            var bodyHeight = $("body").height();
            var count = $("#" + id).find("tr").length;//.find(".modal-body").height();
            //console.log(bodyHeight + " " + modalHeight);
            if (count > 5) {
                $("#" + id).find(".modal-body").height(bodyHeight - 350);
                $("#" + id).find(".modal-body").css("overflow-y", "scroll");
            }
            else {
                $("#" + id).find(".modal-body").height('auto');

            }

        }

        function GetMailPieceById(batchId, receivedOn,clientBatchId) {
            var el = $("#WeeklybatchMailPieceModal").find(".modal-body");
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/GetMailPieceByBatchId",
                data: JSON.stringify({ batchId: batchId }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    el.html(response);
                    $("#batchModal").modal("hide");
                    $("#WeeklybatchMailPieceHeader").html("Mailpiece Summary: <span class='normaltext'>Batch Id -" + clientBatchId + ", Received On - " + moment(receivedOn).format("MM/DD/YY HH:mm:ss")+"</span");
                    $("#WeeklybatchMailPieceModal").modal("show");
                    setModalHeight("WeeklybatchMailPieceModal");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");
                    $("#batchModal").modal("hide");
                    $("#WeeklybatchMailPieceModal").modal("show");
                }

            });
        }
        google.charts.load('current', { packages: ['corechart'] });
        function drawChart(chartData, div, title, height, width) {
            var data = google.visualization.arrayToDataTable(chartData);
            var view = new google.visualization.DataView(data);
            view.setColumns([0, 1, 2, 3, 4]);
            var options = {
                title: title,
                isStacked: true,
                'height': height,
                'width': width,
                hAxis: {
                    format: 0
                },
                legend: { position: 'top', maxLines: 3 },
                series: {
                    0: { color: '#36c' },
                    1: { color: '#dc3912' },
                    2: { color: '#f90' },
                    3: { color: '#109618' }
                }

            };

            // Instantiate and draw the chart.
            var chart = new google.visualization.BarChart(document.getElementById(div));

            google.visualization.events.addListener(chart, 'select', selectHandler);
            chart.draw(view, options);

            function selectHandler() {
                var selectedItem = chart.getSelection()[0];
                if (selectedItem) {
                    var status = data.getColumnLabel(selectedItem.column);
                    if (div == "todayChart") {
                        var batchId = parseInt(data.getValue(selectedItem.row, 5));
                        var clientBatchId = data.getValue(selectedItem.row, 0);
                        if (batchId != 0) {
                            GetChartDataByStatusAndBatchIds(status, batchId, clientBatchId);
                        }
                    }
                    if (div == "weeklyChart") {
                        var dates = data.getValue(selectedItem.row, 5);
                        GetChartDataByStatusAndDate(status, moment(dates).format("MM/DD/YYYY"));
                    }
                }
            }
        }
        google.charts.setOnLoadCallback(BindWeeklyChartData);
        google.charts.setOnLoadCallback(BindTodayChartData);
        $("#FullTodayChart").click(function () {

            google.charts.setOnLoadCallback(GetFullChart);

        });
        function TestDateTime() {
            $.ajax({
                type: "POST",
                url: baseUrl + "api/chart/GetDateTime",
                //url: baseUrl + "Home/DoSomething",
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (response) {
                    // console.log(response);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    //console.log(xhr)
                    //console.log(ajaxOptions)
                    //console.log(thrownError)
                }

            });
        }
        function SendPullBackRequest(mailpieceId) {
            var mailpieceIds = [];
            mailpieceIds.push(mailpieceId);
            //console.log(mailpieceIds);
            var el = $("#myModal").find('.modal-body');
            $.ajax({
                type: "POST",
                url: baseUrl + "api/pullback/RequestPullBack",
                data: JSON.stringify(mailpieceIds),
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (response) {
                    if (response.Success) {
                        if (response.Object != null) {
                            var msgAdd = "<ul>";
                            var msg = response.Object[i].Message;
                            for (var i = 0; i < response.Object.length; i++) {
                                if (response.Object[i] != "" || response.Object[i] == "undefined") {
                                    if (response.Object[i].PullBackRequestedOn != null && response.Object[i].PulledBackRequestedBy != "") {

                                        msg = msg + " by " + response.Object[i].PulledBackRequestedBy + " on " + moment(response.Object[i].PullBackRequestedOn).format("MM/DD/YYYY  HH:mm:ss");
                                    }
                                    if (response.Object[i].Success) {

                                        msgAdd += "<li><span class='text-bright-blue '>" + $("#BusinessFriendlyIdValue").val() + "</span>:" + msg + "</li>";
                                    }
                                    else {
                                        msgAdd += "<li ><span class='text-bright-blue '>" + $("#BusinessFriendlyIdValue").val() + "</span>:<span class='text-red'>" + response.Object[i].Message + "</span></li>";
                                    }

                                }
                            }
                            msgAdd += "</ul>";
                            //alert(msgAdd);
                            //$("#ErrorMessage").append(msgAdd);
                            el.html(msgAdd);
                        }
                    }
                    else {
                        var htmlstr = "<div class='alert alert-red'><span>" + response.ErrorMessage + "</span></h1></div>";
                        htmlstr += '<br><blockquote class=""><p><u><i class="fa fa-search"></i> @Html.ActionLink("Advance Search", "PullBack", "RequestPullBack") </u></P></blockquote>';
                        el.html(htmlstr);
                    }
                    $("#myModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");
                    $("#myModal").modal("show");
                }

            });

        }
        $('#BusinessFriendlyIdValue').on("keypress", function (e) {
            if (e.keyCode == 13) {
                RequestPullback(); // prevent the button click from happening
            }
        });
        function RequestPullback() {
            if ($("#BusinessFriendlyIdName").val() == "") {
                $("#BusinessFriendlyIdNameError").show();
                return;
            }
            //else {
            //    $("#BusinessFriendlyIdNameError").show();
            //}
            if ($("#BusinessFriendlyIdValue").val() == "") {
                $("#BusinessFriendlyIdValueError").show();
                return;
            }
            //else {
            //    $("#BusinessFriendlyIdValueError").hide();
            //}


            $.ajax({
                type: "POST",
                url: baseUrl + "Home/GetMailPieceIdByLoanNumber",
                data: JSON.stringify({ BusinessFriendlyIdName: $("#BusinessFriendlyIdName").val(), BusinessFriendlyIdValue: $("#BusinessFriendlyIdValue").val(), startDate: moment().format("MM/DD/YYYY"), endDate: moment().format("MM/DD/YYYY") }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    // $("#charDatatable").html(response);
                    if (response == "PullBack") {
                        window.location = baseUrl + 'RequestPullBack/PullBack?BusinessFriendlyIdName=' + $("#BusinessFriendlyIdName").val() + '&BusinessFriendlyIdValue=' + $("#BusinessFriendlyIdValue").val();

                    } else if (response == "AdvancePullBack") {
                        var el = $("#myModal").find('.modal-body');
                        var htmlstr = "<div class='alert alert-red'><span>@AM.Services.Config.Msg_Web_NoRecordFound</span></h1></div>";
                        htmlstr += '<br><blockquote class=""><p><u><i class="fa fa-search"></i> @Html.ActionLink("Advance Search", "PullBack", "RequestPullBack") </u></p></blockquote>';
                        el.html(htmlstr);
                        $("#myModal").modal("show");
                        return;
                    } else {
                        var el = $("#confirmModal").find('.modal-body');
                        el.html(response);
                        if (el.find(".norecordpullback")) {
                            $("#confirmMsg").hide();
                            $("#yesPullback").hide();
                            $("#noPullback").html("<i class='fa fa-close'></i> Close");
                            $("#noPullback").removeClass("btn-default");
                            $("#noPullback").addClass("btn-primary");
                            $("#confirmModal").modal("show");
                            return;
                        }

                        $("#confirmModal").on('shown.bs.modal', function (e) {
                            $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                            //drawDatatable();
                        });
                        var status = $("#sample_2").find(".status").text().trim();
                        var IsPullbackRequested = $("#sample_2").find(".ispullbackr").text().trim();
                        switch (status) {
                            case "PulledBack":
                            case "Error":
                            case "Shipped":
                                $("#yesPullback").hide();
                                $("#noPullback").html("<i class='fa fa-close'></i> Close");
                                $("#noPullback").removeClass("btn-primary");
                                $("#noPullback").addClass("btn-default");
                                break;
                            case "InProgress":
                                if (IsPullbackRequested == "Yes") {
                                    $("#confirmMsg").hide();
                                    $("#yesPullback").hide();
                                    $("#noPullback").html("<i class='fa fa-close'></i> Close");
                                    $("#noPullback").removeClass("btn-primary");
                                    $("#noPullback").addClass("btn-default");
                                }
                                else {
                                    $("#confirmMsg").show();
                                    $("#yesPullback").show();
                                    $("#noPullback").html("<i class='fa fa-close'></i> No");
                                    $("#noPullback").removeClass("btn-default");
                                    $("#noPullback").addClass("btn-primary");
                                }
                                //$("#yesPullback").show();
                                //$("#noPullback").html("<i class='fa fa-close'></i> No");
                                //$("#noPullback").removeClass("btn-primary");
                                //$("#noPullback").addClass("btn-default");
                                break;
                        }
                        $("#confirmModal").modal("show");
                    }
