@{
    ViewBag.Title = "Home Page";
}

<div class="col-md-6">
    <div class="panel panel-default ">
        <div class="panel-heading">
            <div class="panel-title">Weekly Batch Details</div>
        </div>
        <div class="panel-body panel-gray">
            <div id="barchart_values"></div>

        </div>
    </div>
</div>

<div class="col-md-6 ">
    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="panel-title">Monthly Batch Details</div>
        </div>
        <div class="panel-body panel-gray ">
            <div id="container"></div>
        </div>
    </div>
</div>
<div class="clearfix"></div>
<div class="col-md-6">
    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="panel-title"><i class="fa fa-reply"></i> Quick Pullback</div>
        </div>
        <div class="panel-body panel-gray">
            <div class="form-group col-md-8">
                <label for="input2">Loan Number</label>
                <div class="input-group">
                    <i class="fa fa-search left-icon"></i>
                    <input class="form-control" placeholder="Loan Number" id="loanNumber">
                </div>
            </div>
            <div class="form-group text-center col-md-4">
                <label for="pullback"> </label>
                <button type="button" id="pullback" class="btn btn-primary ">
                    <span class="sr-only"></span>
                    <i class="fa fa-reply"></i>
                    <span class="btnLabel">Pullback</span>
                </button>
            </div>
        </div>
    </div>
</div>
<div class="clearfix"></div>
<script src="~/clui/dist/js/vendor/moment.js"></script>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js">
</script>
<script type="text/javascript">
    google.charts.load('current', { packages: ['corechart'] });
    function drawChart() {
        // Define the chart to be drawn.
        var data = google.visualization.arrayToDataTable([
           ['Date', 'InProgress', 'Error', 'Shipped'],
           [moment().subtract('days', 7).format('ddd'), 2, 3, 8],
           [moment().subtract('days', 6).format('ddd'), 1, 2, 9],
           [moment().subtract('days', 5).format('ddd'), 3, 1, 10],
           [moment().subtract('days', 4).format('ddd'), 0, 4, 15],
           [moment().subtract('days', 3).format('ddd'), 1, 0, 13],
           [moment().subtract('days', 2).format('ddd'), 2, 2, 12],
           [moment().subtract('days', 1).format('ddd'), 8, 1, 3]
        ]);

        var options = {
            title: 'Batch Details: ' + moment().subtract('days', 7).format('MM/DD/YYYY') + " - " + moment().format('MM/DD/YYYY'),
            isStacked: true,
            'height': 300,
            legend: { position: 'top', maxLines: 3 },
            series: {
                0: { color: '#36c' },
                1: { color: '#dc3912' },
                2: { color: '#109618' }
            }
        };

        // Instantiate and draw the chart.
        var chart = new google.visualization.BarChart(document.getElementById('barchart_values'));
        chart.draw(data, options);
    }
    google.charts.setOnLoadCallback(drawChart);

    function drawChart1() {
        // Define the chart to be drawn.
        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Status');
        data.addColumn('number', 'Percentage');
        data.addRows([
           ['InProgress', 10.0],
           ['Error', 25.8],
           ['Shipped', 64.2]
        ]);

        // Set chart options
        var options = {
            'title': 'Batch Details ' + moment().subtract('month', 1).format('MMMM, YYYY'),
            //'width': 550,
            'height': 300,
            colors: ['#36c', '#dc3912', '#109618'],
            is3D: true
        };

        // Instantiate and draw the chart.
        var chart = new google.visualization.PieChart(document.getElementById('container'));
        chart.draw(data, options);
    }
    google.charts.setOnLoadCallback(drawChart1);
</script>
@*<div id="barchart_values" style="width: 900px; height: 300px;"></div>*@