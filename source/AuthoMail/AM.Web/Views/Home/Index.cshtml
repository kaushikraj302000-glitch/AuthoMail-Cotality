                    if (response == "PullBack") {
                        window.location = baseUrl + 'RequestPullBack/PullBack?BusinessFriendlyIdName=' + $("#BusinessFriendlyIdName").val() + '&BusinessFriendlyIdValue=' + $("#BusinessFriendlyIdValue").val();

                    } else if (response == "AdvancePullBack") {
                        var el = $("#myModal").find('.modal-body');
                        var htmlstr = "<div class='alert alert-red'><span>No record found!</span></h1></div>";
                        htmlstr += '<br><blockquote class=""><p><i class="fa fa-search"></i> @Html.ActionLink("Advance Search", "PullBack", "RequestPullBack") </P></blockquote>';
                        el.html(htmlstr);
                        $("#myModal").modal("show");
                        return;
                    } else {
                        var el = $("#confirmModal").find('.modal-body');
                        el.html(response);
                        $("#confirmModal").on('shown.bs.modal', function (e) {
                            $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                            //drawDatatable();
                        });
                        var status = $("#sample_2").find(".status").text().trim();
                        var IsPullbackRequested = $("#sample_2").find(".ispullbackr").text().trim();
                        switch (status) {
                            case "PulledBack":
                            case "Error":
                            case "Shipped":
                                $("#yesPullback").hide();
                                $("#noPullback").html("<i class='fa fa-close'></i> Close");
                                $("#noPullback").removeClass("btn-default");
                                $("#noPullback").addClass("btn-primary");
                                break;
                            case "InProgress":
                                if (IsPullbackRequested == "Yes") {
                                    $("#yesPullback").hide();
                                    $("#noPullback").html("<i class='fa fa-close'></i> Close");
                                    $("#noPullback").removeClass("btn-default");
                                    $("#noPullback").addClass("btn-primary");
                                }
                                else {
                                    $("#yesPullback").show();
                                    $("#noPullback").html("<i class='fa fa-close'></i> No");
                                    $("#noPullback").removeClass("btn-primary");
                                    $("#noPullback").addClass("btn-default");
                                }
                                //$("#yesPullback").show();
                                //$("#noPullback").html("<i class='fa fa-close'></i> No");
                                //$("#noPullback").removeClass("btn-primary");
                                //$("#noPullback").addClass("btn-default");
                                break;
                        }
                        console.log()
                        $("#confirmModal").modal("show");
                    }
                    //el.html(response);
                    //$("#chartModal").on('shown.bs.modal', function (e) {
                    //    console.log("call");
                    //    $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                    //    //drawDatatable();
                    //});
                    //el.html($("#charDatatable").html());
                    // $("#chartModal").modal("show");
                    //drawDatatable();
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var el = $("#myModal").find('.modal-body');
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }

            });
            $("#BusinessFriendlyIdNameError").hide();
            $("#BusinessFriendlyIdValueError").hide();
            //$("#confirmModal").modal("show");

        });

        $("#yesPullback").unbind("click").click(function (e) {
            // console.log(baseUrl);
            e.preventDefault();
            $("#confirmModal").modal("hide");
            var mailpieceId = $("#sample_2").find(".mailpieceid").data("mailpieceid");
