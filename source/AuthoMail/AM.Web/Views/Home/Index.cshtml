@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script src="~/clui/dist/js/vendor/moment.js"></script>
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js">
    </script>
    <script type="text/javascript">
        function GetChartDataByStatusAndBatchIds(status, ids) {
            var el = $("#batchMailPieceModal").find('.modal-body');
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/TodayChartDetails",
                data: JSON.stringify({ status: status, batchId: ids }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    el.html(response);
                    $("#batchMailPieceModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#batchMailPieceModal").modal("show");
                }

            });
        }
        function GetChartDataByStatusAndDate(status, date) {
            var el = $("#batchModal").find('.modal-body');
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/WeeklyChartDetails",
                data: JSON.stringify({ status: status, date: new Date(date) }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    el.html(response);
                    $("#batchModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#batchModal").modal("show");
                }

            });
        }
        function BindWeeklyChartData() {
            var el = $("#weekluChart");
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/GetWeeklyChartData",
                data: JSON.stringify({ startDate: new Date(moment().subtract('days', 7).format('MM/DD/YYYY')), endDate: new Date(moment().format('MM/DD/YYYY')) }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    var chartData = [];
                    chartData.push(['Date', 'InProgress', 'Failed', 'ShippedPartial', 'ShippedAll', 'Dates']);
                    var cnt = 0;
                    for (var i = 1; i <= response.length; i++) {
                        var day = moment(new Date(response[cnt].ShortDate)).format("MM/DD/YYYY") == moment(new Date()).format("MM/DD/YYYY") ? "Today" : moment(new Date(response[cnt].ShortDate)).format("ddd");
                        chartData.push([day, response[cnt].InProgress, response[cnt].Failed, response[cnt].ShippedPartial, response[cnt].ShippedAll, moment(new Date(response[cnt].ShortDate)).format("MM/DD/YYYY")]);
                        cnt++;
                    }
                    drawChart(chartData, "weeklyChart", 'Batch Details: ' + moment().subtract('days', 7).format('MM/DD/YYYY') + " - " + moment().format('MM/DD/YYYY'));

                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                }

            });
        }
        function BindTodayChartData() {
            var el = $("#todayChart");
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/GetTodayChartData",
                data: JSON.stringify({ date: new Date(moment().format('MM/DD/YYYY')) }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.length == 0) {
                        el.html("<div class='alert alert-yellow'><span>Currently no MailPieces received today</span></div>");
                        $("#todayBody").css("min-height", "342px");
                        return;
                    }
                    var chartData = [];
                    chartData.push(['BatchName', 'InProgress', 'Error', 'PulledBack', 'Shipped']);
                    var cnt = 0;
                    for (var i = 1; i <= response.length; i++) {

                        chartData.push(["Batch Id: " + response[cnt].BatchId, response[cnt].InProgress, response[cnt].Error, response[cnt].PulledBack, response[cnt].Shipped]);
                        cnt++;
                    }
                    drawChart(chartData, "todayChart", 'Batch MailPiece Details: ' + moment().format('MM/DD/YYYY'));

                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");

                }

            });
        }
        function showModal() {
            $("#batchModal").modal("show");
        }
        function GetMailPieceById(batchId) {
            var el = $("#WeeklybatchMailPieceModal").find(".modal-body");
            $.ajax({
                type: "POST",
                url: baseUrl + "Home/GetMailPieceByBatchId",
                data: JSON.stringify({ batchId: batchId }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    el.html(response);
                    $("#batchModal").modal("hide");
                    $("#WeeklybatchMailPieceModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#batchModal").modal("hide");
                    $("#WeeklybatchMailPieceModal").modal("show");
                }

            });
        }
        google.charts.load('current', { packages: ['corechart'] });
        function drawChart(chartData, div, title) {
            var data = google.visualization.arrayToDataTable(chartData);
            var view = new google.visualization.DataView(data);
            view.setColumns([0, 1, 2, 3, 4]);
            var options = {
                title: title,
                isStacked: true,
                'height': 300,
                legend: { position: 'top', maxLines: 3 },
                series: {
                    0: { color: '#36c' },
                    1: { color: '#dc3912' },
                    2: { color: '#f90' },
                    3: { color: '#109618' }
                }

            };

            // Instantiate and draw the chart.
            var chart = new google.visualization.BarChart(document.getElementById(div));

            google.visualization.events.addListener(chart, 'select', selectHandler);
            chart.draw(view, options);

            function selectHandler() {
                var selectedItem = chart.getSelection()[0];
                if (selectedItem) {
                    var status = data.getColumnLabel(selectedItem.column);
                    if (div == "todayChart") {
                        var id = data.getValue(selectedItem.row, 0);
                        var batchId = parseInt(id.split(":")[1].trim());
                        if (batchId != 0) {
                            GetChartDataByStatusAndBatchIds(status, batchId);
                        }
                    }
                    if (div == "weeklyChart") {
                        var dates = data.getValue(selectedItem.row, 5);

                        GetChartDataByStatusAndDate(status, dates);
                    }
                }
            }
        }
        google.charts.setOnLoadCallback(BindWeeklyChartData);
        google.charts.setOnLoadCallback(BindTodayChartData);

        function SendPullBackRequest(mailpieceId) {
            var mailpieceIds = [];
            mailpieceIds.push(mailpieceId);
            console.log(mailpieceIds);
            var el = $("#myModal").find('.modal-body');
            $.ajax({
                type: "POST",
                url: baseUrl + "api/pullback/RequestPullBack",
                data: JSON.stringify(mailpieceIds),
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (response) {
                    if (response.Success) {
                        if (response.Object != null) {
                            var msgAdd = "<ul>";

                            for (var i = 0; i < response.Object.length; i++) {
                                if (response.Object[i] != "" || response.Object[i] == "undefined") {
                                    if (response.Object[i].IsSuccess) {

                                        msgAdd += "<li><span class='text-bright-blue '>" + response.Object[i].MailPieceId + "</span>:" + response.Object[i].Message + "</li>";
                                    }
                                    else {
                                        msgAdd += "<li ><span class='text-bright-blue '>" + response.Object[i].MailPieceId + "</span>:<span class='text-red'>" + response.Object[i].Message + "</span></li>";
                                    }

                                }
                            }
                            msgAdd += "</ul>";
                            //alert(msgAdd);
                            //$("#ErrorMessage").append(msgAdd);
                            el.html(msgAdd);
                        }
                    }
                    else {
                        var htmlstr = "<div class='alert alert-red'><span>" + response.ErrorMessage + "</span></h1></div>";
                        htmlstr += '<br><blockquote class=""><p><i class="fa fa-search"></i> @Html.ActionLink("Advance Search", "PullBack", "RequestPullBack") </P></blockquote>';
                        el.html(htmlstr);
                    }
                    $("#myModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = 'Error on reloading the content. Please check your connection and try again.';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }

            });

        }

        $("#pullback").click(function (e) {
            if ($("#BusinessFriendlyIdName").val() == "") {
                $("#BusinessFriendlyIdNameError").show();
