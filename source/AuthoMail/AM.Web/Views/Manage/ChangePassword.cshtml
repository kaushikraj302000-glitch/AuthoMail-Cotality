@using AM.Entities
@model AM.Web.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";

}
<link href="~/clui/dist/css/changepasswordui.css" rel="stylesheet" />
@if (!User.Identity.IsCoreLogicUser())
{
    <section class="single-column" style="margin-top:1.5%;">
        <div class="cl-columns">
            <div class="inner-block">
                <div class="cl-row">
                    <div class="left-block cl-columns">
                        <h1>Change Password</h1>

                        @using (Html.BeginForm("ChangePassword", "Manage", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "cl-form-login", role = "form" }))
                        {
                            @Html.AntiForgeryToken()

                            @Html.ValidationSummary("", new { @class = "text-danger" })

                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.OldPassword)
                                    @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.NewPassword)
                                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.ConfirmPassword)
                                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <input type="submit" value="Change Password" class="btn btn-primary btn-lg btn-block">
                                </div>
                            </div>
                        }

                    </div>
                </div>

            </div>

        </div>
    </section>
}
else
{

    <div class="alert alert-yellow" style="margin-top:2%;font-size:medium;">
        <p>AuthoMail uses LDAP authentication for CoreLogic users. In other words, approved CoreLogic users may use their windows username and password to log on. Since AuthoMail does not own your windows account, it doesn't provide a way to change password. You may use traditional ways to change your password like 'Ctrl + Alt + Del' on your computer OR <a href="https://pwm.corelogic.com" target="_blank">https://pwm.corelogic.com.</a></p>
    </div>
}
