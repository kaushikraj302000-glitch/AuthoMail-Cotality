@model AM.Web.Models.TrackingInfoViewModel
@{
    ViewBag.Title = "Tracking Info";
    Layout = "~/Views/Shared/_LayoutTracking.cshtml";
}
<script src="~/Scripts/jquery-1.10.2.js"></script>
<div class="panel panel-default">
    <div class="panel-heading">
        <div class="panel-title text-center">Tracking Details</div>
    </div>
    <div class="panel-body panel-gray">
        <div class="row">
            <div class="col-md-12">
                @if (Model.TrackingDetailViewModel.IsError)
                {
                    <div class="alert alert-red">@Model.TrackingDetailViewModel.Message</div>
                }
                else if (Model.USPSTrackingInfo != null && Model.TrackingDetailViewModel.ShippingCarrier == "USPS" && Model.TrackingDetailViewModel.ShippingServiceType == "USPS")
                {
                    <div class="table-responsive">
                        @Html.Partial("~/Views/Common/_TrackingInfo.cshtml", Model.USPSTrackingInfo)
                    </div>
                }
                else if (Model.TrackingDetailViewModel.ShippingCarrier == "FedEx")
                {
                    <div class="alert alert-blue"> Redirecting on FedEx ...</div>
                    <script>
                        $(document).ready(function () {
                            var trackingNo = '@Model.TrackingDetailViewModel.TrackingNo';
                            setTimeout(function () {
                                window.location.href = 'http://www.fedex.com/Tracking?cntry_code=us&action=1&track=y&tracknumbers=' + trackingNo;

                            }, 2000);
                        });
                    </script>
                }
                else if (Model.TrackingDetailViewModel.ShippingCarrier == "USPS" && Model.TrackingDetailViewModel.ShippingServiceType == "USPS_EXPRESSMAIL")
                {
                    <div class="alert alert-blue"> Redirecting on USPS ... </div>
                    <script>
                        $(document).ready(function () {
                            var trackingNo = '@Model.TrackingDetailViewModel.TrackingNo';
                            setTimeout(function () {
                                window.location.href = 'https://m.usps.com/m/TrackConfirmAction_detail?tLabels=' + trackingNo;

                            }, 2000);
                        });
                    </script>
                }
                else
                {
                    <div class="alert alert-yellow">
                        <h3>Not found</h3>
                        <span class="sbold">
                            This tracking number cannot be found, please check the number.
                        </span>
                    </div>
                }
            </div>
        </div>
        <div class="margin-bottom-30"></div>
    </div>
</div>
