@model AM.Entities.MailPiece

@{
    ViewBag.Title = "SingleLoanEntry";
}

@if (ViewBag.msg != null)
{
    <div class="alert alert-green text-center">@(ViewBag.msg)</div>
    <br />
}

<form class="panel panel-default" method="post" enctype="multipart/form-data">
    <div class="panel-heading" id="headingOne">
        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#metaItem1">
            <div class="panel-title">
                Single Loan Entry
            </div>
        </a>
    </div>
    <div class="panel-body">
        @Html.AntiForgeryToken()

        <div class="for">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="col-md-4">
                <div class="form-group form-group-sm">
                    @Html.LabelFor(model => model.BusinessFriendlyIdName, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.BusinessFriendlyIdName, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.BusinessFriendlyIdName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group form-group-sm">
                    @Html.LabelFor(model => model.BusinessFriendlyIdValue, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.BusinessFriendlyIdValue, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.BusinessFriendlyIdValue, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group form-group-sm">
                    @Html.LabelFor(model => model.DocumentOrPackageType, htmlAttributes: new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.DocumentOrPackageType, ViewBag.docTypes as SelectList, "Select Doc Type", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.DocumentOrPackageType, "", new { @class = "text-danger" })
                </div>
            </div>


            <div class="clearfix"></div>
            @Html.Partial("_RecipientInfo")
            <div class="clearfix"></div>
            @Html.Partial("_RecipientAddress")
            <div class="clearfix"></div>
            <!--Return info-->
            @Html.Partial("_ReturnInfo")
            <div class="clearfix"></div>
            @Html.Partial("_ReturnAddress")
            <div class="clearfix"></div>
            <div class="panel-group">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <div class="panel-title">
                            <label class="control-label col-md-2">Upload PDF</label>
                            <input type="file" name="pdffile" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
            @*<div class="form-group form-group-sm">
                    <label class="control-label col-md-2">Upload PDF</label>
                    <div class="col-md-10">
                        <input type="file" name="pdffile" class="" />
                    </div>
                </div>*@


        </div>
    </div>
    <div class="panel-footer text-center">
        <input type="submit" value="Save" class="btn btn-success" />
        <input type="reset" value="Clear" class="btn btn-danger" />
    </div>
</form>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#eDelivery_PrintAndShipOnExpiry').change(function (e) {
                e.preventDefault();
                if ($(this).is(':checked')) {
                    $('*[data-valmsg-for="RecipientInfo.Recipient.EmailAddress"]').html('Required')
                    $('*[data-valmsg-for="eDelivery.ExpiryDate"]').html('Required')
                    $(this).val(true);
                } else {
                    $('*[data-valmsg-for="RecipientInfo.Recipient.EmailAddress"]').html('')
                    $('*[data-valmsg-for="eDelivery.ExpiryDate"]').html('')
                    $(this).val(false);
                }
            });
            $("#ExpiryDate").daterangepicker({
                minDate: new Date(),
                autoApply: true,
                singleDatePicker: true,
                showDropdowns: true,
                showCustomRangeLabel: false,
                autoUpdateInput: false
            }, function (startDate) {
                $("#ExpiryDate").val(startDate.format('MM-DD-YYYY'));
            });
        });
    </script>
}