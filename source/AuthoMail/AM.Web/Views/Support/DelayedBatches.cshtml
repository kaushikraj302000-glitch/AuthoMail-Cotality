            //});
        }
        function FormatObject(Model) {
            $(Model).each(function () {
                this.ShortMailBatchName = shortName(this.BatchName);
                this.BatchId = '<a  data-batchid="' + this.Id + '" onclick="ViewDetails(' + this.Id + ')" class="btn btn-transparent-blue btn-sm" >' + this.Id + '</a>';
                // this.TotalPages = this.Status == "Shipped" ? this.TotalPages : 0;
                this.ReceivedOn = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.TotalDelayedMailPieces = this.DelayedMailPieces.length;
                this.ClientId = this.ClientId == null ? '--' : this.ClientId;
                this.UniqueId = this.UniqueId == null ? "--" : this.UniqueId;
            });

            return Model;
        }
        function FormatObjectMP(Model) {
            $(Model).each(function () {
                this.ClientId = this.ClientId == null ? '--' : this.ClientId;
                this.UniqueId = this.UniqueId == null ? '--' : this.UniqueId;
                this.AppCode = this.AppCode == null ? '--' : this.AppCode;
                this.ReceivedOn = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.BatchName = this.BatchName == null ? '--' : this.BatchName;
                this.PipelineStatus = this.PipelineStatus == null ? '--' : this.PipelineStatus;
                this.DocTypeCode = this.DocTypeCode == null ? '--' : this.DocTypeCode;
                this.ShippingCarrier = this.ShippingCarrier == null ? '--' : this.ShippingCarrier;
                this.ShippingServiceType = this.ShippingServiceType == null ? '--' : this.ShippingServiceType;
                this.PrintLocation = this.PrintLocation == null ? '--' : this.PrintLocation;
                switch (this.ShippingStatus) {

                    case "PulledBack":
                        status = '<span class="label medium label-yellow">' + this.ShippingStatus + '</span>';
                        break;
                    case "Error":
                        status = '<span class="label medium label-red">' + this.ShippingStatus + '</span>';
                        break;
                    case "Shipped":
                        status = '<span class="label medium label-success">' + this.ShippingStatus + '</span>';
                        break;
                    case "InProgress":
                        status = '<span class="label medium label-blue">' + this.ShippingStatus + '</span>';
                        break;
                    default:
                        status = '--';

                }
                this.ShippingStatus = status;
            });

            return Model;
        }
        function FormatMailPieceObject(Model) {
            $(Model).each(function () {
                this.ReceivedOn = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.UniqueId = this.UniqueId == null ? "--" : this.UniqueId;

                switch (this.ShippingStatus) {

                    case "PulledBack":
                        status = '<span class="label medium label-yellow">' + this.ShippingStatus + '</span>';

                        break;
                    case "Error":
                        status = '<span class="label medium label-red">' + this.ShippingStatus + '</span>';
                        break;
                    case "Shipped":
                        status = '<span class="label medium label-success">' + this.ShippingStatus + '</span>';
                        break;
                    case "InProgress":
                        status = '<span class="label medium label-blue">' + this.ShippingStatus + '</span>';
                        break;
                    default:
                        status = '--';

                }
                this.ShippingStatus = status;
            });
            return Model;
        }
        function shortName(str) {
            if (typeof str != 'undefined' && str != null && str != "")
                return str.length > 31 ? str.substring(0, 31) + '...' : str;
        }
        function FilterData() {
            $("#supportHeader").hide();
            //$("#supportMailBatchesList").hide();
            var el = $('#supportMailBatchesList');
            $("#loading").show();
            $.ajax({
                type: "GET",
                url: baseUrl + "api/alert/GetDelayedBatches",
                data: { cutOff: 30 },
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response != null) {
                        if (response.Status == 'red') {
                            $('#statustitle').addClass('text-danger');
                            $('#statustitle').html('<i class="fa fa-exclamation-triangle"></i> ' + $('#statustitle').html());
                        }
                        else {
                            $('#statustitle').addClass('text-success');
                            $('#statustitle').html('<i class="fa fa-check-circle"></i> ' + $('#statustitle').html());
                        }
                        if (response.MinHour > 0) {
                            if (response.MinHour == response.MaxHour) {
                                var msg = "Estimated fixing time minimum {0} hrs remaining";
                                $('#remainingminmaxtime').html(msg.replace("{0}", response.MinHour));
                            }
                            else {
                                var msg = "Estimated fixing time minimum {0} hrs and maximum {1} hrs remaining";
                                $('#remainingminmaxtime').html(msg.replace("{0}", response.MinHour).replace("{1}", response.MaxHour));
                            }
                            $('#remainingminmaxtime').removeClass('hidden');
                            $('#remainingminmaxtime').show();
                        }
                        else {
                            $('#remainingminmaxtime').hide();
                        }
                        $("#loading").hide();
                        $("#supportHeader").show();
                        //$("#supportMailBatchesList").show();
                        //All Mail Batches
                        if (response.DelayedBatches.length > 0) {
                            //$("#supportMailBatchesList").html("");
                            mailpiecesByBatch = response.DelayedBatches;
                            var data = FormatObject(response.DelayedBatches);
                            BindTemplate(data, "#supportBody", "#supportbodyContent", "#supportTableContent", "#supportMailBatchesList");
                            window.clui.tooltipInit();
                        }
                        else {
                            $("#supportMailBatchesList").html(" <div style='margin-bottom:10px;' class='alert alert-green '><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>")
                        }
                        if (response.AppCodeCountByBatch != null && response.AppCodeCountByBatch.length > 0) {
                            var dispText = "";
                            $.each(response.AppCodeCountByBatch, function (i, v) {
                                var lbl = '<button class="btn btn-primary btn-sm viewbatch" data-appcode=' + v['AppCode'] + ' style="margin-left:5px">' + v['AppCode'] + '  <span class="label label-blue"style="margin:0px;background-color:white;color:black">' + v['Total'] + '</span></button>';
                                dispText = dispText + lbl;
                            });
                            $('#ClientWiseBatchCount').html(dispText);
                            GetBatchByClient();
                        }
                        //All MailPieces
                        if (response.DelayedMailPieces.length > 0) {
                            //console.log(response.DelayedMailPieces);
                            allmailpieces = response.DelayedMailPieces;
                            var mdata = FormatObjectMP(response.DelayedMailPieces);
                            BindTemplateWithDataTable(mdata, "#delayedmailpiecesbody", "#delayedbatchmailpiecesbodyContent", "#delayedbatchmailpiecesContent", "#supportMailPiecesList", 'DelayedMPsDatatable', 'delayedmailpieces', 'Delayed MailPieces');
                            //window.clui.tooltipInit();

                        } else {
                            $("#supportMailPiecesList").html(" <div style='margin-bottom:10px;' class='alert alert-green '><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>")
                        }
                        if (response.AppCodeCountByMailPiece != null && response.AppCodeCountByMailPiece.length > 0) {
                            var dispText = "";
                            $.each(response.AppCodeCountByMailPiece, function (i, v) {
                                var lbl = '<button class="btn btn-primary btn-sm viewmps" data-appcode=' + v['AppCode'] + ' style="margin-left:5px">' + v['AppCode'] + '  <span class="label label-blue"style="margin:0px;background-color:white;color:black">' + v['Total'] + '</span></button>';
                                dispText = dispText + lbl;
                            });
                            $('#ClientWiseMailPieceCount').html(dispText);
                            GetMailPiecesByClient();
                        }
                    }

                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#loading").hide();
                    $("#supportHeader").show();
                    $("#supportMailBatchesList").show();
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    $("#supportMailBatchesList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                }

            });
        }

        function ViewDetails(obj) {
            var batchId = $(obj).data("batchid");

            $("#databind").html("");
            $("#ViewInfo").modal("show");
            $("#loadingModal").show();
            var MPs = {};
            jQuery.grep(mailpiecesByBatch, function (i, v) {
                if (i['Id'] == obj) {
                    MPs = i['DelayedMailPieces'];
                }
            });
            $("#loadingModal").hide();
            $("#showerror").hide();
            var data = FormatMailPieceObject(MPs);
            BindTemplateWithOutDatatable(MPs, "#delayedmailpiecesbodymodal", "#delayedbatchmailpiecesbodyContentmodal", "#delayedbatchmailpiecesContentmodal", "#databind");
            $('[data-toggle="popover"]').popover({
                'trigger': 'hover',
                'placement': 'auto left',
                'container': 'body'
            });
            window.clui.tooltipInit();
            $("#ViewInfo").modal("show");
            setModalHeight("ViewInfo");

        }
        function setModalHeight(id) {
            var count = $("#" + id).find("tr").length;//.find(".modal-body").height();
            if (count > 5) {
                $("#" + id).find(".modal-body").height(window.screen.height - 450);
                $("#" + id).find(".modal-body").css("overflow-y", "scroll");
            }
            else {
                $("#" + id).find(".modal-body").height('auto');

            }

        }
    </script>
}

