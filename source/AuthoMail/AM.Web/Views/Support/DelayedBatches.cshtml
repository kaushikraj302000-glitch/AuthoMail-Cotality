@{
    ViewBag.Title = "DelayedBatches";
}
<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<style>
    #dateFilter .bootstrap-select {
        width: 100% !important;
    }

    .bootstrap-select {
        width: 205px !important;
    }

    .popover-content {
        word-wrap: break-word;
        color: red;
    }

    .dataTables_wrapper {
        margin-top: -1.3% !important;
    }
</style>
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <div class="panel-title">
                <a role="button" data-toggle="collapse" data-parent="#accordion" href="#metaItem1">
                    <span id="statustitle">Delayed Packages</span>
                </a>
                <button class="btn btn-warning active" type="button" id="supportMailBatchesListBtn">Grouped by Batch</button>
                <button class="btn btn-warning" type="button" id="supportMailPiecesListBtn">All Mail Pieces</button>
            </div>
        </div>
        <div class="panel-collapse collapse in">
            <div class="panel-body">
                <div id="remainingminmaxtime" class="alert alert-blue hidden" role="alert"></div>
                <div id="ClientWiseBatchCount" style="padding:10px 0px"></div>
                <div id="ClientWiseMailPieceCount" class="hidden" style="padding:10px 0px"></div>
                <div class="clearfix">
                    <div id="supportMailBatchesList">
                        <div class="alert-blue alert text-center">
                            <span>Please Wait...</span>
                        </div>
                    </div>
                    <div class="hidden" id="supportMailPiecesList">
                        <div class="alert-blue alert text-center">
                            <span>Please Wait...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- table html template code -->
<div id="supportTableContent" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                <th>Batch Id</th>
                <th>Batch Name</th>
                <th>AppCode</th>
                <th>Pipeline Status</th>
                <th>Client Id</th>
                <th>Received Date <span class="fontcapitalize">(Local)</span></th>
                <th>Delayed MailPieces</th>
            </tr>
        </thead>
        <tbody id="supportbodyContent"></tbody>
    </table>
</div>
<div style="display:none">
    <table>
        <tbody id="supportBody">
            <tr class="row-small">
                <td>{BatchId}</td>
                <td>{BatchName}</td>
                <td>{AppCode}</td>
                <td>{PipelineStatus}</td>
                <td>{ClientId}</td>
                <td>{ReceivedOn}</td>
                <td>{TotalDelayedMailPieces}</td>
            </tr>
        </tbody>

    </table>
</div>
<div id="delayedbatchmailpiecesContent" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                <th><span>Id</span></th>
                <th><span>UniqueId</span></th>
                <th><span>AppCode</span></th>
                <th><span>BatchName</span></th>
                <th><span class="fontcapitalize">ReceivedOn</span></th>
                <th><span>PipelineStatus</span></th>
                <th><span>ShippingStatus</span></th>
                <th><span>DocTypeCode</span></th>
                <th><span>ShippingCarrier</span></th>
                <th><span>ShippingServiceType</span></th>
                <th><span>ClientId</span></th>
                <th><span>PrintLocation</span></th>
            </tr>
        </thead>
        <tbody id="delayedbatchmailpiecesbodyContent"></tbody>
    </table>
</div>
<div style="display:none">
    <table>
        <tbody id="delayedmailpiecesbody">
            <tr class="row-small">
                <td><span>{Id}</span></td>
                <td><span>{UniqueId}</span></td>
                <td><span>{AppCode}</span></td>
                <td><span>{BatchName}</span></td>
                <td><span>{ReceivedOn}</span></td>
                <td><span>{PipelineStatus}</span></td>
                <td><span>{ShippingStatus}</span></td>
                <td><span>{DocTypeCode}</span></td>
                <td><span>{ShippingCarrier}</span></td>
                <td><span>{ShippingServiceType}</span></td>
                <td><span>{ClientId}</span></td>
                <td><span>{PrintLocation}</span></td>
            </tr>
        </tbody>
    </table>
</div>

<div id="delayedbatchmailpiecesContentmodal" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                <th><span>Id</span></th>
                <th><span>UniqueId</span></th>
                <th><span>AppCode</span></th>
                <th><span>BatchName</span></th>
                <th><span class="fontcapitalize">ReceivedOn</span></th>
                <th><span>PipelineStatus</span></th>
                <th><span>ShippingStatus</span></th>
                <th><span>DocTypeCode</span></th>
                <th><span>ShippingCarrier</span></th>
                <th><span>ShippingServiceType</span></th>
                <th><span>ClientId</span></th>
                <th><span>PrintLocation</span></th>
            </tr>
        </thead>
        <tbody id="delayedbatchmailpiecesbodyContentmodal"></tbody>
    </table>
</div>
<div style="display:none">
    <table>
        <tbody id="delayedmailpiecesbodymodal">
            <tr class="row-small">
                <td><span>{Id}</span></td>
                <td><span>{UniqueId}</span></td>
                <td><span>{AppCode}</span></td>
                <td><span>{BatchName}</span></td>
                <td><span>{ReceivedOn}</span></td>
                <td><span>{PipelineStatus}</span></td>
                <td><span>{ShippingStatus}</span></td>
                <td><span>{DocTypeCode}</span></td>
                <td><span>{ShippingCarrier}</span></td>
                <td><span>{ShippingServiceType}</span></td>
                <td><span>{ClientId}</span></td>
                <td><span>{PrintLocation}</span></td>
            </tr>
        </tbody>
    </table>
</div>
<div class="modal fade" id="ViewInfo" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg col-md-12" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">MailPiece Details</h1>
                <hr />
            </div>
            <div class="modal-body">
                <div id="showerror" style="display:none"></div>
                <div class='alert alert-blue text-center' id="loadingModal" style="display:none"><span> Loading... </span></div>
                <div class="row" id="databind" style="overflow:scroll">

                </div>
            </div>
            <div class="modal-footer">
                <hr />
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>

            </div>
        </div>
    </div>
</div>


