@{
    ViewBag.Title = "DelayedBatches";
}
<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<style>
    #dateFilter .bootstrap-select {
        width: 100% !important;
    }

    .bootstrap-select {
        width: 205px !important;
    }

    .popover-content {
        word-wrap: break-word;
        color: red;
    }
</style>
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#metaItem1">
                <div class="panel-title">
                    Delayed MailBatches
                </div>
            </a>
        </div>
        <div class="panel-collapse collapse in">
            <div class="panel-body">
                <div class="panel-body" id="supportMailBatchesList"></div>


            </div>
        </div>
    </div>

</div>

<!-- table html template code -->
<div id="supportTableContent" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                <th>Batch Id</th>
                <th>Batch Name</th>
                <th>AppCode</th>
                <th>Pipeline Status</th>
                <th>Client Id</th>
                <th>Received Date <span class="fontcapitalize">(Local)</span></th>
                <th>Delayed MailPieces</th>
            </tr>
        </thead>
        <tbody id="supportbodyContent"></tbody>
    </table>
</div>
<div style="display:none">
    <table>
        <tbody id="supportBody">
            <tr class="row-small">
                <td><span>{Id}</span></td>
                <td><span>{BatchName}</span></td>
                <td><span>{AppCode}</span></td>
                <td><span>{PipelineStatus}</span></td>
                <td><span>{ClientId}</span></td>
                <td><span>{ReceivedOn}</span></td>
                <td><span>{DelayedMailPieces}</span></td>
            </tr>
        </tbody>

    </table>
</div>
<div id="delayedbatchmailpiecesContent" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                <td><span>Id</span></td>
                <td><span>UniqueId</span></td>
                <td><span>IsSubmitted</span></td>
                <td><span>AppCode</span></td>
                <td><span>BatchName</span></td>
                <td><span class="fontcapitalize">ReceivedOn</span></td>
                <td><span>PipelineStatus</span></td>
                <td><span>ShippingStatus</span></td>
                <td><span>DocTypeCode</span></td>
                <td><span>ShippingCarrier</span></td>
                <td><span>ShippingServiceType</span></td>
                <td><span>ClientId</span></td>
                <td><span>PrintLocation</span></td>
            </tr>
        </thead>
        <tbody id="delayedbatchmailpiecesbodyContent"></tbody>
    </table>
</div>

<div style="display:none">
    <table>
        <tbody id="delayedmailpiecesbody">
            <tr class="row-small">
                <td><span>{Id}</span></td>
                <td><span>{UniqueId}</span></td>
                <td><span>{IsSubmitted}</span></td>
                <td><span>{AppCode}</span></td>
                <td><span>{BatchName}</span></td>
                <td><span>{ReceivedOn}</span></td>
                <td><span>{PipelineStatus}</span></td>
                <td><span>{ShippingStatus}</span></td>
                <td><span>{DocTypeCode}</span></td>
                <td><span>{ShippingCarrier}</span></td>
                <td><span>{ShippingServiceType}</span></td>
                <td><span>{ClientId}</span></td>
                <td><span>{PrintLocation}</span></td>
            </tr>
        </tbody>
    </table>
</div>
<div class="modal fade" id="ViewInfo" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg col-md-12" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">MailPiece Details</h1>
                <hr />
            </div>
            <div class="modal-body">
                <div id="showerror" style="display:none"></div>
                <div class='alert alert-blue text-center' id="loadingModal" style="display:none"><span> Loading... </span></div>
                <div class="row" id="databind">

                </div>
            </div>
            <div class="modal-footer">
                <hr />
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script type="text/javascript">
        var mailpiecesList = null;
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            FilterData();
        });

        function applyDataTable() {
            $('[data-toggle="popover"]').popover({
                'trigger': 'hover',
                'placement': 'auto left',
                'container': 'body'
            });
            var table = $('#sample_2');
            var filename = "DelayedMailBatches";
            var title = "Delayed MailBatches";
            var oTable = table.dataTable({

                "language": {
                    "aria": {
                        "sortAscending": ": activate to sort column ascending",
                        "sortDescending": ": activate to sort column descending"
                    },
                    "emptyTable": "No data available in table",
                    "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                    "infoEmpty": "No entries found",
                    "infoFiltered": "(filtered1 from _MAX_ total entries)",
                    "lengthMenu": "_MENU_ entries",
                    "search": "<b>Search:</b>",
                    "zeroRecords": "No matching records found"
                },
                "columnDefs": [
                        {
                            "targets": ["Id"],
                            "visible": false,
                            "searchable": true
                        },
                ],
                "scrollX": true,
                buttons: [
                    //{
                    //    extend: 'colvis',
                    //    text: 'Select Fields',
                    //    className: 'btn purple pull-left',
                    //    columns: ':not(.noVis)'
                    //},
                {
                    extend: 'csv',
                    text: '<i class="fa fa-file-excel-o fa-2x"></i>',
                    className: 'btn btn-primary',
                    filename: filename,
                    title: title,
                    exportOptions: {
                        //columns: "thead th:not(.BatchId)",
                    }

                }


                ],

                "order": [
                    [8, 'desc']
                ],
                "lengthMenu": [
                    [5, 10, 25, 50, 100, -1],
                    [5, 10, 25, 50, 100, "All"] // change per page values here
                ],
                // set the initial value
                "pageLength": 5,

                "dom": "<'row' <'col-md-12'B>><'row'<'col-md-6 col-sm-12'l><'col-md-6 col-sm-12'f>r><'table-scrollable't><'row'<'col-md-5 col-sm-12'i><'col-md-7 col-sm-12'p>>", // horizobtal scrollable datatable


            });
            $('.selectpicker').selectpicker('refresh');
            $('#BatchList').on('change', function () {
                var oTable = $('#sample_2').dataTable();
                var filterColumn = oTable.api().column(".BatchId").index();
                var selected = $(this).find("option:selected").val();
                if (!selected) {

                    oTable.fnFilter('', filterColumn, true);
                } else {
                    oTable.fnFilter("^" + parseInt(selected) + "$", filterColumn, true); //Exact value, column, reg
                }
            });
        }
        function FormatObject(Model) {
            $(Model).each(function () {
                this.ShortMailBatchName = shortName(this.BatchName);
                this.Id = '<a  data-batchid="' + this.Id + '" onclick="ViewDetails(this)" class="btn btn-transparent-blue btn-sm" >' + this.Id + '</a>';
                // this.TotalPages = this.Status == "Shipped" ? this.TotalPages : 0;
                this.ReceivedOn = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.DelayedMailPieces = this.DelayedMailPieces.length;
                //this.DownloadedOn = this.DownloadedOn == null ? "--" : moment(this.DownloadedOn).format("MM/DD/YY HH:mm:ss");
                //var eddDesc = '<span id="popoverError" data-toggle="popover" data-original-title="Error Code: <ErrorCode>" data-html="true" data-content="<dataContent>" data-placement="left"><a> <ErrorCode> </a></span>'.replace(/<ErrorCode>/g, this.ValidationStatus).replace("<dataContent>", this.ValidationErrors == null ? "--" : this.ValidationErrors);
                //this.ValidationErrors = this.ValidationErrors == null ? '--' : eddDesc;

            });

            return Model;
        }
        function FormatMailPieceObject(Model) {
            $(Model).each(function () {
                this.ReceivedOn = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.UniqueId = this.UniqueId == null ? "--" : this.UniqueId;
                //this.EffectiveReceivedOnEst = this.EffectiveReceivedOnEst == null ? "--" : moment(this.EffectiveReceivedOnEst).format("MM/DD/YY HH:mm:ss");
                //this.PrintedOn = this.PrintedOn == null ? "--" : moment(this.PrintedOn).format("MM/DD/YY HH:mm:ss");
                // var eddDesc = '<span id="popoverError" data-toggle="popover" data-original-title="Error Code: <ErrorCode>" data-html="true" data-content="<dataContent>" data-placement="left"><a> <ErrorCode> </a></span>'.replace(/<ErrorCode>/g, this.ErrorCode).replace("<dataContent>", this.ErrorDesc == null ? "--" : this.ErrorDesc);
                //this.ErrorDescPopover = this.ErrorCode == "No_Error" ? '<span>' + this.ErrorCode + '</span>' : eddDesc;

                switch (this.ShippingStatus) {

                    case "PulledBack":
                        status = '<span class="label medium label-yellow">' + this.ShippingStatus + '</span>';

                        break;
                    case "Error":
                        status = '<span class="label medium label-red">' + this.ShippingStatus + '</span>';
                        break;
                    case "Shipped":
                        status = '<span class="label medium label-success">' + this.ShippingStatus + '</span>';
                        break;
                    case "InProgress":
                        status = '<span class="label medium label-blue">' + this.ShippingStatus + '</span>';
                        break;

                }
                this.ShippingStatus = status;
            });
            return Model;
        }
        function shortName(str) {
            if (typeof str != 'undefined' && str != null && str != "")
                return str.length > 31 ? str.substring(0, 31) + '...' : str;
        }
        function FilterData() {
            $("#supportHeader").hide();
            $("#supportMailBatchesList").hide();
            //var date = $("#date").val();
            var el = $('#supportMailBatchesList');
            //$("#headerdate").html(date + " EST");
            $("#loading").show();
            $.ajax({
                type: "GET",
                url: baseUrl + "api/alert/GetPendingBatches",
                data: { cutOff: 30 },
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response != null) {
                        $("#loading").hide();
                        $("#supportHeader").show();
                        $("#supportMailBatchesList").show();
                        if (response.DelayedBatches.length > 0) {
                            $("#supportMailBatchesList").html("");
                            mailpiecesList = response.DelayedBatches;
                            var data = FormatObject(response.DelayedBatches);
                            BindTemplate(data, "#supportBody", "#supportbodyContent", "#supportTableContent", "#supportMailBatchesList");
                            window.clui.tooltipInit();
                        }
                        else {
                            $("#supportMailBatchesList").html(" <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>")
                        }
                    }

                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#loading").hide();
                    $("#supportHeader").show();
                    $("#supportMailBatchesList").show();
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    $("#supportMailBatchesList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                }

            });
        }

        function ViewDetails(obj) {
            var batchId = $(obj).data("batchid");

            $("#databind").html("");
            $("#ViewInfo").modal("show");
            $("#loadingModal").show();
            console.log("mailpiecesList:" + mailpiecesList);
            var MPs = jQuery.grep(JSON.stringify(mailpiecesList), function (i, v) {
                // console.log(JSON.stringify(v.Id));
                if (v.Id == obj) {
                    return v.DelayedMailPieces;
                }
            });
            console.log(JSON.stringify(MPs));
            $("#loadingModal").hide();
            $("#showerror").hide();
            var data = FormatMailPieceObject(MPs);
            BindTemplateWithOutDatatable(data, "#delayedmailpiecesbody", "#delayedbatchmailpiecesbodyContent", "#delayedbatchmailpiecesContent", "#databind");
            $('[data-toggle="popover"]').popover({
                'trigger': 'hover',
                'placement': 'auto left',
                'container': 'body'
            });
            window.clui.tooltipInit();
            $("#ViewInfo").modal("show");
            setModalHeight("ViewInfo");

        }
        function setModalHeight(id) {
            var count = $("#" + id).find("tr").length;//.find(".modal-body").height();
            if (count > 5) {
                $("#" + id).find(".modal-body").height(window.screen.height - 450);
                $("#" + id).find(".modal-body").css("overflow-y", "scroll");
            }
            else {
                $("#" + id).find(".modal-body").height('auto');

            }

        }
    </script>
}

