        function FormatObject(Model) {
            $(Model).each(function () {
                this.ShortMailBatchName = shortName(this.BatchName);
                this.BatchId = '<a  data-batchid="' + this.Id + '" onclick="ViewDetails(' + this.Id + ')" class="btn btn-transparent-blue btn-sm" >' + this.Id + '</a>';
                // this.TotalPages = this.Status == "Shipped" ? this.TotalPages : 0;
                this.ReceivedOn = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.TotalDelayedMailPieces = this.DelayedMailPieces.length;
                this.ClientId = this.ClientId == null ? '--' : this.ClientId;
                this.UniqueId = this.UniqueId == null ? "--" : this.UniqueId;
            });

            return Model;
        }
        function FormatObjectMP(Model) {
            $(Model).each(function () {
                this.ClientId = this.ClientId == null ? '--' : this.ClientId;
                this.UniqueId = this.UniqueId == null ? '--' : this.UniqueId;
                this.AppCode = this.AppCode == null ? '--' : this.AppCode;
                this.ReceivedOn = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.BatchName = this.BatchName == null ? '--' : this.BatchName;
                this.PipelineStatus = this.PipelineStatus == null ? '--' : this.PipelineStatus;
                this.DocTypeCode = this.DocTypeCode == null ? '--' : this.DocTypeCode;
                this.ShippingCarrier = this.ShippingCarrier == null ? '--' : this.ShippingCarrier;
                this.ShippingServiceType = this.ShippingServiceType == null ? '--' : this.ShippingServiceType;
                this.PrintLocation = this.PrintLocation == null ? '--' : this.PrintLocation;
                switch (this.ShippingStatus) {

                    case "PulledBack":
                        status = '<span class="label medium label-yellow">' + this.ShippingStatus + '</span>';
                        break;
                    case "Error":
                        status = '<span class="label medium label-red">' + this.ShippingStatus + '</span>';
                        break;
                    case "Shipped":
                        status = '<span class="label medium label-success">' + this.ShippingStatus + '</span>';
                        break;
                    case "InProgress":
                        status = '<span class="label medium label-blue">' + this.ShippingStatus + '</span>';
                        break;
                    default:
                        status = '--';

                }
                this.ShippingStatus = status;
            });

            return Model;
        }
        function FormatMailPieceObject(Model) {
            $(Model).each(function () {
                this.ReceivedOn = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.UniqueId = this.UniqueId == null ? "--" : this.UniqueId;

                switch (this.ShippingStatus) {

                    case "PulledBack":
                        status = '<span class="label medium label-yellow">' + this.ShippingStatus + '</span>';

                        break;
                    case "Error":
                        status = '<span class="label medium label-red">' + this.ShippingStatus + '</span>';
                        break;
                    case "Shipped":
                        status = '<span class="label medium label-success">' + this.ShippingStatus + '</span>';
                        break;
                    case "InProgress":
                        status = '<span class="label medium label-blue">' + this.ShippingStatus + '</span>';
                        break;
                    default:
                        status = '--';

                }
                this.ShippingStatus = status;
            });
            return Model;
        }
