<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading addon" id="headingOne">
            <div class="panel-title">
                <span id="statustitle">Delayed Packages</span>
                <div class="addon-content">
                    <ul class="nav nav-pills">
                        <li class="active">
                            <a href="#processbody" data-toggle="tab">Process</a>
                        </li>
                        <li>
                            <a href="#printerbody" data-toggle="tab">Printer</a>
                        </li>
                        <li>
                            <a href="#reportingbody" data-toggle="tab">Reporting</a>
                        </li>
                        <li>
                            <a href="#pickupbody" data-toggle="tab">Pickup</a>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
        <div class="panel-collapse collapse in">
            <div class="panel-body">
                <div class="tab-content clearfix">
                    <div class="tab-pane active" id="processbody">
                        <ul class="nav nav-pills">
                            <li class="active">
                                <a href="#processbatchbody" data-toggle="tab">Batch</a>
                            </li>
                            <li>
                                <a href="#processmailpiecebody" data-toggle="tab">Mailpiece</a>
                            </li>
                        </ul>
                        <div class="tab-content clearfix">
                            <div class="tab-pane active" id="processbatchbody">
                                <div class="alert-blue alert text-center">
                                    <span>Please Wait...</span>
                                </div>
                            </div>
                            <div class="tab-pane" id="processmailpiecebody">
                                <div class="alert-blue alert text-center">
                                    <span>Please Wait...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="printerbody">
                        <ul class="nav nav-pills">
                            <li class="active">
                                <a href="#printerbatchbody" data-toggle="tab">Batch</a>
                            </li>
                            <li>
                                <a href="#printermailpiecebody" data-toggle="tab">Mailpiece</a>
                            </li>
                        </ul>
                        <div class="tab-content clearfix">
                            <div class="tab-pane active" id="printerbatchbody">
                                <div class="alert-blue alert text-center">
                                    <span>Please Wait...</span>
                                </div>
                            </div>
                            <div class="tab-pane" id="printermailpiecebody">
                                <div class="alert-blue alert text-center">
                                    <span>Please Wait...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="reportingbody">
                        <ul class="nav nav-pills">
                            <li class="active">
                                <a href="#reportingbatchbody" data-toggle="tab">Batch</a>
                            </li>
                            <li>
                                <a href="#reportingmailpiecebody" data-toggle="tab">Mailpiece</a>
                            </li>
                        </ul>
                        <div class="tab-content clearfix">
                            <div class="tab-pane active" id="reportingbatchbody">
                                <div class="alert-blue alert text-center">
                                    <span>Please Wait...</span>
                                </div>
                            </div>
                            <div class="tab-pane" id="reportingmailpiecebody">
                                <div class="alert-blue alert text-center">
                                    <span>Please Wait...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="pickupbody">
                        <ul class="nav nav-pills">
                            <li class="active">
                                <a href="#pickupmailpiecebodymain" data-toggle="tab">Mailpiece</a>
                            </li>

                        </ul>
                        <div class="tab-content clearfix">
                            <div class="tab-pane active" id="pickupmailpiecebodymain">
                                <div class="alert-blue alert text-center">
                                    <span>Please Wait...</span>
                                </div>
                            </div>
