            var ButtonEvent = function () {
                $('#supportMailBatchesListBtn').click(function (e) {
                    e.preventDefault();
                    $('#supportMailBatchesListBtn').addClass('active');
                    $('#supportMailPiecesListBtn').removeClass('active');
                    $('#supportMailBatchesList').removeClass('hidden');
                    $('#supportMailPiecesList').addClass('hidden');
                    $('#ClientWiseMailPieceCount').addClass('hidden');
                    $('#ClientWiseBatchCount').removeClass('hidden');
                });
                $('#supportMailPiecesListBtn').click(function (e) {
                    e.preventDefault();
                    $('#supportMailPiecesListBtn').addClass('active');
                    $('#supportMailBatchesListBtn').removeClass('active');
                    $('#supportMailBatchesList').addClass('hidden');
                    $('#supportMailPiecesList').removeClass('hidden');
                    $('#ClientWiseMailPieceCount').removeClass('hidden');
                    $('#ClientWiseBatchCount').addClass('hidden');
                });
            }
            ButtonEvent();

        });
        var GetBatchByClient = function () {
            $('.viewbatch').unbind('click');
            $('.viewbatch').bind('click', function (e) {
                var appCode = $(this).data('appcode');
                var table = $('#sample_2').DataTable();
                table.columns(2).search(appCode).draw();
                if ($(this).hasClass('check')) {
                    $(this).removeClass('check');
                    var ht = $(this).html();
                    $(this).html(ht.replace('<i class="fa fa-check"></i>', ''));
                    table.columns(2).search('').draw();
                }
                else {
                    $.each($('#ClientWiseBatchCount').find('.check'), function (i, v) {
                        if ($(v).data('appcode') != appCode) {
                            $(v).removeClass('check');
                            $(v).html($(v).html().replace('<i class="fa fa-check"></i>', ''));
                        }
                    });
                    $(this).addClass('check');
                    var ht = $(this).html();
                    $(this).html(ht + ' <i class="fa fa-check"></i>');
                    table.columns(2).search(appCode).draw();
                }
            });
        }
        var GetMailPiecesByClient = function () {
            $('.viewmps').unbind('click');
            $('.viewmps').bind('click', function (e) {
                var appCode = $(this).data('appcode');
                var table = $('#DelayedMPsDatatable').DataTable();
                if ($(this).hasClass('check')) {
                    $(this).removeClass('check');
                    var ht = $(this).html();
                    $(this).html(ht.replace('<i class="fa fa-check"></i>', ''));
                    table.columns(2).search('').draw();
                }
                else {
                    $.each($('#ClientWiseMailPieceCount').find('.check'), function (i, v) {
                        if ($(v).data('appcode') != appCode) {
                            $(v).removeClass('check');
                            $(v).html($(v).html().replace('<i class="fa fa-check"></i>', ''));
                        }
                    });
                    $(this).addClass('check');
                    var ht = $(this).html();
                    $(this).html(ht + ' <i class="fa fa-check"></i>');
                    table.columns(2).search(appCode).draw();
                }
            });
        }
