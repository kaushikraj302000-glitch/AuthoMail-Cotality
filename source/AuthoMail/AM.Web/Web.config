  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IUSPSIM" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost:11721/USPSIM.svc" binding="basicHttpBinding"
        bindingConfiguration="BasicHttpBinding_IUSPSIM" contract="USPSIMService.IUSPSIM"
