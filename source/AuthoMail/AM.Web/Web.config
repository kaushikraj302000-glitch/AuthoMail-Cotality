<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <!--<add name="AuthoMail" connectionString="Data Source=(LocalDb)\mssqllocaldb;Initial Catalog=AuthoMail_UAT;Integrated Security=True" providerName="System.Data.SqlClient" />-->
    <add name="AuthoMail" connectionString="Data Source=MSTC-OB\apos;Initial Catalog=AuthoMail_UAT;Persist Security Info=True;User ID=sa;Password=Anant@ob" providerName="System.Data.SqlClient" />
    <!--<add name="AuthoMail" connectionString="Data Source=10.212.40.106;Initial Catalog=AuthoMail;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;pooling=true;" providerName="System.Data.SqlClient" />-->
    <!--<add name="AuthoMail" connectionString="Data Source=10.215.176.81;Initial Catalog=AuthoMail_UAT;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;pooling=true;" providerName="System.Data.SqlClient" />-->
  </connectionStrings>
  <log4net>
    <root>
      <level value="ALL" />
      <appender-ref ref="Web" />
    </root>

    <!--Define some output appenders-->
    <appender name="Web" type="log4net.Appender.RollingFileAppender">
      <file value="E:\\" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <!--<datePattern type="log4net.Util.PatternString" value="'logs'\\'Web-'yyyyMMdd'-%processid.log'" />-->
      <datePattern type="log4net.Util.PatternString" value="'logs'\\'Web-'yyyyMMdd'-%property{args}.log'" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <header value="[APP START]%newline" type="log4net.Util.PatternString" />
        <footer value="[APP END]%newline" type="log4net.Util.PatternString" />
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>
  </log4net>
  <system.net>
    <mailSettings>
      <!--<smtp deliveryMethod="Network" from="donotreply@corelogic.com">
        <network host="smtp.corelogic.com" defaultCredentials="true" />
      </smtp>-->
      <smtp deliveryMethod="Network"  from="donotreply@milestonetechnoconsulting.com">
        <network host="smtp.office365.com" userName="donotreply@milestonetechnoconsulting.com" password="Mstc@123" enableSsl="true" port="587" />
      </smtp>
    </mailSettings>
  </system.net>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="FontsDirPath" value="~\fonts"/>
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="ScannerUrl" value=""/>
  </appSettings>
  <system.web>
    <authentication mode="None" />
    <compilation debug="true" targetFramework="4.5.2" />
    <httpRuntime targetFramework="4.5.2" maxRequestLength="3048576" />
  </system.web>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlCustom="public" cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff" mimeType="application/x-font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>
    <modules>
      <remove name="FormsAuthentication" />
    </modules>

    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin.Security" publicKeyToken="31bf3856ad364e35" />
