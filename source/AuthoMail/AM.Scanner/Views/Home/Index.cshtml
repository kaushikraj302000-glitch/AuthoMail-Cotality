                    }
                }
                //if (clientCode == 'USAA' || clientCode == 'AUTUSAA') {
                //    var btName = "USAA Adverse Action 07PM";
                //    $("#displaycount" + clientCode).append("<a href='Scan/SingleScan?clientCode=" + clientCode + "&batchName=07PM'><pre  class='pull-right preclass'><strong class='text-larger'>" + btName + "</></strong></pre></a>");
