<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
	</startup>
	<connectionStrings>
		<!--<add name="AuthoMail" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=AuthoMail_New;Integrated Security=True;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />-->
		<!--<add name="AuthoMail" connectionString="Data Source=10.215.176.81;Initial Catalog=AuthoMail_UAT;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;;pooling=true;" providerName="System.Data.SqlClient" />-->
		<add name="AuthoMail" connectionString="Data Source=10.212.40.106;Initial Catalog=AuthoMail;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;;pooling=true;" providerName="System.Data.SqlClient" />
		<add name="Delfus" connectionString="Data Source=10.212.40.106;Initial Catalog=DELFUSLetters;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;pooling=true;" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="log4net.Config" value="log4net.config" />
		<add key="log4net.Config.Watch" value="True" />
		<add key="SummaryNotificationSubject" value="Summary Control Report " />
		<add key="SummaryNotification_Email_To" value="sgolvelkar@corelogic.com" />
		<add key="SummaryNotification_Email_Cc" value="sgolvelkar@corelogic.com" />

		<!--FedEx Configuration-->
		<add key="FedExDeployment" value="2018-08-13" />
		<add key="FedExAccountCode" value="CL_STAGING" />
		<add key="FedExReportSubject" value="Daily FedEx Report For : " />
		<add key="FedExReport_Email_To" value="sgolvelkar@corelogic.com" />
		<add key="FedExReport_Email_Cc" value="sgolvelkar@corelogic.com" />
		<add key="FedExFullReportTiming" value="22:00" />

		<!--Dallas Configuration-->
		<add key="DallasEMailTo" value="sgolvelkar@corelogic.com" />
		<add key="DallasEMailCc" value="sgolvelkar@corelogic.com" />
		<add key="DallasEMailSubject" value="Dallas Printing Count For " />
		<add key="DallasEMailTemplate" value="../../EmailTemplates/DallasNotification.html" />

		<!--PCIRecon Configuration-->
		<add key="PCIReconEMailTo" value="sgolvelkar@corelogic.com" />
		<add key="PCIReconEMailCc" value="sgolvelkar@corelogic.com" />
		<add key="PCIReconEMailSubject" value="PCI Recon Report For Date {0}" />
		<add key="PCIReconReportPath" value="../../PCIReconReport" />

		<!--DALLASRecon Configuration-->
		<add key="DALLASReconEMailTo" value="avala@corelogic.com" />
		<add key="DALLASReconEMailCc" value="avala@corelogic.com" />
		<add key="DALLASReconEMailSubject" value="DALLAS Recon Report For Date {0}" />
		<add key="DALLASReconReportPath" value="../../DALLASReconReport" />

		<!--USAA Reporting Configuration-->
		<add key="USAAEMailTo" value="sgolvelkar@corelogic.com" />
		<add key="USAAEMailCc" value="avala@corelogic.com" />
		<add key="USAAMonthlyReconEMailSubject" value="USAA Monthly Recon Report From {0} To {1}" />
		<add key="USAAMonthlyReconReportPath" value="../../USAAReport/MonthlyReconReports" />
		<add key="USAAErrorReportEMailSubject" value="USAA Error Report For {0}" />
		<add key="USAAErrorReportPath" value="../../USAAReport/ErrorReports" />
		<add key="USAAWeeklyReportEMailSubject" value="USAA Weekly Report From {0} To {1}" />
		<add key="USAAWeeklyReportPath" value="../../USAAReport/WeeklyReports" />

		<!--USAA MTD Reporting Configuration-->
		<add key="USAAMTDReportPath" value="C:\MTC"/>
		<add key="USAAMTDEmailTo" value="avala@msdgtl.com" />
		<add key="USAAMTDEmailCc" value="avala@msdgtl.com" />

		<!--GOSRecon Configuration-->
		<add key="GOSReconEMailTo" value="sgolvelkar@corelogic.com" />
		<add key="GOSReconEMailCc" value="avala@corelogic.com" />
		<add key="GOSReconEMailSubject" value="GOS Updated Recon Report For Date {0}" />
		<add key="GOSReceivedBatchEMailSubject" value="GOS Received Batch Report For Date {0}" />
		<add key="GOSReconReportPath" value="../../GOSReconReport" />

		<!--GOSRecon Configuration-->
		<add key="GOSDataPointEMailTo" value="sgolvelkar@corelogic.com" />
		<add key="GOSDataPointEMailCc" value="avala@corelogic.com" />
		<add key="GOSDataPointEMailSubject" value="GOS Updated Recon Report For Date {0}" />
		<add key="GOSDataPointEMailTemplate" value="../../EmailTemplates/GOSDataPointNotification.html" />
		<add key="GOSDataPointReportTemplate" value="../../Templates/GOSReporting.xls" />

		<!--GOSDaily Recon Configuration-->
		<add key="GOSDailyDataPointEMailTo" value="GOSMTBANK:sgolvelkar@corelogic.com|INDEPENDENTBANK:sgolvelkar@corelogic.com|BSI:sgolvelkar@corelogic.com|UMPQUA:sgolvelkar@corelogic.com|CALIBER:sgolvelkar@corelogic.com|HOMEPOINT:sgolvelkar@corelogic.com|RUSHMORE:sgolvelkar@corelogic.com|MRCOOPER:sgolvelkar@corelogic.com|ROUNDPOINT:sgolvelkar@corelogic.com,avala@corelogic.com|LOANCARE:sgolvelkar@corelogic.com,avala@corelogic.com" />
		<!--Pattern : {ClientCode:{EmailIds}|}-->
		<add key="GOSDailyDataPointEMailCc" value="avala@corelogic.com" />
		<add key="GOSDailyDataPointEMailTemplate" value="../../EmailTemplates/GOSDailyDataPointNotification.html" />
		<add key="GOSDailyDataPointReportTemplate" value="../../Templates/GOSDailyReporting.xls" />
		<add key="GOSStatusMappingFile" value="../../Templates/StatusMapping.xlsx" />
		<add key="GOSDaily3MonthClientList" value="LOANCARE,HOMEPOINT" />

		<!--Flood Monthly Report Configuration-->
		<add key="FloodMonthlyEMailTo" value="sgolvelkar@corelogic.com" />
		<add key="FloodMonthlyEMailCc" value="avala@corelogic.com" />
		<add key="FloodMonthlyReportPath" value="../../FloodReconReport" />

		<!--Flood CAPONE Error Report Configuration-->
		<add key="CapOneErrorEMailTo" value="sgolvelkar@corelogic.com" />
		<add key="CapOneErrorEMailCc" value="avala@corelogic.com" />
		<add key="CapOneErrorReportPath" value="../../FloodReconReport" />

		<!--Alaska Daily Operation Report Configuration-->
		<add key="AlaskaDailyEMailTo" value="sgolvelkar@corelogic.com" />
		<add key="AlaskaDailyEMailCc" value="avala@corelogic.com" />
		<add key="AlaskaDailyReportPath" value="../../AlaskaReconReport" />

		<!--DELFUS Reporting Configuration-->
		<add key="TaxComEmailTo" value="avala@corelogic.com" />
		<add key="TaxComEmailCc" value="avala@corelogic.com" />
		<add key="TaxComErrorReportEmailSubject" value="TaxCommercial Error Report For {0}" />
		<add key="TaxComErrorReportPath" value="../../TaxComReport/ErrorReports" />


		<!--AMPostageRecon Configuration-->
		<add key="AMPostageReconEMailTo" value="sgolvelkar@corelogic.com" />
		<add key="AMPostageReconEMailCc" value="avala@corelogic.com" />
		<add key="AMPostageReconEMailSubject" value="GOS Updated Recon Report For Date {0}" />
		<add key="AMPostageReconReportPath" value="../../GOSReconReport" />

	</appSettings>
	<system.net>
		<mailSettings>
			<smtp deliveryMethod="Network" from="donotreply@corelogic.com">
				<network host="smtp.corelogic.com" defaultCredentials="true" />
			</smtp>
			<!--<smtp deliveryMethod="Network" from="donotreply@milestonetechnoconsulting.com">
        <network host="smtp.office365.com" userName="donotreply@milestonetechnoconsulting.com" password="Mstc@123" enableSsl="true" port="587" />
      </smtp>-->
		</mailSettings>
	</system.net>
	<system.serviceModel>
		<bindings>
			<basicHttpBinding>
				<binding name="TrackServiceSoapBinding" maxBufferPoolSize="2147483647" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647">
					<security mode="Transport" />
				</binding>
			</basicHttpBinding>
		</bindings>
		<client>
			<endpoint address="https://wsbeta.fedex.com:443/web-services/track" binding="basicHttpBinding" bindingConfiguration="TrackServiceSoapBinding" contract="FedExTrackShipmentService.TrackPortType" name="TrackServicePort" />
		</client>
	</system.serviceModel>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>