<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <connectionStrings>
    <!--<add name="AuthoMail" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=AuthoMail;Integrated Security=True"
      providerName="System.Data.SqlClient" />-->
    <!--<add name="AuthoMail" connectionString="Data Source=10.215.176.81;Initial Catalog=AuthoMail_UAT;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;;pooling=true;" providerName="System.Data.SqlClient" />-->
    <add name="AuthoMail" connectionString="Data Source=10.212.40.106;Initial Catalog=AuthoMail;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;;pooling=true;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="log4net.Config" value="log4net.config" />
    <add key="log4net.Config.Watch" value="True" />
    <add key="SummaryNotificationSubject" value="Summary Control Report "/>
    <add key="SummaryNotification_Email_To" value="sgolvelkar@corelogic.com"/>
    <add key="SummaryNotification_Email_Cc" value="sgolvelkar@corelogic.com"/>

    <!--FedEx Configuration-->
    <add key="FedExDeployment" value="2018-08-13"/>
    <add key="FedExAccountCode" value="CL_STAGING"/>
    <add key="FedExReportSubject" value="Daily FedEx Report"/>
    <add key="FedExReport_Email_To" value="sgolvelkar@corelogic.com"/>
    <add key="FedExReport_Email_Cc" value="sgolvelkar@corelogic.com"/>

    <!--Dallas Configuration-->
    <add key="DallasEMailTo" value="sgolvelkar@corelogic.com"/>
    <add key="DallasEMailCc" value="sgolvelkar@corelogic.com"/>
    <add key="DallasEMailSubject" value="Dallas Printing Count For "/>
    <add key="DallasEMailTemplate" value="../../EmailTemplates/DallasNotification.html"/>
    <add key="DallasNotificationTimings" value="18:00:01,19:00:01,20:00:01"/>
    <!--ESTTime Zone-->
    <add key="DallasTimeZone" value="Eastern Standard Time"/>
  </appSettings>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" from="donotreply@corelogic.com">
        <network host="smtp.corelogic.com" defaultCredentials="true" />
      </smtp>
    </mailSettings>
  </system.net>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="TrackServiceSoapBinding">
          <security mode="Transport" />
        </binding>
        <binding name="TrackServiceSoapBinding1" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="https://wsbeta.fedex.com:443/web-services/track"
        binding="basicHttpBinding" bindingConfiguration="TrackServiceSoapBinding"
        contract="TrackingShipmentService.TrackPortType" name="TrackServicePort" />
    </client>
  </system.serviceModel>
</configuration>