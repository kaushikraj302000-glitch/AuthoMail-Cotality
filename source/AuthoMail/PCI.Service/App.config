<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="dataConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Data.Configuration.DatabaseSettings, Microsoft.Practices.EnterpriseLibrary.Data, Version=6.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
  </configSections>
  <dataConfiguration defaultDatabase="PCIPnS" />
  <connectionStrings>
    <add name="PCIPnS" connectionString="Server=(localdb)\mssqllocaldb;Database=AuthoMail;Trusted_Connection=True;Connection Timeout=120;" providerName="System.Data.SqlClient" />
    <!--<add name="PCIPnS" connectionString="Data Source=10.212.40.106;Initial Catalog=AuthoMail;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;pooling=true;" providerName="System.Data.SqlClient" /> -->
    <!--<add name="PCIPnS" connectionString="Data Source=10.215.176.81;Initial Catalog=AuthoMail_UAT;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;pooling=true;" providerName="System.Data.SqlClient" />--> 
  </connectionStrings>
  <appSettings>
    <!--Values can be either 0 or 1-->
    <add key="Remove_ImmediateErrFiles" value="1"/>
    <add key="RemoveBatchFiles_PnS_SFT" value="1" />
    <add key="Remove_MRDFOUT_Of_PCI_SFT" value="1" />
    <add key="Remove_PDF_Of_PCI_SFT" value="1" />

    <add key="PCIRootFolder" value="PCIRoot" />

    <add key="PCIRootReturnPDFsZipFolder" value="PCIRoot\ReturnPDFs" />

    <!-- Values can be : ftp, sftp, unc-->
    <add key="PnS_SFT_Protocol_Value" value="unc" />
    <!-- Values can be : ftp, sftp, unc-->
    <add key="PCI_SFT_Protocol_Value" value="unc" />
    <!-- Values can be : ftp, sftp, unc-->
    <add key="CL_SFT_Protocol_Value" value="unc" />

    <!--FTP details of PnS common service SFT site. Paths should not end with '/'.-->
    <add key="PnS_SFT_HostURL" value="securefile.credco.com" />
    <add key="PnS_SFT_UserName" value="dkamdar" />
    <add key="PnS_SFT_Password" value="RXhLRzZtM0P=" />
    <add key="PnS_SFT_RootDir" value="/Unknown/PnS" />

    <!-- HostURL in case of UNC protocol will be same as root directory. -->
    <add key="PnS_SFT_HostURL" value="\\MTC-sagarg\c$\MSTC\PnS" />
    <add key="PnS_SFT_UserName" value="user" />
    <add key="PnS_SFT_Password" value="" />
    <add key="PnS_SFT_RootDir" value="\\MTC-sagarg\c$\MSTC\PnS" />
