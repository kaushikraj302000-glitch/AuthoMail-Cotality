<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="dataConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Data.Configuration.DatabaseSettings, Microsoft.Practices.EnterpriseLibrary.Data, Version=6.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
  </configSections>
  <dataConfiguration defaultDatabase="PCIPnS" />
  <connectionStrings>
    <add name="PCIPnS" connectionString="Server=(localdb)\v13.0;Database=Test;Trusted_Connection=True;Connection Timeout=120;" providerName="System.Data.SqlClient" />
    <!--<add name="PCIPnS" connectionString="Data Source=10.212.40.106;Initial Catalog=AuthoMail;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;pooling=true;" providerName="System.Data.SqlClient" /> -->
    <!--<add name="PCIPnS" connectionString="Data Source=10.215.176.81;Initial Catalog=AuthoMail_UAT;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;pooling=true;" providerName="System.Data.SqlClient" />-->
  </connectionStrings>
  <appSettings>

    <!--log4net configuration-->
    <add key="log4net.Config" value="log4net.config" />
    <add key="log4net.Config.Watch" value="True" />
    <!--Barcode Location and Size Details-->
    <!--<add key="TopMargin" value="0.125" />
    <add key="BottomMargin" value="0.125" />
    <add key="LeftMargin" value="0.125" />
    <add key="RightMargin" value="0.125" />-->

    <!--Sequence Number Spacing-->
    <add key="TopMargin" value="0.0625"/>
    <add key="BottomMargin" value="0.0625"/>
    <add key="LeftMargin" value="0.0625"/>
    <add key="RightMargin" value="0.0625"/>
    <!--Barcode Spacing-->
    <add key="BarcodeTopMargin" value="1.4"/>
    <add key="BarcodeBottomMargin" value="1.20"/>
    <add key="BarcodeLeftMargin" value="1.20"/>
    <add key="BarcodeRightMargin" value="2.35"/>

    <add key="TemplateSize" value="24" />
    <add key="ActualSizeInch" value="0.3125" />
    <add key="WhiteSpace" value="5" />   
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <system.net>
    <mailSettings>
      <!--<smtp deliveryMethod="Network" from="donotreply@corelogic.com">
        <network host="smtp.corelogic.com" defaultCredentials="true" />
      </smtp>-->
      <smtp deliveryMethod="Network"  from="donotreply@milestonetechnoconsulting.com">
        <network host="smtp.office365.com" userName="donotreply@milestonetechnoconsulting.com" password="Mstc@123" enableSsl="true" port="587" />
      </smtp>
    </mailSettings>
  </system.net>
</configuration>