	</connectionStrings>
	<appSettings>

		<!--log4net configuration-->
		<add key="log4net.Config" value="log4net.config"/>
		<add key="log4net.Config.Watch" value="True"/>
		<!--Barcode Location and Size Details-->


		<!--Sequence Number Spacing-->
		<add key="TopMargin" value="0.0625"/>
		<add key="BottomMargin" value="0.0625"/>
		<add key="LeftMargin" value="0.0625"/>
		<add key="RightMargin" value="0.0625"/>
		<!--Barcode Spacing-->
		<add key="BarcodeTopMargin" value="1.4"/>
		<add key="BarcodeBottomMargin" value="1.20"/>
		<add key="BarcodeLeftMargin" value="1.20"/>
		<add key="BarcodeRightMargin" value="2.35"/>

		<add key="TemplateSize" value="24"/>
		<add key="ActualSizeInch" value="0.3125"/>
		<add key="WhiteSpace" value="5"/>

		<add key="UnexpectedEmail_Subject" value="GCP UAT : Unexpected Error Occured in PCIJob Service"/>
		<add key="UnexpectedEmail_ToEmail" value="ramin@corelogic.com,dchattriwala@corelogic.com,brpatel@corelogic.com,geofernandez@corelogic.com,aruward@corelogic.com"/>
		<add key="UnexpectedEmail_CcEmail" value="geofernandez@corelogic.com,aruward@corelogic.com"/>



	</appSettings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
	</startup>
	<system.net>
		<mailSettings>
			<smtp deliveryMethod="Network" from="donotreply@corelogic.com">
