<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="dataConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Data.Configuration.DatabaseSettings, Microsoft.Practices.EnterpriseLibrary.Data, Version=6.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
  </configSections>
  <dataConfiguration defaultDatabase="PCIPnS" />
  <connectionStrings>
    <add name="PCIPnS" connectionString="Server=(localdb)\mssqllocaldb;Database=AuthoMail;Trusted_Connection=True;Connection Timeout=120;" providerName="System.Data.SqlClient" />
    <!--<add name="PCIPnS" connectionString="Data Source=10.212.40.106;Initial Catalog=AuthoMail;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;pooling=true;" providerName="System.Data.SqlClient" /> -->
    <!--<add name="PCIPnS" connectionString="Data Source=10.215.176.81;Initial Catalog=AuthoMail_UAT;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;pooling=true;" providerName="System.Data.SqlClient" />-->
  </connectionStrings>
  <appSettings>
    <!--Values can be either 0 or 1-->
    <add key="Remove_ImmediateErrFiles" value="1"/>

    <add key="PCIRootFolder" value="PCIRoot" />

    <add key="PCIRootReturnPDFsZipFolder" value="PCIRoot\ReturnPDFs" />

    <add key="PnS_SFTChannelCode" value="PnSService" />

    <add key="FontsDirPath" value="../../Resources" />

    <!--log4net configuration-->
    <add key="log4net.Config" value="log4net.config" />
    <add key="log4net.Config.Watch" value="True" />
    <!--Barcode Location and Size Details-->
    <!--<add key="TopMargin" value="0.125" />
    <add key="BottomMargin" value="0.125" />
    <add key="LeftMargin" value="0.125" />
    <add key="RightMargin" value="0.125" />-->

    <!--Sequence Number Spacing-->
    <add key="TopMargin" value="0.10"/>
    <add key="BottomMargin" value="1.20"/>
    <add key="LeftMargin" value="1.20"/>
    <add key="RightMargin" value="0.50"/>
    <!--Barcode Spacing-->
    <add key="BarcodeTopMargin" value="1.4"/>
    <add key="BarcodeBottomMargin" value="1.20"/>
    <add key="BarcodeLeftMargin" value="1.20"/>
    <add key="BarcodeRightMargin" value="2.35"/>

    <add key="TemplateSize" value="24" />
    <add key="ActualSizeInch" value="0.3125" />
    <add key="WhiteSpace" value="5" />
    <!--Email Notification Setup-->
    <add key="SubmitBatchEmailTemplate" value="..\..\Templates\SubmitBatch.html" />
    <add key="Email_ToPCI" value="Implementation@pcigroup.com,D.Rojas@pcigroup.com" />
    <!--CoreLogic.PrintProduction@pcigroup.com-->
    <add key="Email_CcPCI" value="sandpatel@corelogic.com,sgolvelkar@corelogic.com,avala@corelogic.com,khupatel@corelogic.com" />

    <add key="Email_ToPCI" value="vijay.mungara@milestonetechnoconsulting.com" />
    <add key="Email_CcPCI" value="sagar.g@milestonetechnoconsulting.com" />

    <add key="Email_ToCL" value="sagar.g@milestonetechnoconsulting.com" />
    <add key="Email_CcCL" value="vijay.mungara@milestonetechnoconsulting.com" />

    <add key="SuspendEmail_To" value="vmungara@corelogic.com" />
    <add key="SuspendEmail_Cc" value="sgolvelkar@corelogic.com" />
    <add key="SuspendBatchEmailTemplate" value="..\..\Templates\SuspendedBatch.html" />

    <add key="MRDFResponseLength" value="915" />

    <add key="SubmitBatchEmailSubject" value="Batch Submitted To {0} : {1} at {2} Total Files : {3} Total Page Count : {4}" />
    <add key="SuspendBatchEmailSubject" value="URGENT: Batch Suspended For Batch-ID: " />

    <add key="NoRecordsInMRDFSubject" value="INCOMPLETE RETURN MAP"/>
    <add key="PCI_Issue_Email_To" value="sgolvelkar@corelogic.com" />
    <add key="PCI_Issue_Email_Cc" value="sgolvelkar@corelogic.com" />

    <add key="NORDIS_Issue_Email_To" value="sgolvelkar@corelogic.com" />
    <add key="NORDIS_Issue_Email_Cc" value="sgolvelkar@corelogic.com" />

    <add key="UnexpectedEmail_Subject" value="Unexpected Error Occured in PnS Service" />
    <add key="UnexpectedEmail_ToEmail" value="sgolvelkar@corelogic.com" />
    <add key="UnexpectedEmail_CcEmail" value="sgolvelkar@corelogic.com" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <system.net>
    <mailSettings>
      <!--<smtp deliveryMethod="Network" from="donotreply@corelogic.com">
        <network host="smtp.corelogic.com" defaultCredentials="true" />
      </smtp>-->
      <smtp deliveryMethod="Network"  from="donotreply@milestonetechnoconsulting.com">
        <network host="smtp.office365.com" userName="donotreply@milestonetechnoconsulting.com" password="Mstc@123" enableSsl="true" port="587" />
      </smtp>
    </mailSettings>
  </system.net>
</configuration>