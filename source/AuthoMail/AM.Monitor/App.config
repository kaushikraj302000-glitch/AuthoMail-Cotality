<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
    </startup>
  <connectionStrings>
    <add name="AuthoMail" connectionString="Data Source=(LocalDb)\v11.0;Initial Catalog=AuthoMail;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.net>
    <mailSettings>
      <!--<smtp deliveryMethod="Network" from="donotreply@corelogic.com">
        <network host="smtp.corelogic.com" defaultCredentials="true" />
      </smtp>-->
      <smtp deliveryMethod="Network" from="samajsystem@gmail.com">
        <network host="smtp.gmail.com" userName="samajsystem@gmail.com" password="baby@1234" enableSsl="true" port="587" />
      </smtp>
    </mailSettings>
  </system.net>
  <appSettings>
    <add key="MonitorEmailTemplate" value="..\..\HTMLTemplates\MonitorEmailTemp.html"/>
    <add key="MonitorEmail_To" value="akshar.vala@milestonetechnoconsulting.com"/>
    <add key="MonitorEmail_Cc" value="akshar.vala@milestonetechnoconsulting.com"/>
    <add key="MonitorEmail_Subject" value="URGENT : Authomail attention required"/>
    <add key="MonitorSubmitHeading" value="submitted to PCI yet"/>
    <add key="MonitorReportbackHeading" value="ReportedBack to AuthoMail yet"/>
  </appSettings>
</configuration>