<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="log4net" type="System.Configuration.IgnoreSectionHandler" />
  </configSections>

  <log4net>
    <root>
      <level value="ALL" />
      <!--<appender-ref ref="CitiVMAgent" />-->
    </root>

    <logger name="AM.Console.PnSJob">
      <level value="DEBUG" />
      <appender-ref ref="PnSJob" />
    </logger>
    <logger name="AM.Console.CoreJob">
      <level value="DEBUG" />
      <appender-ref ref="CoreJob" />
    </logger>
    <logger name="AM.Console.DownloadJob">
      <level value="DEBUG" />
      <appender-ref ref="DownloadJob" />
    </logger>

    <!--Define some output appenders-->
    <appender name="DownloadJob" type="log4net.Appender.RollingFileAppender">
      <file value="logs\" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="yyyyMMdd\\'DownloadJob.log'" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <header value="[APP START]%newline" type="log4net.Util.PatternString" />
        <footer value="[APP END]%newline" type="log4net.Util.PatternString" />
        <conversionPattern value="%date [%thread] %-5level - %message%newline" />
      </layout>
    </appender>

    <appender name="CoreJob" type="log4net.Appender.RollingFileAppender">
      <file value="logs\" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="yyyyMMdd\\'CoreJob.log'" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <header value="[APP START]%newline" type="log4net.Util.PatternString" />
        <footer value="[APP END]%newline" type="log4net.Util.PatternString" />
        <conversionPattern value="%date [%thread] %-5level - %message%newline" />
      </layout>
    </appender>

    <appender name="PnSJob" type="log4net.Appender.RollingFileAppender">
      <file value="logs\" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="yyyyMMdd\\'PnSJob.log'" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <header value="[APP START]%newline" type="log4net.Util.PatternString" />
        <footer value="[APP END]%newline" type="log4net.Util.PatternString" />
        <conversionPattern value="%date [%thread] %-5level - %message%newline" />
      </layout>
    </appender>
  </log4net>
</configuration>