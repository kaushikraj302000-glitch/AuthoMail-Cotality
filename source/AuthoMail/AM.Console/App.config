<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="AuthoMail" connectionString="Data Source=cldev1;Initial Catalog=AuthoMail;Integrated Security=True"
      providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!--log4net configuration-->
    <add key="log4net.Config" value="log4net.config" />
    <add key="log4net.Config.Watch" value="True" />

    <add key="AuthoMailRootFolder" value="AuthoMailRoot"/>

    <add key="SchemaPath" value="D:\AuthoMailGit\Repos\source\AuthoMail\AM.Entities\Resources\MailingRequest.xsd"/>
    <add key="SchemaPathAMC" value="..\..\PackageInfoSchema.xsd"/>
    
    <add key="PnS_SFT_HostURL" value="\\MTC-sagarg\c$\MSTC\PnS" />
    <add key="PnS_SFT_UserName" value="user" />
    <add key="PnS_SFT_Password" value="" />
    <add key="PnS_SFT_RootDir" value="/PCI_Integration/PnS" />
    <add key="PnS_SFT_RootDir" value="\\MTC-sagarg\c$\MSTC\PnS" />

    <add key="Email_To" value="sgolvelkar@corelogic.com" />
    <add key="Email_Cc" value="ramin@corelogic.com" />
    
    <add key="DownloadEmailTemplate" value="..\..\HTMLTemplates\DET.html" />
    <add key="DownloadEmail_Subject" value="TEST USAA Download Summary" />
    <add key="ProcessLogEmailTemplate" value="..\..\HTMLTemplates\PLET.html" />
    <add key="ProccessEmail_Subject" value="TEST USAA Production Summary" />
    <add key="NoBatchReceivedNotification_Subject" value="No USAA batch is available" />
    <add key="PnSEmail_Subject" value="TEST USAA Status Update" />
    <add key="PCIEmail_Subject" value="USAA batch is generated for PCI on" />
    
    <add key="SendEmails" value="0" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" from="donotreply@corelogic.com">
        <network host="smtp.corelogic.com" defaultCredentials="true" />
      </smtp>
    </mailSettings>
  </system.net>
</configuration>