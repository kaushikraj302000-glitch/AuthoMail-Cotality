<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <connectionStrings>
    <add name="AuthoMail" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=AuthoMail;Integrated Security=True" providerName="System.Data.SqlClient" />
    <!--<add name="AuthoMail" connectionString="Data Source=10.212.40.106;Initial Catalog=AuthoMail;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;pooling=true;" providerName="System.Data.SqlClient" />-->
    <!--<add name="AuthoMail" connectionString="Data Source=10.215.176.81;Initial Catalog=AuthoMail_UAT;Connection Timeout=120;user id=AuthomailUser;password=Authomail@User;pooling=true;" providerName="System.Data.SqlClient" />-->
  </connectionStrings>
  <appSettings>
    <add key="log4net.Config" value="log4net.config" />
    <add key="log4net.Config.Watch" value="True" />
  </appSettings>
  <system.net>
    <mailSettings>
      <!--<smtp deliveryMethod="Network" from="donotreply@corelogic.com">
        <network host="smtp.corelogic.com" defaultCredentials="true" />
      </smtp>-->
      <smtp deliveryMethod="Network"  from="donotreply@milestonetechnoconsulting.com">
        <network host="smtp.office365.com" userName="donotreply@milestonetechnoconsulting.com" password="Mstc@123" enableSsl="true" port="587" />
      </smtp>
    </mailSettings>
  </system.net>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IUSPSIM" />
        <binding name="ShipServiceSoapBinding">
          <security mode="Transport" />
        </binding>
        <binding name="ShipServiceSoapBinding1" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost:11721/USPSIM.svc" binding="basicHttpBinding"
        bindingConfiguration="BasicHttpBinding_IUSPSIM" contract="USPSIMService.IUSPSIM"
        name="BasicHttpBinding_IUSPSIM" />
      <!--<endpoint address="http://10.212.24.84:8082/USPSLabelService/USPSIM.svc" binding="basicHttpBinding"
        bindingConfiguration="BasicHttpBinding_IUSPSIM" contract="USPSIMService.IUSPSIM"
        name="BasicHttpBinding_IUSPSIM" />-->
      <endpoint address="https://wsbeta.fedex.com:443/web-services/ship" binding="basicHttpBinding" bindingConfiguration="ShipServiceSoapBinding" contract="ShipWebServiceRef.ShipPortType" name="ShipServicePort" />
      <!--<endpoint address="https://gatewaybeta.fedex.com:443/web-services"
        binding="basicHttpBinding" bindingConfiguration="ShipServiceSoapBinding"
        contract="ShipWebServiceRef.ShipPortType" name="ShipServicePort" />-->
    </client>
  </system.serviceModel>
</configuration>